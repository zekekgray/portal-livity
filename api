/** Register a new player. data = {fullName, birthYear, category, guardianName, contactNumber, email, programId, referredBy} */
function registerPlayer(data) {
  const id = nextId_('PLR', SHEETS.PLAYERS.name);
  sheet_(SHEETS.PLAYERS.name).appendRow([
    id, data.fullName, data.birthYear, data.category, data.guardianName,
    data.contactNumber, data.email, data.programId, new Date(), 'Active', data.referredBy || ''
  ]);
  logAudit_('REGISTER_PLAYER', id + ' — ' + data.fullName, null);

  if (data.referredBy) {
    addReferral(data.referredBy, id);
  }
  return id;
}

/** Purchase a package for a player. Looks up Pricing to fill sessions/price/expiry. */
function purchasePackage(playerId, priceId) {
  const pricingRow = findRowById_(SHEETS.PRICING.name, priceId);
  if (!pricingRow) throw new Error('Unknown PriceID: ' + priceId);

  const sessions = pricingRow[4];   // Sessions
  const validityDays = pricingRow[6]; // ValidityDays
  const purchaseDate = new Date();
  const expiryDate = validityDays > 0
    ? new Date(purchaseDate.getTime() + validityDays * 24 * 60 * 60 * 1000)
    : '';

  const id = nextId_('PKG', SHEETS.PACKAGES.name);
  sheet_(SHEETS.PACKAGES.name).appendRow([
    id, playerId, priceId, purchaseDate, sessions, 0, expiryDate, 'Active'
  ]);
  logAudit_('PURCHASE_PACKAGE', id + ' for ' + playerId + ' (' + priceId + ')', null);
  return id;
}

/** Record a payment against a package. method e.g. 'Cash','GCash','Bank Transfer'. */
function recordPayment(playerId, packageId, amount, method) {
  const id = nextId_('PAY', SHEETS.PAYMENTS.name);
  sheet_(SHEETS.PAYMENTS.name).appendRow([
    id, playerId, packageId, amount, method, new Date(), 'Paid', Session.getActiveUser().getEmail()
  ]);
  logAudit_('RECORD_PAYMENT', id + ' — ' + amount + ' via ' + method, null);
  return id;
}

/**
 * Mark attendance for a player on a given schedule/date.
 * Handles walk-in surcharge logic: max 2 free walk-ins/month, 3rd+ charged 1.5x.
 * status: 'Present' | 'Absent'
 */
function markAttendance(playerId, scheduleId, dateStr, status, isWalkIn) {
  const date = dateStr ? new Date(dateStr) : new Date();
  let sessionDeducted = false;
  let surcharge = false;

  if (status === 'Present') {
    sessionDeducted = true;
    if (isWalkIn) {
      const monthCount = countWalkInsThisMonth_(playerId, date) + 1;
      surcharge = monthCount > getConfigValue_('WalkInFreePerMonth');
      const wId = nextId_('WI', SHEETS.WALKINS.name);
      sheet_(SHEETS.WALKINS.name).appendRow([wId, playerId, date, monthCount, surcharge]);
    } else {
      deductPackageSession_(playerId);
    }
  }

  const id = nextId_('ATT', SHEETS.ATTENDANCE.name);
  sheet_(SHEETS.ATTENDANCE.name).appendRow([
    id, playerId, scheduleId, date, status, sessionDeducted, !!isWalkIn
  ]);
  logAudit_('MARK_ATTENDANCE', id + ' — ' + playerId + ' (' + status + ')', null);
  return { attendanceId: id, walkInSurcharge: surcharge };
}

/** Apply the Bring-a-Friend referral discount once the referred player buys a package. */
function addReferral(referrerPlayerId, referredPlayerId) {
  const id = nextId_('REF', SHEETS.REFERRALS.name);
  const discount = getConfigValue_('ReferralDiscount');
  sheet_(SHEETS.REFERRALS.name).appendRow([
    id, referrerPlayerId, referredPlayerId, new Date(), discount, 'Pending'
  ]);
  logAudit_('ADD_REFERRAL', id + ' — ' + referrerPlayerId + ' referred ' + referredPlayerId, null);
  return id;
}
