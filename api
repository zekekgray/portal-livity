// CORE FUNCTIONS
// ============================================================

/** Register a new player. data = {fullName, birthYear, category, guardianName, contactNumber, email, programId, referredBy} */
function registerPlayer(data) {
  const id = nextId_('PLR', SHEETS.PLAYERS.name);
  sheet_(SHEETS.PLAYERS.name).appendRow([
    id, data.fullName, data.birthYear, data.category, data.guardianName,
    data.contactNumber, data.email, data.programId, new Date(), 'Active', data.referredBy || ''
  ]);
  logAudit_('REGISTER_PLAYER', id + ' — ' + data.fullName, null);

  if (data.referredBy) {
    addReferral(data.referredBy, id);
  }
  return id;
}

/** Purchase a package for a player. Looks up Pricing to fill sessions/price/expiry. */
function purchasePackage(playerId, priceId) {
  const pricingRow = findRowById_(SHEETS.PRICING.name, priceId);
  if (!pricingRow) throw new Error('Unknown PriceID: ' + priceId);

  const sessions = pricingRow[4];   // Sessions
  const validityDays = pricingRow[6]; // ValidityDays
  const purchaseDate = new Date();
  const expiryDate = validityDays > 0
    ? new Date(purchaseDate.getTime() + validityDays * 24 * 60 * 60 * 1000)
    : '';

  const id = nextId_('PKG', SHEETS.PACKAGES.name);
  sheet_(SHEETS.PACKAGES.name).appendRow([
    id, playerId, priceId, purchaseDate, sessions, 0, expiryDate, 'Active'
  ]);
  logAudit_('PURCHASE_PACKAGE', id + ' for ' + playerId + ' (' + priceId + ')', null);
  return id;
}

/** Record a payment against a package. method e.g. 'Cash','GCash','Bank Transfer'. */
function recordPayment(playerId, packageId, amount, method) {
  const id = nextId_('PAY', SHEETS.PAYMENTS.name);
  sheet_(SHEETS.PAYMENTS.name).appendRow([
    id, playerId, packageId, amount, method, new Date(), 'Paid', Session.getActiveUser().getEmail()
  ]);
  logAudit_('RECORD_PAYMENT', id + ' — ' + amount + ' via ' + method, null);
  return id;
}

/**
 * Mark attendance for a player on a given schedule/date.
 * Handles walk-in surcharge logic: max 2 free walk-ins/month, 3rd+ charged 1.5x.
 * status: 'Present' | 'Absent'
 */
function markAttendance(playerId, scheduleId, dateStr, status, isWalkIn) {
  const date = dateStr ? new Date(dateStr) : new Date();
  let sessionDeducted = false;
  let surcharge = false;

  if (status === 'Present') {
    sessionDeducted = true;
    if (isWalkIn) {
      const monthCount = countWalkInsThisMonth_(playerId, date) + 1;
      surcharge = monthCount > getConfigValue_('WalkInFreePerMonth');
      const wId = nextId_('WI', SHEETS.WALKINS.name);
      sheet_(SHEETS.WALKINS.name).appendRow([wId, playerId, date, monthCount, surcharge]);
    } else {
      deductPackageSession_(playerId);
    }
  }

  const id = nextId_('ATT', SHEETS.ATTENDANCE.name);
  sheet_(SHEETS.ATTENDANCE.name).appendRow([
    id, playerId, scheduleId, date, status, sessionDeducted, !!isWalkIn
  ]);
  logAudit_('MARK_ATTENDANCE', id + ' — ' + playerId + ' (' + status + ')', null);
  return { attendanceId: id, walkInSurcharge: surcharge };
}

/** Apply the Bring-a-Friend referral discount once the referred player buys a package. */
function addReferral(referrerPlayerId, referredPlayerId) {
  const id = nextId_('REF', SHEETS.REFERRALS.name);
  const discount = getConfigValue_('ReferralDiscount');
  sheet_(SHEETS.REFERRALS.name).appendRow([
    id, referrerPlayerId, referredPlayerId, new Date(), discount, 'Pending'
  ]);
  logAudit_('ADD_REFERRAL', id + ' — ' + referrerPlayerId + ' referred ' + referredPlayerId, null);
  return id;
}

// ============================================================
// INTERNAL LOOKUPS
// ============================================================

function findRowById_(sheetName, id) {
  const sheet = sheet_(sheetName);
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (data[i][0] === id) return data[i];
  }
  return null;
}

function getConfigValue_(key) {
  const data = sheet_(SHEETS.CONFIG.name).getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (data[i][0] === key) return data[i][1];
  }
  return null;
}

function countWalkInsThisMonth_(playerId, date) {
  const data = sheet_(SHEETS.WALKINS.name).getDataRange().getValues();
  const m = date.getMonth(), y = date.getFullYear();
  let count = 0;
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    const rowDate = new Date(row[2]);
    if (row[1] === playerId && rowDate.getMonth() === m && rowDate.getFullYear() === y) {
      count++;
    }
  }
  return count;
}

function deductPackageSession_(playerId) {
  const sheet = sheet_(SHEETS.PACKAGES.name);
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (data[i][1] === playerId && data[i][7] === 'Active' && data[i][5] < data[i][4]) {
      const newUsed = data[i][5] + 1;
      sheet.getRange(i + 1, 6).setValue(newUsed); // SessionsUsed
      if (newUsed >= data[i][4]) {
        sheet.getRange(i + 1, 8).setValue('Completed'); // Status
      }
      return true;
    }
  }
  return false; // no active package with remaining sessions found
}
// ============================================================
// WEB APP API — Enrollment endpoint for the Livity frontend
// ============================================================

const PROGRAM_PACKAGE_MAP = {
  regular: 'PRC-ACADR',
  mixedA:  'PRC-ACADMA',
  mixedB:  'PRC-ACADMB',
  mixedC:  'PRC-ACADMC'
};

function doPost(e) {
  const lock = LockService.getScriptLock();
  lock.waitLock(10000);

  try {
    const body = JSON.parse(e.postData.contents);

    if (body.action !== 'enroll') {
      return jsonResponse_({ success: false, error: 'Unknown action: ' + body.action });
    }

    return jsonResponse_(handleEnrollment_(body));

  } catch (err) {
    logAudit_('ENROLL_ERROR', String(err), null);
    return jsonResponse_({ success: false, error: 'Server error: ' + err.message });
  } finally {
    lock.releaseLock();
  }
}

function doGet(e) {
  return jsonResponse_({ status: 'ok', service: 'Livity Enrollment API' });
}

function handleEnrollment_(body) {
  const player = body.player || {};
  const guardian = body.guardian || {};
  const enrollment = body.enrollment || {};

  const missing = [];
  if (!player.firstName) missing.push('firstName');
  if (!player.lastName) missing.push('lastName');
  if (!player.gender) missing.push('gender');
  if (!guardian.guardianName) missing.push('guardianName');
  if (!guardian.whatsapp) missing.push('whatsapp');
  if (!enrollment.programId) missing.push('programId');
  if (!enrollment.consentPhoto || !enrollment.consentPrivacy) missing.push('consents');
  if (missing.length) {
    return { success: false, error: 'Missing required fields: ' + missing.join(', ') };
  }

  // Price is resolved server-side — never trust a price sent from the client.
  const priceId = resolvePriceId_(enrollment.programId, enrollment.packageKey, enrollment.category);
  let pricingRow = null;
  if (priceId) {
    pricingRow = findRowById_(SHEETS.PRICING.name, priceId);
    if (!pricingRow) {
      return { success: false, error: 'Unknown PriceID resolved: ' + priceId };
    }
  }
  // Private training has no fixed catalog price (priceId is null) — that's expected, not an error.
  if (!priceId && enrollment.programId !== 'PRG-PRIV') {
    return { success: false, error: 'Could not resolve a valid package for this program/category.' };
  }

  const playerId = registerPlayer({
    fullName: player.firstName + ' ' + player.lastName,
    birthYear: player.dob ? new Date(player.dob).getFullYear()
      : (player.age ? (new Date().getFullYear() - Number(player.age)) : ''),
    category: enrollment.category || '',
    guardianName: guardian.guardianName,
    contactNumber: guardian.whatsapp,
    email: guardian.email || '',
    programId: enrollment.programId,
    referredBy: enrollment.referredBy || ''
  });

  let packageId = null;
  let membershipPackageId = null;
  let totalPrice = 0;

  if (pricingRow) {
    packageId = purchasePackage(playerId, priceId);
    totalPrice = Number(pricingRow[5]);
  }

  // Membership fee — ONLY for Academy, added automatically, never for other programs.
  if (enrollment.programId === 'PRG-ACAD') {
    membershipPackageId = purchasePackage(playerId, 'PRC-MEMB');
    totalPrice += 4000;
  }

  const paymentId = recordPayment(playerId, packageId || 'PENDING', totalPrice, enrollment.paymentMethod || 'Unspecified');

  logAudit_('WEB_ENROLLMENT', playerId + ' via web form — ' + (priceId || 'no-fixed-price'), null);

  return {
    success: true,
    enrollmentId: playerId,
    packageId: packageId,
    paymentId: paymentId,
    amountDue: totalPrice
  };
}

function resolvePriceId_(programId, packageKey, category) {
  if (programId === 'PRG-ACAD') return PROGRAM_PACKAGE_MAP[packageKey] || null;
  if (programId === 'PRG-ADV')  return 'PRC-ADV';
  if (programId === 'PRG-REG') {
    const map = { 'U5-U7': 'PRC-U57', 'U9-U13': 'PRC-U913', 'U15+': 'PRC-U15' };
    return map[category] || null;
  }
  return null; // PRG-PRIV — rate confirmed by coach, not in the price catalog
}

function jsonResponse_(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}
