<!-- === START: ADMIN CONSOLE — SCRIPTS === -->
<script>
(function () {
  var S = { tab: 'dash', rvOpen: {}, excType: 'ALL', excQ: '', wkStatus: 'Open', payStatus: 'Submitted', payQ: '', ledQ: '', ledType: '', plQ: '', plStatus: '', thread: '', audQ: '', audAct: '', audHide: '1', ntfAud: '', ntfSt: '', ntfQ: '', enrSt: 'Open', enrQ: '', refSt: 'Open', refQ: '', rptP: 'today' };
  var TABS = [['dash', 'Dashboard'], ['pay', 'Payments'], ['exc', 'Exceptions'], ['wk', 'Walk-ins'], ['rv', 'Sessions'], ['led', 'Ledger'], ['pl', 'Players'], ['msg', 'Messages'], ['sch', 'Schedule'], ['enr', 'Enrollments'], ['ref', 'Referrals'], ['rpt', 'Reports'], ['aud', 'Audit'], ['ntf', 'Notifications'], ['sys', 'Health'], ['cfg', 'Config']];
  var STATUSES = ['Submitted', 'Pending', 'Overdue', 'Partial', 'Rejected', 'Paid', 'Reversed', 'All'];
  var LTYPES = ['CHARGE', 'SUBMITTED', 'PAYMENT_VERIFIED', 'REJECTED', 'REVERSAL', 'PENALTY', 'WAIVER', 'ADJUSTMENT', 'REFUND_REQUESTED', 'REFUND_COMPLETED', 'DUE_DATE_CHANGED'];
  var UNPAID = ['Pending', 'Overdue', 'Partial', 'Rejected', 'Submitted'];
  var items = [], sched = [], view = document.getElementById('view');

  function $(s, el) { return (el || document).querySelector(s); }
  function esc(v) { return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); }
  function money(n) { return '₱' + (Number(n) || 0).toLocaleString('en-PH'); }
  function rid() { return 'CN' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6); }
  function pill(s) { return '<span class="pill st-' + esc(s) + '">' + esc(s || 'Normal') + '</span>'; }
  function toast(m, bad) { var t = $('#toast'); t.textContent = m; t.className = 'on' + (bad ? ' bad' : ''); clearTimeout(toast.h); toast.h = setTimeout(function () { t.className = ''; }, 3200); }

  function api(op, p) {
    return new Promise(function (res, rej) {
      google.script.run.withSuccessHandler(res).withFailureHandler(function (e) {
        rej(new Error(String((e && e.message) || e).replace(/^Error:\s*/, '')));
      }).consoleCall(op, p || {});
    });
  }

  /* ---------- modal helpers ---------- */
  function closeModal() { $('#modal').innerHTML = ''; }
  function openModal(title, html, btns, wide) {
    var m = $('#modal');
    m.innerHTML = '<div class="mask"><div class="dlg' + (wide ? ' wide' : '') + '"><h3>' + esc(title) + '</h3><div class="body">' + html + '</div><div class="foot"></div></div></div>';
    var foot = $('.foot', m);
    btns.forEach(function (b) {
      var el = document.createElement('button'); el.className = 'btn ' + (b.cls || ''); el.textContent = b.label; foot.appendChild(el);
      el.onclick = function () {
        if (!b.fn || b.plain) { closeModal(); if (b.fn) b.fn(); return; }
        var all = foot.querySelectorAll('button'); all.forEach(function (x) { x.disabled = true; });
        Promise.resolve().then(b.fn).then(function (r) {
          closeModal(); if (r && r.msg) toast(r.msg); if (!r || !r.noReload) load();
        }).catch(function (e) { all.forEach(function (x) { x.disabled = false; }); toast(e.message, 1); });
      };
    });
    var f = m.querySelector('input,textarea,select'); if (f) f.focus();
  }
  function confirmBox(msg) {
    return new Promise(function (res) {
      openModal('Please confirm', '<p class="note">' + esc(msg).replace(/\n/g, '<br>') + '</p>',
        [{ label: 'Cancel', plain: 1, fn: function () { res(false); } }, { label: 'Proceed', cls: 'dng', plain: 1, fn: function () { res(true); } }]);
    });
  }
  function ask(title, fields, okLabel, onOk, note, danger) {
    var h = (note ? '<p class="note">' + esc(note) + '</p>' : '') + fields.map(function (f) {
      var id = 'f_' + f.k, v = f.value == null ? '' : f.value, inp;
      if (f.type === 'textarea') inp = '<textarea id="' + id + '" rows="3">' + esc(v) + '</textarea>';
      else if (f.type === 'select') inp = '<select id="' + id + '">' + f.options.map(function (o) { return '<option value="' + esc(o[0]) + '"' + (String(o[0]) === String(v) ? ' selected' : '') + '>' + esc(o[1]) + '</option>'; }).join('') + '</select>';
      else if (f.type === 'checkbox') inp = '<input type="checkbox" id="' + id + '"' + (v ? ' checked' : '') + '>';
      else inp = '<input id="' + id + '" type="' + (f.type || 'text') + '" value="' + esc(v) + '"' + (f.ph ? ' placeholder="' + esc(f.ph) + '"' : '') + '>';
      return '<label class="fld' + (f.type === 'checkbox' ? ' ck' : '') + '"><span>' + esc(f.label) + '</span>' + inp + '</label>';
    }).join('');
    openModal(title, h, [{ label: 'Cancel' }, { label: okLabel, cls: danger ? 'dng' : 'pri', fn: function () {
      var v = {}; fields.forEach(function (f) { var el = $('#f_' + f.k); v[f.k] = f.type === 'checkbox' ? (el.checked ? '1' : '') : el.value; });
      return onOk(v);
    } }]);
  }

  /* ---------- navigation ---------- */
  function nav() { $('#tabs').innerHTML = TABS.map(function (t) { return '<button class="tab' + (S.tab === t[0] ? ' on' : '') + '" data-tab="' + t[0] + '">' + t[1] + '</button>'; }).join(''); }
  function go(tab) { S.tab = tab; nav(); load(); }
  function load() {
    view.innerHTML = '<div class="empty">Loading…</div>';
    ({ dash: vDash, pay: vPay, exc: vExc, wk: vWk, rv: vRv, led: vLed, pl: vPl, msg: vMsg, sch: vSch, aud: vAud, enr: vEnr, ref: vRef, rpt: vRpt, ntf: vNtf, sys: vSys, cfg: vCfg })[S.tab]().catch(function (e) { view.innerHTML = '<div class="empty err">' + esc(e.message) + '</div>'; });
  }
  function search(id, key, ph) { return '<input class="srch" id="' + id + '" data-s="' + key + '" placeholder="' + esc(ph) + '" value="' + esc(S[key]) + '">'; }

  /* ---------- DASHBOARD ---------- */
  function vDash() {
    return api('dash').then(function (d) {
      var c = d.counts, T = [
        ['Awaiting verification', c.Submitted || 0, 'pay', 'st="Submitted"'], ['Overdue', c.Overdue || 0, 'pay', 'st="Overdue"'],
        ['Partial', c.Partial || 0, 'pay', 'st="Partial"'], ['Pending', c.Pending || 0, 'pay', 'st="Pending"'], ['Rejected', c.Rejected || 0, 'pay', 'st="Rejected"'],
        ['Outstanding balance', money(d.outstanding), 'pay', 'st="All"'], ['Refunds pending', money(d.refundsPending), 'led', 'lt="REFUND_REQUESTED"'],
        ['Attendance exceptions', d.exceptions, 'exc', ''], ['Sessions without coach', d.uncoached, 'rv', ''], ['Walk-ins to review', d.walkins, 'wk', ''],
        ['Enrollments to review', d.enrOpen, 'enr', ''], ['Referrals open', d.refOpen, 'ref', ''],
        ['Unread messages', d.unread, 'msg', ''], ['Slots cancelled / moved', d.slotsChanged, 'sch', ''], ['Active players', d.activePlayers, 'pl', '']
      ];
      view.innerHTML = '<div class="tiles">' + T.map(function (t) {
        return '<button class="tile" data-go="' + t[2] + '" data-' + t[3] + '><small>' + t[0] + '</small><b>' + t[1] + '</b></button>';
      }).join('') + '</div>';
    });
  }

  /* ---------- PAYMENTS ---------- */
  function vPay() {
    return api('payQueue', { status: S.payStatus, q: S.payQ }).then(function (d) {
      items = d.items;
      var chips = STATUSES.map(function (s) {
        var n = s === 'All' ? d.total : (d.counts[s] || 0);
        return '<button class="chip' + (S.payStatus === s ? ' on' : '') + '" data-chip="' + s + '">' + s + ' <i>' + n + '</i></button>';
      }).join('');
      view.innerHTML = '<div class="bar"><div class="chips">' + chips + '</div>' + search('q', 'payQ', 'Search ID, player, guardian, ref…') + '</div>' +
        (items.length ? items.map(payCard).join('') : '<div class="empty">Nothing here.</div>');
    });
  }
  function payCard(it) {
    var fl = (it.flags && it.flags !== 'OK') ? it.flags.split(',').map(function (f) { return '<span class="flag">' + esc(f) + '</span>'; }).join(' ') : '';
    var un = UNPAID.indexOf(it.status) > -1, b = [];
    if (un) b.push(['verify', 'Verify', 'pri']);
    if (it.status === 'Submitted' || it.status === 'Partial') b.push(['reject', 'Reject', '']);
    if (un) b.push(['adjust', 'Waive / Adjust', ''], ['due', 'Due date', '']);
    if (it.status === 'Paid' || it.status === 'Partial') b.push(['reverse', 'Reverse', 'dng']);
    if (['Paid', 'Partial', 'Reversed'].indexOf(it.status) > -1) b.push(['rfreq', 'Refund request', ''], ['rfdone', 'Refund complete' + (it.refundPending ? ' (' + money(it.refundPending) + ')' : ''), '']);
    b.push(['ledger', 'Ledger', '']);
    return '<div class="card"><div class="r1"><b>' + esc(it.paymentId) + '</b>' + pill(it.status) + fl + '</div>' +
      '<div style="margin-top:4px"><b>' + esc(it.player) + '</b> <span class="meta">· ' + esc(it.playerId) + ' · ' + esc(it.guardian) + ' · ' + esc(it.contact) + '</span></div>' +
      '<div class="nums"><div>Base<b>' + money(it.base) + '</b></div><div>Penalty<b>' + money(it.penalty) + '</b></div><div>Adjust<b>' + money(it.adjustments) + '</b></div>' +
      '<div>Total<b>' + money(it.total) + '</b></div><div>Verified<b>' + money(it.verified) + '</b></div><div>Remaining<b>' + money(it.remaining) + '</b></div>' +
      (it.sent ? '<div>Guardian sent<b>' + money(it.sent) + '</b></div>' : '') + (it.refunded ? '<div>Refunded<b>' + money(it.refunded) + '</b></div>' : '') + '</div>' +
      '<div class="meta">' + esc(it.method) + (it.reference ? ' · Ref ' + esc(it.reference) : '') + (it.submittedAt ? ' · Sent ' + esc(it.submittedAt) : '') + ' · Due ' + esc(it.dueAt) +
      (it.proofUrl ? ' · <a href="' + esc(it.proofUrl) + '" target="_blank">View proof</a>' : '') + (it.note ? ' · Note: ' + esc(it.note) : '') + '</div>' +
      '<div class="acts">' + b.map(function (x) { return '<button class="btn ' + x[2] + '" data-act="' + x[0] + '" data-id="' + esc(it.paymentId) + '">' + x[1] + '</button>'; }).join('') + '</div></div>';
  }
  function payDo(it, op, extra, okMsg) {
    var body = Object.assign({ op: op, paymentId: it.paymentId, stamp: it.stamp, requestId: rid() }, extra);
    return api('payAction', body).catch(function (e) {
      if (/^(DUPLICATE|OVERPAID):/.test(e.message)) {
        return confirmBox(e.message + '\n\nProceed anyway?').then(function (yes) {
          if (!yes) throw new Error('Cancelled');
          body.force = '1'; return api('payAction', body);
        });
      }
      throw e;
    }).then(function (r) { return { msg: it.paymentId + ' → ' + (okMsg || r.state || 'done') + (r.duplicate ? ' (already applied)' : '') }; });
  }
  function payAct(act, it) {
    if (!it) return;
    var id = it.paymentId;
    if (act === 'ledger') { S.ledQ = id; S.ledType = ''; return go('led'); }
    if (act === 'verify') return ask('Verify ' + id, [{ k: 'amount', label: 'Amount received now (₱)', type: 'number', value: (it.status === 'Submitted' && it.sent > 0) ? it.sent : it.remaining }], 'Verify',
      function (v) { return payDo(it, 'verify', { amount: v.amount }); }, 'Total ' + money(it.total) + ' · verified ' + money(it.verified) + ' · remaining ' + money(it.remaining) + (it.sent ? ' · guardian sent ' + money(it.sent) : ''));
    if (act === 'reject') return ask('Reject ' + id, [{ k: 'reason', label: 'Reason (shown to the guardian)', type: 'textarea' }], 'Reject', function (v) { return payDo(it, 'reject', { reason: v.reason }); }, 'The guardian can resubmit.', true);
    if (act === 'reverse') return ask('Reverse ' + id, [{ k: 'reason', label: 'Reason', type: 'textarea' }], 'Reverse', function (v) { return payDo(it, 'reverse', { reason: v.reason }); }, 'Packages are reversed. Sessions already used are NOT restored.', true);
    if (act === 'adjust') return ask('Waive / Adjust ' + id, [
      { k: 'op', label: 'Type', type: 'select', options: [['waive', 'Waive penalty (positive amount)'], ['adjust', 'Adjust total (e.g. -500 or 200)']], value: it.penalty > 0 ? 'waive' : 'adjust' },
      { k: 'amount', label: 'Amount (₱)', type: 'number' }, { k: 'reason', label: 'Reason (min 5 chars)', type: 'textarea' },
      { k: 'approvedBy', label: 'Approved by (email; required above the limit, must differ from you)' }], 'Apply',
      function (v) { return payDo(it, v.op, { amount: v.amount, reason: v.reason, approvedBy: v.approvedBy }, 'balance updated'); }, 'Current penalty ' + money(it.penalty) + ' · remaining ' + money(it.remaining));
    if (act === 'due') return ask('Change due date · ' + id, [{ k: 'dueAt', label: 'New due date/time', type: 'datetime-local', value: it.dueAtInput }], 'Save', function (v) { return payDo(it, 'dueDate', { dueAt: v.dueAt }, 'due date updated'); });
    if (act === 'rfreq') return ask('Request refund · ' + id, [{ k: 'amount', label: 'Amount (₱)', type: 'number' }, { k: 'reason', label: 'Reason (min 5 chars)', type: 'textarea' }], 'Request',
      function (v) { return payDo(it, 'refundRequest', { amount: v.amount, reason: v.reason }, 'refund requested'); }, 'A different admin must complete it.');
    if (act === 'rfdone') return ask('Complete refund · ' + id, [{ k: 'amount', label: 'Amount (blank = full pending)', type: 'number' }, { k: 'reason', label: 'Transfer reference / note (min 5 chars)' }], 'Complete',
      function (v) { return payDo(it, 'refundComplete', { amount: v.amount, reason: v.reason }, 'refund completed'); }, 'Pending refund ' + money(it.refundPending));
  }

  /* === START: ADMIN CONSOLE — PHASE 1 VIEWS (exceptions, walk-ins, package corrections) === */
  var excItems = [], wkItems = [], curPl = { pid: '', pkgs: [] };
  var EXC_T = [['ALL', 'All'], ['NO_DEDUCT', 'No deduction'], ['UNMARKED', 'Unmarked'], ['ABSENT', 'Absent (14d)']];
  var EXC_L = { NO_DEDUCT: 'Checked in, session not deducted', UNMARKED: 'Registered, never marked', ABSENT: 'Marked absent' };

  function vExc() {
    return api('excQueue', { type: S.excType, q: S.excQ }).then(function (d) {
      excItems = d.items;
      var chips = EXC_T.map(function (t) {
        var n = t[0] === 'ALL' ? d.total : (d.counts[t[0]] || 0);
        return '<button class="chip' + (S.excType === t[0] ? ' on' : '') + '" data-ec="' + t[0] + '">' + t[1] + ' <i>' + n + '</i></button>';
      }).join('');
      view.innerHTML = '<div class="bar"><div class="chips">' + chips + '</div>' + search('eq', 'excQ', 'Search player, ID, program…') + '</div>' +
        (excItems.length ? excItems.map(excCard).join('') : '<div class="empty">No exceptions.</div>');
    });
  }
  function excCard(it) {
    var b = [];
    if (it.type === 'NO_DEDUCT') b.push(['deduct', 'Deduct session now', 'pri'], ['waive', 'Waive deduction', '']);
    if (it.type === 'UNMARKED') b.push(['present', 'Mark Present', 'pri'], ['late', 'Mark Late', ''], ['absent', 'Mark Absent', ''], ['excuse', 'Excuse', ''], ['excuseAll', 'Excuse whole session', '']);
    if (it.type === 'ABSENT') b.push(['present', 'Correct to Present', 'pri'], ['late', 'Correct to Late', ''], ['excuse', 'Excuse', '']);
    return '<div class="card"><div class="r1"><b>' + esc(it.player) + '</b>' + pill(it.status) + '<span class="flag">' + esc(EXC_L[it.type]) + '</span>' +
      (it.type === 'NO_DEDUCT' && it.payPending ? '<span class="flag">payment pending</span>' : '') + '</div>' +
      '<div class="meta">' + esc(it.playerId) + ' · ' + esc(it.program) + ' · ' + esc(it.date) + ' ' + esc(it.time) + (it.venue ? ' · ' + esc(it.venue) : '') + (it.checkIn ? ' · In ' + esc(it.checkIn) : '') + '</div>' +
      '<div class="acts">' + b.map(function (x) { return '<button class="btn ' + x[2] + '" data-exc="' + x[0] + '" data-id="' + esc(it.attendanceId) + '">' + x[1] + '</button>'; }).join('') + '</div></div>';
  }
  function excAct(op, it) {
    if (!it) return;
    var needs = { waive: 1, excuse: 1, excuseAll: 1, present: it.type === 'ABSENT', late: it.type === 'ABSENT' };
    var notes = {
      deduct: 'Deducts 1 session from the matching package now. Fails if the player has no active package for this program (check payment status first).',
      waive: 'Marks this check-in as no deduction needed. It leaves the queue.',
      present: 'Sets Present and deducts 1 session if a matching package is active. Guardian is not notified.',
      late: 'Sets Late and deducts 1 session if a matching package is active. Guardian is not notified.',
      absent: 'Sets Absent and notifies the guardian, same as the automatic sweep.',
      excuse: 'Excused: no deduction and no absence notice.',
      excuseAll: 'Excuses every Unmarked player of ' + it.program + ' on ' + it.date + ' (e.g. session cancelled).'
    };
    var titles = { deduct: 'Deduct session', waive: 'Waive deduction', present: 'Mark Present', late: 'Mark Late', absent: 'Mark Absent', excuse: 'Excuse', excuseAll: 'Excuse whole session' };
    ask(titles[op] + ' · ' + it.player, [{ k: 'reason', label: needs[op] ? 'Reason (min 5 chars)' : 'Note (optional)', type: 'textarea' }], titles[op], function (v) {
      var body = op === 'excuseAll'
        ? { op: 'excuseSession', scheduleId: it.scheduleId, date: it.date, reason: v.reason }
        : { op: op, attendanceId: it.attendanceId, stamp: it.stamp, reason: v.reason };
      return api('excAction', body).then(function (r) { return { msg: it.player + ' → ' + r.msg }; });
    }, notes[op]);
  }

  function vWk() {
    return api('walkins', { status: S.wkStatus }).then(function (d) {
      wkItems = d.items;
      var chips = [['Open', d.counts.Open], ['Resolved', d.counts.Resolved], ['All', d.counts.Open + d.counts.Resolved]].map(function (c) {
        return '<button class="chip' + (S.wkStatus === c[0] ? ' on' : '') + '" data-wc="' + c[0] + '">' + c[0] + ' <i>' + c[1] + '</i></button>';
      }).join('');
      view.innerHTML = '<div class="bar"><div class="chips">' + chips + '</div></div>' + (wkItems.length ? wkItems.map(wkCard).join('') : '<div class="empty">No walk-ins here.</div>');
    });
  }
  function wkCard(it) {
    var open = !it.resolution;
    return '<div class="card"><div class="r1"><b>' + esc(it.player) + '</b>' + pill(open ? 'Open' : it.resolution) + (it.surcharge ? '<span class="flag">surcharge applies</span>' : '') + '</div>' +
      '<div class="meta">' + esc(it.playerId) + ' · ' + esc(it.category) + ' · ' + esc(it.program) + ' · ' + esc(it.date) + ' ' + esc(it.time) + ' · walk-in #' + it.monthCount + ' this month' +
      (it.paymentId ? ' · ' + esc(it.paymentId) : '') + (it.resolvedBy ? ' · by ' + esc(it.resolvedBy) : '') + '</div>' +
      (open ? '<div class="acts"><button class="btn pri" data-wk="charge" data-id="' + esc(it.walkInId) + '">Charge ' + (it.suggested ? money(it.suggested) : '…') + '</button>' +
        '<button class="btn" data-wk="deduct" data-id="' + esc(it.walkInId) + '">Use package session</button>' +
        '<button class="btn" data-wk="waive" data-id="' + esc(it.walkInId) + '">Waive</button></div>' : '') + '</div>';
  }
  function wkAct(op, it) {
    if (!it) return;
    var done = function (r) { return { msg: it.player + ' → ' + r.msg }; };
    if (op === 'charge') return ask('Charge walk-in · ' + it.player, [{ k: 'amount', label: 'Amount (₱)', type: 'number', value: it.suggested || '' }], 'Create payment',
      function (v) { return api('walkinAction', { op: 'charge', walkInId: it.walkInId, amount: v.amount }).then(done); },
      'Creates a Pending payment (method Walk-in). The guardian gets payment instructions and it follows the normal Verify flow in Payments.');
    if (op === 'deduct') return ask('Use package session · ' + it.player, [], 'Deduct',
      function () { return api('walkinAction', { op: 'deduct', walkInId: it.walkInId }).then(done); }, 'Deducts 1 session from an active package for this program. Fails if there is none.');
    if (op === 'waive') return ask('Waive walk-in · ' + it.player, [{ k: 'reason', label: 'Reason (min 5 chars)', type: 'textarea' }], 'Waive',
      function (v) { return api('walkinAction', { op: 'waive', walkInId: it.walkInId, reason: v.reason }).then(done); }, 'No charge and no deduction. Logged in AuditLog.');
  }

  function pkgEdit(id) {
    var k = curPl.pkgs.filter(function (x) { return x.packageId === id; })[0]; if (!k) return;
    var pid = curPl.pid, stamp = [k.status, k.total, k.used, k.expiry].join('|');
    var so = (['Active', 'Completed'].indexOf(k.status) < 0 ? [[k.status, k.status + ' (current)']] : []).concat([['Active', 'Active'], ['Completed', 'Completed']]);
    ask('Adjust package · ' + k.packageId, [
      { k: 'used', label: 'Sessions used (now ' + k.used + ' of ' + k.total + ')', type: 'number', value: k.used },
      { k: 'grant', label: 'Grant extra sessions (adds to total)', type: 'number', ph: '0' },
      { k: 'expiry', label: 'Expiry date (blank = not started)', type: 'date', value: k.expiry },
      { k: 'status', label: 'Status', type: 'select', options: so, value: k.status },
      { k: 'reason', label: 'Reason (min 5 chars)', type: 'textarea' }], 'Save',
      function (v) {
        return api('pkgAdjust', Object.assign({ packageId: id, stamp: stamp }, v)).then(function (r) {
          setTimeout(function () { plOpen(pid); }, 60);
          return { msg: id + ' → ' + r.used + '/' + r.total + ' · ' + r.state, noReload: 1 };
        });
      }, 'To restore sessions, lower "Sessions used". Status follows the counts unless you set it. Every change is logged with your reason.');
  }
  /* === START: ADMIN CONSOLE — PHASE 2 VIEWS (sessions, RSVP, coaches) === */
  var rvItems = [], rvCoaches = [];

  function rvLabel(key) {
    var s = rvItems.filter(function (x) { return x.key === key; })[0];
    return s ? s.program + ' · ' + s.day.slice(0, 3) + ' ' + s.date + ' ' + s.start : key;
  }
  function vRv() {
    return api('rvBoard').then(function (d) {
      rvItems = d.items; rvCoaches = d.coaches || [];
      view.innerHTML = '<div class="bar"><b>Next 7 days (RSVP programs)</b><span class="meta">Guardian reservations: ' + (d.enabled ? 'open' : '<b>CLOSED</b> (Config → RsvpEnabled)') + '</span><span style="flex:1"></span>' +
        '<button class="btn pri" id="autoas">Auto-assign coaches</button></div>' +
        (rvItems.length ? rvItems.map(rvCard).join('') : '<div class="empty">No upcoming RSVP sessions.</div>');
    });
  }
  function rvCard(s, i) {
    var col = function (title, arr, btns) {
      return '<div><b>' + title + ' (' + arr.length + ')</b>' + (arr.map(function (x) {
        return '<div class="rvp"><span>' + esc(x.name) + (x.source && x.source !== 'app' ? ' <small class="meta">' + esc(x.source) + '</small>' : '') + '</span><span>' +
          btns.map(function (b) { return '<button class="btn" data-rv="' + b[0] + '" data-i="' + i + '" data-p="' + esc(x.playerId) + '">' + b[1] + '</button>'; }).join(' ') + '</span></div>';
