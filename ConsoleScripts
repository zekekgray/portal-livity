      var h = '<p class="note">Every change is logged in Audit with your reason. Secret values are never logged or shown. Penalty rules also apply to payments that are already unpaid.</p>';
      groups.forEach(function (g) {
        h += '<div class="csec">' + esc(g) + '</div><div class="card">' + by[g].map(function (c) {
          var val = c.secret ? (c.weak ? badge('bad', 'Default key') : (c.set ? badge('ok', 'Set') : badge('warn', 'Not set')))
            : (c.set ? '<span style="font-weight:700">' + esc(c.value) + '</span>' : '<span class="meta">not set' + (c.def ? ' · default ' + esc(c.def) : '') + '</span>');
          return '<div class="krow"><div><b>' + esc(c.l) + '</b><span class="meta">' + esc(c.k) + (c.h ? ' · ' + esc(c.h) : '') + '</span></div>' +
            '<div style="display:flex;gap:10px;align-items:center">' + val + '<button class="btn" data-cfg="' + esc(c.k) + '">Edit</button></div></div>';
        }).join('') + '</div>';
      });
      h += '<div class="csec">Other keys (read-only, edit in the Sheet)</div><table><tr><th>Key</th><th>Value</th></tr>' +
        (d.other.length ? d.other.map(function (o) { return '<tr><td>' + esc(o.k) + '</td><td class="wrap">' + esc(o.value) + '</td></tr>'; }).join('') : '<tr><td colspan="2" class="empty">None.</td></tr>') + '</table>';
      view.innerHTML = h;
    });
  }
  function cfgEdit(k) {
    var c = cfgItems.filter(function (x) { return x.k === k; })[0];
    if (!c) return;
    var f;
    if (c.t === 'bool') f = { k: 'value', label: c.l, type: 'select', options: [['true', 'true'], ['false', 'false']], value: c.set ? String(c.value).toLowerCase() : (c.def || 'false') };
    else f = { k: 'value', label: c.l + (c.secret ? ' (new value)' : ''), type: c.secret ? 'password' : ((c.t === 'int' || c.t === 'num') ? 'number' : 'text'), value: c.secret ? '' : (c.value || c.def || ''), ph: c.secret ? 'Min. 6 characters' : '' };
    ask('Edit · ' + c.k, [f, { k: 'reason', label: 'Reason (min 5 chars)', type: 'textarea' }], 'Save', function (v) {
      return api('cfgSet', { key: c.k, value: v.value, reason: v.reason, stamp: c.stamp }).then(function (r) { return { msg: r.msg }; });
    }, c.h || ('Current: ' + (c.set ? c.value : 'not set')), !!c.secret);
  }
  /* === END: ADMIN CONSOLE — PHASE 3 VIEWS === */

    /* === START: ADMIN CONSOLE — PHASE 4 VIEWS (enrollment review, referrals) === */
  var enrItems = [], refItems = [];
  var REV_L = { New: 'New', NeedsCorrection: 'Needs correction', Approved: 'Approved', Declined: 'Declined' };

  /* ---------- ENROLLMENTS ---------- */
  function vEnr() {
    return api('enrQueue', { status: S.enrSt, q: S.enrQ }).then(function (d) {
      enrItems = d.items;
      var c = d.counts;
      var st = selHtml('enrSt', 200, [['Open', 'Open · ' + c.Open], ['Approved', 'Approved · ' + c.Approved], ['Declined', 'Declined · ' + c.Declined], ['All', 'All · ' + c.All]]);
      view.innerHTML = '<div class="bar">' + search('enq', 'enrQ', 'Search name, ID, guardian, phone, email…') + st + '</div>' +
        '<p class="note">Review does not block activation. Training starts when the payment is verified. Declining makes the player Inactive but does not cancel their payment. Handle that in Payments.</p>' +
        (enrItems.length ? enrItems.map(enrCard).join('') : '<div class="empty">Nothing here.</div>');
    });
  }
  function enrCard(it) {
    var b = [];
    if (it.review === 'New' || it.review === 'NeedsCorrection') b.push(['approve', 'Approve', 'pri'], ['correct', 'Needs correction', ''], ['decline', 'Decline', 'dng']);
    if (it.review === 'Declined') b.push(['reopen', 'Reopen', '']);
    var fl = it.dupes.map(function (x) { return '<span class="flag">⚠ ' + esc(x) + '</span>'; }).join(' ') + (it.email ? '' : ' <span class="flag">no guardian email</span>');
    return '<div class="card"><div class="r1"><b>' + esc(it.name) + '</b><span class="pill st-' + esc(it.review || 'Legacy') + '">' + esc(REV_L[it.review] || 'Legacy') + '</span>' +
      (it.status !== 'Active' ? pill(it.status) : '') + fl + '</div>' +
      '<div class="meta">' + esc(it.playerId) + ' · ' + esc(it.category || '—') + (it.birthYear ? ' · born ' + esc(it.birthYear) : '') + ' · ' + esc(it.program) + ' · enrolled ' + esc(it.enrolled) + '</div>' +
      '<div class="meta">Guardian: ' + esc(it.guardian) + ' · ' + esc(it.contact) + (it.email ? ' · ' + esc(it.email) : '') + (it.referredBy ? ' · referred by ' + esc(it.referredBy) : '') + '</div>' +
      '<div class="meta">Payments: ' + (it.payments.length ? esc(it.payments.join('  |  ')) : 'none yet') + '</div>' +
      (it.note ? '<div class="meta">Note: ' + esc(it.note) + (it.by ? ' · ' + esc(it.by) + ' ' + esc(it.at) : '') + '</div>' : '') +
      '<div class="acts">' + b.map(function (x) { return '<button class="btn ' + x[2] + '" data-enr="' + x[0] + '" data-id="' + esc(it.playerId) + '">' + x[1] + '</button>'; }).join('') + '</div></div>';
  }
  function enrAct(op, it) {
    if (!it) return;
    var needs = op !== 'approve';
    var N = {
      approve: 'Marks the data as checked and notifies the guardian.',
      correct: 'The guardian is notified with your message. Payment and activation are not affected.',
      decline: 'Player becomes Inactive (cannot be found, scanned or RSVP). The guardian is notified. Any pending payment must be handled in Payments.',
      reopen: 'Player becomes Active again and returns to the New queue.'
    };
    var T = { approve: 'Approve', correct: 'Needs correction', decline: 'Decline', reopen: 'Reopen' };
    ask(T[op] + ' · ' + it.name, needs ? [{ k: 'reason', label: op === 'correct' ? 'What needs correcting (sent to the guardian)' : 'Reason (min 5 chars)', type: 'textarea' }] : [],
      T[op], function (v) {
        return api('enrAction', { op: op, playerId: it.playerId, stamp: it.stamp, reason: v.reason || '' }).then(function (r) { return { msg: r.msg }; });
      }, N[op], op === 'decline');
  }

  /* ---------- REFERRALS ---------- */
  function vRef() {
    return api('refQueue', { status: S.refSt, q: S.refQ }).then(function (d) {
      refItems = d.items;
      var c = d.counts;
      var st = selHtml('refSt', 200, [['Open', 'Open · ' + c.Open], ['Applied', 'Applied · ' + c.Applied], ['Rejected', 'Rejected · ' + c.Rejected], ['All', 'All · ' + c.All]]);
      view.innerHTML = '<div class="bar">' + search('rfq', 'refQ', 'Search referral, player, ID…') + st + '<button class="btn pri" id="refadd">Add referral</button></div>' +
        '<p class="note">Flow: Pending → Approved (referred player paid a package) → Applied (discount goes on the referrer\'s next unpaid package payment, ledgered). Sibling and loyalty discounts are not automated. Use Waive / Adjust in Payments.</p>' +
        (refItems.length ? refItems.map(refCard).join('') : '<div class="empty">Nothing here.</div>');
    });
  }
  function refCard(it) {
    var b = [];
    if (it.status === 'Pending') b.push(['approve', 'Approve', 'pri'], ['reject', 'Reject', 'dng']);
    if (it.status === 'Approved') b.push(['apply', 'Apply discount', 'pri'], ['reject', 'Reject', 'dng']);
    var fl = it.flags.map(function (x) { return '<span class="flag">⚠ ' + esc(x) + '</span>'; }).join(' ');
    return '<div class="card"><div class="r1"><b>' + esc(it.referralId) + '</b>' + pill(it.status) +
      (it.status === 'Pending' ? '<span class="flag">' + (it.qualified ? 'referred player paid a package' : 'referred player has no paid package yet') + '</span>' : '') + fl + '</div>' +
      '<div style="margin-top:4px"><b>' + esc(it.referrer) + '</b> <span class="meta">(' + esc(it.referrerId) + ')</span> referred <b>' + esc(it.referred) + '</b> <span class="meta">(' + esc(it.referredId) + ')</span></div>' +
      '<div class="meta">Recorded ' + esc(it.date) + ' · discount ' + money(it.discount) + (it.paymentId ? ' · applied to ' + esc(it.paymentId) : '') + (it.by ? ' · ' + esc(it.by) + ' ' + esc(it.at) : '') + '</div>' +
      (it.note ? '<div class="meta">Note: ' + esc(it.note) + '</div>' : '') +
      '<div class="acts">' + b.map(function (x) { return '<button class="btn ' + x[2] + '" data-ref="' + x[0] + '" data-id="' + esc(it.referralId) + '">' + x[1] + '</button>'; }).join('') + '</div></div>';
  }
  function refDo(it, op, extra, okMsg) {
    var body = Object.assign({ op: op, referralId: it.referralId, stamp: it.stamp }, extra);
    return api('refAction', body).catch(function (e) {
      if (/^NOT_QUALIFIED:/.test(e.message)) {
        return confirmBox(e.message.replace('NOT_QUALIFIED: ', '') + '\n\nApprove anyway?').then(function (yes) {
          if (!yes) throw new Error('Cancelled');
          body.force = '1'; return api('refAction', body);
        });
      }
      throw e;
    }).then(function (r) { return { msg: it.referralId + ' → ' + (okMsg || r.state || 'done') }; });
  }
  function refAct(op, it) {
    if (!it) return;
    if (op === 'approve') return ask('Approve ' + it.referralId, [], 'Approve', function () { return refDo(it, 'approve', {}); },
      it.referrer + ' referred ' + it.referred + '. ' + (it.qualified ? 'The referred player has a paid package.' : 'The referred player has NO paid package yet, so you will be asked to confirm.'));
    if (op === 'reject') return ask('Reject ' + it.referralId, [{ k: 'reason', label: 'Reason (min 5 chars)', type: 'textarea' }], 'Reject', function (v) { return refDo(it, 'reject', { reason: v.reason }); }, 'No discount is given.', true);
    if (op === 'apply') {
      if (!it.payments.length) { toast('The referrer has no unpaid package payment yet. Apply it when they top up.', 1); return; }
      return ask('Apply discount · ' + it.referralId, [
        { k: 'paymentId', label: 'Referrer\'s payment', type: 'select', options: it.payments.map(function (x) { return [x.paymentId, x.label]; }) },
        { k: 'amount', label: 'Discount (₱)', type: 'number', value: it.discount },
        { k: 'approvedBy', label: 'Approved by (email; only needed above the adjustment limit)' }
      ], 'Apply', function (v) { return refDo(it, 'apply', { paymentId: v.paymentId, amount: v.amount, approvedBy: v.approvedBy }, 'discount applied'); },
      'Lowers the payment total through the ledger (Adjustment). Safe to retry: it will not apply twice.');
    }
  }
  function refAdd() {
    ask('Add referral', [{ k: 'referrerId', label: 'Referrer Player ID (the one who referred)' }, { k: 'referredId', label: 'Referred Player ID (the new player)' }], 'Add',
      function (v) { return api('refAdd', v).then(function (r) { return { msg: r.msg }; }); },
      'For claims received by WhatsApp. The app form does not collect a referrer yet.');
  }
  /* === END: ADMIN CONSOLE — PHASE 4 VIEWS === */

  /* === START: ADMIN CONSOLE — PHASE 5 VIEWS (reports, alerts) === */
  var RPT_P = [['today', 'Today'], ['yesterday', 'Yesterday'], ['week', 'Last 7 days'], ['prevweek', 'Previous 7 days'], ['month', 'This month'], ['lastmonth', 'Last month']];
  var AL_L = { soon: 'Expiring soon', admin: 'Admin near-expiry', expired: 'Expired', member: 'Membership renewal', noshow: 'No-show follow-up' };

  function vRpt() {
    return Promise.all([api('reportGet', { period: S.rptP }), api('alertsPreview')]).then(function (r) {
      var d = r[0], D = d.data, a = r[1], c = a.counts;
      var st = function (l, v) { return '<div>' + esc(l) + '<b>' + esc(v) + '</b></div>'; };
      var prog = Object.keys(D.byProgram).map(function (k) { return k + ' ' + D.byProgram[k]; }).join(' · ') || '—';
      var h = '<div class="bar">' + selHtml('rptP', 190, RPT_P) + '<span class="meta">' + esc(d.label) + '</span><span style="flex:1"></span><button class="btn pri" id="rptsend">Email this report</button></div>' +
        '<div class="csec">Money</div><div class="sum">' + st('Collected', money(D.collected)) + st('Refunded', money(D.refunded)) + st('Net collected', money(D.net)) + st('Waived', money(D.waived)) +
        st('Adjustments', money(D.adjusted)) + st('Penalties charged', money(D.penalties)) + st('Reversed', money(D.reversed)) + st('New payment requests', D.newPayments + ' · ' + money(D.newPaymentsAmt)) + '</div>' +
        '<div class="csec">Players &amp; attendance</div><div class="sum">' + st('New enrollments', D.enrollments) + st('Present', D.present) + st('Late', D.late) + st('Absent', D.absent) + st('Walk-ins', D.walkins) + '</div>' +
        '<p class="meta">By program: ' + esc(prog) + '</p>' +
        '<div class="csec">Outstanding now (not period-based)</div><div class="sum">' + st('Balance owed', money(D.outstanding)) + st('Unpaid payments', D.outstandingN) + st('Overdue', D.overdueN + ' · ' + money(D.overdueAmt)) + '</div>' +
        '<div class="csec">Alerts due now (not yet sent)</div><div class="sum">' + Object.keys(AL_L).map(function (k) { return st(AL_L[k], c[k] || 0); }).join('') + '</div>' +
        (a.items.length ? '<div class="card">' + a.items.map(function (x) { return '<div class="krow"><div><b>' + esc(x.label) + '</b><span class="meta">' + esc(AL_L[x.type]) + '</span></div></div>'; }).join('') +
          (a.more ? '<div class="meta">+ ' + a.more + ' more</div>' : '') + '</div>' : '<div class="card meta">Nothing due.</div>') +
        '<div class="acts"><button class="btn" id="alrun">Send due alerts now</button></div>';
      view.innerHTML = h;
    });
  }
  function rptSend() {
    ask('Email report', [], 'Send', function () { return api('reportSend', { period: S.rptP }).then(function (r) { return { msg: r.msg, noReload: 1 }; }); },
      'Sends this period\'s full report to Config → AdminEmail. Today/Yesterday use the "Daily Payment Summary" email type; 7-day uses Weekly; month uses Monthly.');
  }
  function alRun() {
    ask('Send due alerts now', [], 'Send', function () { return api('alertsRun').then(function (r) { return { msg: r.msg }; }); },
      'Sends everything listed under "Alerts due now" to guardians (email + in-app) and admin. Each alert is sent once only.');
  }
  /* === END: ADMIN CONSOLE — PHASE 5 VIEWS === */

  /* ---------- events ---------- */
  document.addEventListener('click', function (e) {
    var t;
    if ((t = e.target.closest('[data-tab]'))) return go(t.dataset.tab);
    if ((t = e.target.closest('[data-go]'))) {
      if (t.dataset.st) S.payStatus = t.dataset.st;
      if (t.dataset.lt !== undefined) { S.ledType = t.dataset.lt; S.ledQ = ''; }
      return go(t.dataset.go);
    }
    if ((t = e.target.closest('[data-chip]'))) { S.payStatus = t.dataset.chip; return load(); }
    if ((t = e.target.closest('[data-act]'))) return payAct(t.dataset.act, items.filter(function (x) { return x.paymentId === t.dataset.id; })[0]);
    if ((t = e.target.closest('[data-pl]'))) return plOpen(t.dataset.pl);
    if ((t = e.target.closest('[data-th]'))) { S.thread = t.dataset.th; return load(); }
    if ((t = e.target.closest('[data-sch]'))) return schEdit(t.dataset.sch);
    if ((t = e.target.closest('[data-ec]'))) { S.excType = t.dataset.ec; return load(); }
    if ((t = e.target.closest('[data-wc]'))) { S.wkStatus = t.dataset.wc; return load(); }
    if ((t = e.target.closest('[data-exc]'))) return excAct(t.dataset.exc, excItems.filter(function (x) { return x.attendanceId === t.dataset.id; })[0]);
    if ((t = e.target.closest('[data-wk]'))) return wkAct(t.dataset.wk, wkItems.filter(function (x) { return x.walkInId === t.dataset.id; })[0]);
    if ((t = e.target.closest('[data-pkg]'))) return pkgEdit(t.dataset.pkg);
    if ((t = e.target.closest('[data-rv]'))) return rvSet(+t.dataset.i, t.dataset.p, t.dataset.rv);
    if ((t = e.target.closest('[data-rva]'))) return rvAct(t.dataset.rva, rvItems[+t.dataset.i]);
    if (e.target.id === 'autoas') return rvAuto();
    if ((t = e.target.closest('[data-ntf]'))) return ntfAct(ntfItems.filter(function (x) { return x.id === t.dataset.id; })[0]);
    if ((t = e.target.closest('[data-sys]'))) return sysAct(t.dataset.sys, t.dataset.fn);
    if ((t = e.target.closest('[data-cfg]'))) return cfgEdit(t.dataset.cfg);
    if ((t = e.target.closest('[data-enr]'))) return enrAct(t.dataset.enr, enrItems.filter(function (x) { return x.playerId === t.dataset.id; })[0]);
    if ((t = e.target.closest('[data-ref]'))) return refAct(t.dataset.ref, refItems.filter(function (x) { return x.referralId === t.dataset.id; })[0]);
    if (e.target.id === 'refadd') return refAdd();
    if (e.target.id === 'rptsend') return rptSend();
    if (e.target.id === 'alrun') return alRun();
    if (e.target.id === 'send') return sendReply();
    if (e.target.id === 'refresh') return load();
  });
  document.addEventListener('toggle', function (e) { var k = e.target.dataset && e.target.dataset.k; if (k) S.rvOpen[k] = e.target.open; }, true);
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Enter' && e.target.dataset && e.target.dataset.s) { S[e.target.dataset.s] = e.target.value.trim(); load(); }
  });
  document.addEventListener('change', function (e) {
    if (e.target.dataset && e.target.dataset.sel) { S[e.target.dataset.sel] = e.target.value; load(); }
  });

  $('#me').textContent = window.CONSOLE_ME || '';
  nav(); load();
})();
</script>
<!-- === END: ADMIN CONSOLE — SCRIPTS === -->
