/** Span ng isang session key (gamit ang EndTime sa Schedule). Fallback: 2 oras. */
function rvSpan_(key) {
  const m = /^(PRG-[A-Z]+)\|(\d{4}-\d{2}-\d{2})\|(\d{2}:\d{2})$/.exec(String(key || ''));
  if (!m) return null;
  const day = Utilities.formatDate(new Date(m[2] + 'T12:00:00+08:00'), 'Asia/Manila', 'EEEE');
  const row = sheet_(SHEETS.SCHEDULE.name).getDataRange().getValues().slice(1).filter(function (r) {
    return r[1] === m[1] && r[2] === day && fmtTime_(r[3]) === m[3];
  })[0];
  const mins = function (t) { const a = String(t).split(':'); return (+a[0]) * 60 + (+a[1]); };
  const s = mins(m[3]), e = row ? mins(fmtTime_(row[4])) : s + 120;
  return { date: m[2], s: s, e: e > s ? e : s + 120 };
}
function rvOverlap_(a, b) { return !!a && !!b && a.date === b.date && a.s < b.e && b.s < a.e; }
function rvBy_(p) { return 'staff:' + (String(p.by || '').replace(/[^\w .-]/g, '').slice(0, 40) || 'unknown'); } // self-declared, shared staff key

/** Auto-assign: assigned / skipped (may dahilan) / failed. Walang coach na mapupunta sa dalawang overlapping na session. */
function apiAutoAssign_(p) {
  if (!adminOk_(p.key)) throw new Error('Admin key required.');
  if (!staffOk_(p.key)) throw new Error('Wrong or missing staff key.');
  const ab = availByKey_(), prefs = {};
  coachPrefsSheet_().getDataRange().getValues().slice(1).forEach(function (r) {
    if (!r[0]) return;
    prefs[r[0]] = {
      programs: String(r[1] || '').split(',').map(function (s) { return s.trim(); }).filter(String),
      days: String(r[2] || '').split(',').map(function (s) { return s.trim().slice(0, 3); }).filter(String),
      priority: Number(r[3]) || 99
    };
  });
  const sh = scSheet_(), v = sh.getDataRange().getValues();
  const rowOf = {}, have = {}, load = {}, busy = {};
  for (let i = 1; i < v.length; i++) {
    rowOf[v[i][0]] = i + 1;
    if (v[i][1]) {
      have[v[i][0]] = true;
      load[v[i][1]] = (load[v[i][1]] || 0) + 1;
      const sp0 = rvSpan_(v[i][0]);
      if (sp0) (busy[v[i][1]] = busy[v[i][1]] || []).push(sp0);
    }
  }
  const assigned = [], skipped = [], failed = [];
  const list = (p.sessions || []).slice(0, 40).sort(function (a, b) { // pinakakaunting pagpipilian muna
    return ((ab[a.key] || []).length - (ab[b.key] || []).length) || String(a.key).localeCompare(String(b.key));
  });
  list.forEach(function (s) {
    const key = String(s.key || '');
    try { rvKeyCheck_(key); } catch (e) { failed.push({ key: key, reason: e.message }); return; }
    if (have[key]) { skipped.push({ key: key, reason: 'Already has a coach' }); return; }
    const sp = rvSpan_(key);
    const day = Utilities.formatDate(new Date(key.split('|')[1] + 'T12:00:00+08:00'), 'Asia/Manila', 'EEE');
    const progId = key.split('|')[0];
    let cands = ab[key] || [];
    if (!cands.length) { skipped.push({ key: key, reason: 'No coach marked available' }); return; }
    cands = cands.filter(function (c) {
      const pr = prefs[c.coachId];
      return !pr || ((!pr.programs.length || pr.programs.indexOf(progId) > -1) && (!pr.days.length || pr.days.indexOf(day) > -1));
    });
    if (!cands.length) { skipped.push({ key: key, reason: 'Available coaches do not match their program/day preferences' }); return; }
    cands = cands.filter(function (c) { return !(busy[c.coachId] || []).some(function (b) { return rvOverlap_(sp, b); }); });
    if (!cands.length) { skipped.push({ key: key, reason: 'Available coaches are already on an overlapping session' }); return; }
    const pri = function (c) { return (prefs[c.coachId] || {}).priority || 99; };
    cands.sort(function (a, b) { return pri(a) - pri(b) || (load[a.coachId] || 0) - (load[b.coachId] || 0) || a.name.localeCompare(b.name); });
    const c = cands[0];
    try {
      if (rowOf[key]) sh.getRange(rowOf[key], 2, 1, 2).setValues([[c.coachId, c.name]]); else sh.appendRow([key, c.coachId, c.name]);
    } catch (e) { failed.push({ key: key, reason: 'Save failed: ' + e.message }); return; }
    have[key] = true; load[c.coachId] = (load[c.coachId] || 0) + 1;
    if (sp) (busy[c.coachId] = busy[c.coachId] || []).push(sp);
    assigned.push({ key: key, coachId: c.coachId, coach: c.name });
    logAudit_('COACH_ASSIGNED', key + ' — none → ' + c.coachId + ' (auto)', rvBy_(p));
  });
  rvFlush_();
  logAudit_('COACH_AUTO_ASSIGN', assigned.length + ' assigned · ' + skipped.length + ' skipped · ' + failed.length + ' failed', rvBy_(p));
  return { success: true, assigned: assigned, skipped: skipped, failed: failed };
}

/** Manual assign: server-validated (coach exists, overlap), may babala sa availability, at may audit. coachId '' = unassign. */
function apiAssignSessionCoach_(p) {
  if (!adminOk_(p.key)) throw new Error('Admin key required.');
  if (!staffOk_(p.key)) throw new Error('Wrong or missing staff key.');
  rvKeyCheck_(p.sessionKey);
  const coachId = String(p.coachId || '').trim();
  const coach = coachId ? coachesList_().filter(function (c) { return c.coachId === coachId; })[0] : null;
  if (coachId && !coach) throw new Error('Coach not found in the Coaches sheet.');
  const sh = scSheet_(), v = sh.getDataRange().getValues();
  let row = -1, prev = '';
  const mine = [];
  for (let i = 1; i < v.length; i++) {
    if (v[i][0] === p.sessionKey) { row = i + 1; prev = v[i][1] || ''; }
    else if (coachId && v[i][1] === coachId) mine.push(v[i][0]);
  }
  if (prev === coachId) return { success: true, unchanged: true, coachId: coachId, coachName: coach ? coach.name : '', warnings: [] };
  const warnings = [];
  const force = String(p.force) === '1';
  if (coachId) {
    const sp = rvSpan_(p.sessionKey);
    const clash = mine.filter(function (k) { return rvOverlap_(sp, rvSpan_(k)); });
    if (clash.length && !force) throw new Error('CONFLICT: ' + coach.name + ' is already assigned to an overlapping session (' + clash[0] + ').');
    if (clash.length) warnings.push('overlap override');
    const av = coachAvailSheet_().getDataRange().getValues().slice(1).filter(function (r) { return r[0] === coachId && r[1] === p.sessionKey; })[0];
    if (!av || av[2] !== 'yes') warnings.push(av && av[2] === 'no' ? 'coach marked unavailable' : 'coach did not mark available');
  }
  const rec = [p.sessionKey, coachId, coach ? coach.name : ''];
  if (row > 0) sh.getRange(row, 1, 1, 3).setValues([rec]); else sh.appendRow(rec);
  rvFlush_();
  logAudit_(coachId ? 'COACH_ASSIGNED' : 'COACH_UNASSIGNED', p.sessionKey + ' — ' + (prev || 'none') + ' → ' + (coachId || 'none') + (warnings.length ? ' [' + warnings.join('; ') + ']' : '') + (force ? ' FORCED' : ''), rvBy_(p));
  return { success: true, coachId: coachId, coachName: coach ? coach.name : '', previous: prev, warnings: warnings };
}

