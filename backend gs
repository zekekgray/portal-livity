function consolePayAction_(p, who) {
  const id = String(p.paymentId || '').trim(), op = String(p.op || '');
  const rid = String(p.requestId || '').replace(/[^\w-]/g, '').slice(0, 40);
  if (['verify', 'reject', 'reverse', 'waive', 'adjust', 'refundRequest', 'refundComplete', 'dueDate'].indexOf(op) < 0) throw new Error('Unknown operation.');
  if (rid && hasAuditAction_('PAYACT_' + rid)) return { duplicate: true, state: '', summary: payLedgerSummary_(id) };
  const f = payFindRow_(id);
  if (!f) throw new Error('PaymentID not found: ' + id);
  if (['verify', 'reject', 'reverse'].indexOf(op) > -1 && String(p.stamp || '') !== payStamp_(f.row)) throw new Error('CHANGED: This payment was updated since you opened it. Refresh and review again.');
  const force = String(p.force) === '1', reason = String(p.reason || '').trim(), st = String(f.row[6]);
  let r;
  if (op === 'verify') {
    const amt = Number(p.amount);
    if (!(amt > 0)) throw new Error('Enter the amount received.');
    const dup = /DUP_REF:([A-Z0-9-]+)/.exec(String(f.row[12] || ''));
    if (dup && !force) throw new Error('DUPLICATE: Same reference or photo as ' + dup[1] + '.');
    const remaining = payBalance_(f.row, new Date());
    if (amt > remaining && !force) throw new Error('OVERPAID: ₱' + amt + ' is more than the ₱' + remaining + ' still owed. No credit is recorded for the extra.');
    r = verifyPayment_(id, amt);
  } else if (op === 'reject') r = rejectPayment_(id, reason);
  else if (op === 'reverse') r = reversePayment_(id, reason);
  else if (op === 'waive' || op === 'adjust') r = adjustPaymentTotal_(id, op, p.amount, reason, who, p.approvedBy, rid);
  else if (op === 'refundRequest') r = refundRequest_(id, p.amount, reason, who, rid);
  else if (op === 'refundComplete') r = refundComplete_(id, p.amount, reason, who, rid);
  else if (op === 'dueDate') {
    if (['Pending', 'Overdue', 'Submitted', 'Partial', 'Rejected'].indexOf(st) < 0) throw new Error('Only unpaid payments can change due date (status: ' + st + ').');
    const tz = Session.getScriptTimeZone(); let nd;
    try { nd = Utilities.parseDate(String(p.dueAt || '').replace('T', ' ').trim(), tz, 'yyyy-MM-dd HH:mm'); } catch (e) { throw new Error('Invalid date/time.'); }
    const before = payBalance_(f.row, new Date()), oldDue = f.row[8] ? Utilities.formatDate(new Date(f.row[8]), tz, 'MMM d h:mm a') : '(default)';
    f.sheet.getRange(f.rowIndex, 9).setValue(nd);
    if (st === 'Overdue' && nd.getTime() > Date.now()) f.sheet.getRange(f.rowIndex, 7).setValue('Pending');
    const after = payBalance_(f.row.map(function (v, k) { return k === 8 ? nd : v; }), new Date());
    ledgerAdd_({ type: 'DUE_DATE_CHANGED', paymentId: id, playerId: f.row[1], amount: 0, before: before, after: after, reason: 'Due ' + oldDue + ' → ' + Utilities.formatDate(nd, tz, 'MMM d h:mm a'), by: who, ref: rid });
    try {
      const pr = findRowById_(SHEETS.PLAYERS.name, f.row[1]);
      sendNotification_('PAY_DEADLINE_CHANGED', { id: f.row[1], email: pr ? pr[6] : '' }, { amount: f.row[3], playerName: pr ? pr[1] : f.row[1], newDate: Utilities.formatDate(nd, tz, 'MMM d, h:mm a') });
    } catch (e) {}
    logAudit_('PAYMENT_DUE_CHANGED', id + ' — new due ' + nd, who);
    r = { ok: true, state: st === 'Overdue' && nd.getTime() > Date.now() ? 'Pending' : st };
  }
  if (!r.ok) throw new Error(r.error);
  if (rid) logAudit_('PAYACT_' + rid, id + ' ' + op + ' → ' + (r.state || ''), who);
  return Object.assign({ summary: payLedgerSummary_(id) }, r);
}

