/** DueAt column (I); kapag wala (lumang rows) = DateTime + PaymentDeadlineHours. */
function paymentDueAt_(row, rule) {
  if (row[8]) { const d = new Date(row[8]); if (!isNaN(d.getTime())) return d; }
  return new Date(new Date(row[5]).getTime() + rule.deadlineHours * 3600000);
}

/** Hanggang anong oras tumatakbo ang orasan: SubmittedAt kung meron (frozen); Paid/Submitted na walang timestamp = walang penalty; kung hindi, NGAYON. */
function paymentEndAt_(row, now) {
  if (row[6] === 'Partial' || row[6] === 'Rejected') return now; // may natitira pa: tuloy ang orasan
  if (row[11]) { const s = new Date(row[11]); if (!isNaN(s.getTime())) return s; }
  if (row[6] === 'Paid' || row[6] === 'Submitted') return null;
  return now;
}

function penaltyFor_(dueAt, endAt, rule) {
  if (!endAt) return { amount: 0, overdueMs: 0 };
  const overMs = endAt.getTime() - dueAt.getTime();
  if (overMs - rule.graceMinutes * 60000 <= 0) return { amount: 0, overdueMs: 0 };
  const extraDays = rule.perDay > 0 ? Math.floor(overMs / 86400000) : 0;
  return { amount: rule.flat + rule.perDay * extraDays, overdueMs: overMs };
}

// ---------- PAYMENTS FOR PROFILE (bagong getPlayerPaymentsData_) ----------

function getPlayerPaymentsData_(playerId) {
  if (!playerId) return { success: false, error: 'Missing playerId.' };
  const playerRow = findRowById_(SHEETS.PLAYERS.name, playerId);
  if (!playerRow) return { success: false, error: 'Player not found.' };

  const programsData = sheet_(SHEETS.PROGRAMS.name).getDataRange().getValues();
  const programNames = {};
  for (let i = 1; i < programsData.length; i++) programNames[programsData[i][0]] = programsData[i][1];

  const packagesData = sheet_(SHEETS.PACKAGES.name).getDataRange().getValues();
  const packagesById = {};
  for (let i = 1; i < packagesData.length; i++) {
    const r = packagesData[i];
    packagesById[r[0]] = { priceId: r[2], sessionsTotal: Number(r[4]) };
  }

  const now = new Date();
  const rule = getPenaltyRule_();
  const payData = sheet_(SHEETS.PAYMENTS.name).getDataRange().getValues();
  const payments = [];
  let balanceDue = 0;

  for (let i = 1; i < payData.length; i++) {
    const row = payData[i];
    if (row[1] !== playerId) continue;

    const pkg = packagesById[row[2]] || null;
    const priceRow = pkg ? findRowById_(SHEETS.PRICING.name, pkg.priceId) : null;
    const programId = priceRow ? priceRow[1] : '';
    const packageType = priceRow ? priceRow[3] : '';
    const label = priceRow ? (programNames[programId] || programId) + (packageType ? ' — ' + packageType : '') : 'Payment';

    const dueAt = paymentDueAt_(row, rule);
    const pen = penaltyFor_(dueAt, paymentEndAt_(row, now), rule);
    let status = row[6];
    if (status === 'Pending' && now >= dueAt) status = 'Overdue'; // derived live, kahit hindi pa nag-flip ang trigger
    const base = Number(row[3]);
    const adj_ = Number(row[16]) || 0;
    const total = Math.max(0, base + pen.amount + adj_);
    const verified_ = Number(row[15]) || 0;
    const unpaid = (status === 'Pending' || status === 'Overdue' || status === 'Partial' || status === 'Rejected');
    if (unpaid) balanceDue += Math.max(0, total - verified_);

    payments.push({
      paymentId: row[0], amount: base, penalty: pen.amount, total: total,
      method: row[4], date: new Date(row[5]).toISOString(), status: status, label: label,
      sessions: pkg ? pkg.sessionsTotal : null,
      dueAt: dueAt.toISOString(), reference: row[9] ? String(row[9]) : '',
      submittedAt: row[11] ? new Date(row[11]).toISOString() : '',
      verified: verified_, remaining: Math.max(0, total - verified_), adjustment: adj_, rejectReason: String(row[14] || '')
    });
  }
  payments.sort(function (a, b) { return new Date(b.date) - new Date(a.date); });

  return {
    success: true, playerId: playerId, playerName: playerRow[1], balanceDue: balanceDue, payments: payments,
    serverNow: now.toISOString(),
    penaltyRule: rule,
    methods: getPaymentMethods_()
  };
}

// ---------- SUBMIT PROOF (amount + reference) — timestamp + signed meta, fail-safe ----------

function metaClean_(s) { return String(s == null ? '' : s).replace(/[|\r\n]/g, '/').trim(); }

function metaSig_(s) {
  const sig = Utilities.computeHmacSha256Signature(s, qrSecret_());
  return sig.slice(0, 8).map(function (b) { return ('0' + (b & 0xff).toString(16)).slice(-2); }).join('');
}

/** Tamper check: i-run sa editor gamit ang laman ng Meta cell → testMetaSig_('...') */
function testMetaSig_(meta) {
  const i = String(meta).lastIndexOf('|sig=');
  Logger.log(i > -1 && metaSig_(String(meta).slice(0, i)) === String(meta).slice(i + 5) ? 'META OK' : 'META TAMPERED / INVALID');
}

function handleSubmitPayment_(body) {
  const paymentId = String(body.paymentId || '').trim();
  const playerId = String(body.playerId || '').trim();
  let reference = String(body.reference || '').replace(/\s+/g, '').toUpperCase();
  const amountPaid = Number(body.amount);
  const methodName = metaClean_(body.method);
  const imgRaw_ = String(body.image || '');
  const imgM_ = imgRaw_.length <= 400000 ? /^data:image\/(jpeg|png);base64,(.+)$/.exec(imgRaw_) : null;

  if (!paymentId || !playerId || !body.contact) return { success: false, error: 'Missing payment details.' };
  if (imgRaw_ && !imgM_) return { success: false, error: 'The receipt photo is invalid or too large. Please try another one.' };
  if (!reference && imgM_) reference = ('PHOTO-' + paymentId).toUpperCase(); // walang reference no. = photo ang proof
  if (!/^[A-Z0-9-]{6,32}$/.test(reference)) return { success: false, error: 'Please enter a valid reference number (6–32 letters or numbers), or attach a photo of your receipt.' };
  if (!(amountPaid > 0) || amountPaid > 1000000) return { success: false, error: 'Please enter the amount you sent.' };

  const auth = authPlayerRow_(playerId, body.contact);
  if (auth.error) return { success: false, error: auth.error };

  const sheet = sheet_(SHEETS.PAYMENTS.name);
  const data = sheet.getDataRange().getValues();
  let idx = -1, dupOf = '';
  for (let i = 1; i < data.length; i++) {
    if (data[i][0] === paymentId) idx = i;
    else if (data[i][9] && String(data[i][9]).toUpperCase() === reference) dupOf = data[i][0];
  }
  if (idx < 0 || data[idx][1] !== playerId) return { success: false, error: 'Payment not found.' };
  if (!dupOf && !/^PHOTO-/.test(reference)) { // ang reference ng naunang partial ay nasa Ledger pa rin kahit na-overwrite sa col J
    const hit_ = ledgerRows_().filter(function (r) { return r[4] === 'SUBMITTED' && String(r[11]).toUpperCase() === reference && r[2] !== paymentId; })[0];
    if (hit_) dupOf = hit_[2];
  }
  let imgHash = '';
  if (imgM_) {
    try { imgHash = Utilities.computeDigest(Utilities.DigestAlgorithm.MD5, Utilities.base64Decode(imgM_[2])).map(function (b) { return ('0' + (b & 0xff).toString(16)).slice(-2); }).join(''); } catch (e) {}
    if (imgHash) for (let i = 1; i < data.length; i++) if (i !== idx && String(data[i][12] || '').indexOf('imgHash=' + imgHash) > -1) { dupOf = dupOf || data[i][0]; break; }
  }
  const row = data[idx];

  const tz = Session.getScriptTimeZone();
  const fmtIso = function (d) { return Utilities.formatDate(d, tz, "yyyy-MM-dd'T'HH:mm:ssXXX"); };
  const fmtLabel = function (d) { return Utilities.formatDate(d, tz, 'MMM d, yyyy h:mm:ss a'); };
  const rule = getPenaltyRule_();
  const dueAt = paymentDueAt_(row, rule);
  const base = Number(row[3]);

  if (row[6] === 'Paid') return { success: false, error: 'This payment is already confirmed.' };
  if (['Pending', 'Overdue', 'Submitted', 'Rejected', 'Partial'].indexOf(String(row[6])) < 0) return { success: false, error: 'This payment is ' + row[6] + ' and can no longer be submitted. Message Admin JA.' };
  if (row[6] === 'Submitted') {
    if (String(row[9]).toUpperCase() === reference) { // retry ng parehong submission → idempotent
      const p0 = penaltyFor_(dueAt, new Date(row[11]), rule).amount;
      return { success: true, duplicate: true, paymentId: paymentId, reference: reference, submittedAtLabel: fmtLabel(new Date(row[11])), receiptCode: '', penalty: p0, total: base + p0, flags: [] };
    }
    return { success: false, error: 'A reference was already sent for this payment. Message Admin JA if it needs correcting.' };
  }

  const now = new Date();
  const pen = penaltyFor_(dueAt, now, rule);
  const total = Math.max(0, base + pen.amount + (Number(row[16]) || 0));

  let proofUrl = '';
  if (imgM_) {
    try {
      const itF = DriveApp.getFoldersByName('Livity Payment Proofs');
      const folder = itF.hasNext() ? itF.next() : DriveApp.createFolder('Livity Payment Proofs');
      const blob = Utilities.newBlob(Utilities.base64Decode(imgM_[2]), 'image/' + imgM_[1], paymentId + '_' + Utilities.formatDate(now, tz, 'yyyyMMdd-HHmmss') + (imgM_[1] === 'png' ? '.png' : '.jpg'));
      proofUrl = folder.createFile(blob).getUrl(); // private: ikaw lang (owner) ang may access
    } catch (e) {
      logAudit_('PAYMENT_PROOF_PHOTO_FAILED', paymentId + ' — ' + e, null);
      if (reference === ('PHOTO-' + paymentId).toUpperCase()) return { success: false, error: "We couldn't save your photo. Please try again or enter a reference number." };
    }
  }

  const flags = [];
  if (proofUrl) flags.push('PHOTO_PROOF');
  const owed_ = Math.max(0, total - (Number(row[15]) || 0)), baseOwed_ = Math.max(0, base - (Number(row[15]) || 0));
  if (amountPaid < owed_) flags.push(amountPaid >= baseOwed_ ? 'MISSING_PENALTY' : 'UNDERPAID');
  else if (amountPaid > owed_) flags.push('OVERPAID');
  if (pen.amount > 0) flags.push('LATE');
  if (dupOf) flags.push('DUP_REF:' + dupOf);
  if (String(body.retry) === '1') flags.push('OFFLINE_RETRY');

  const metaCore = [
    'ts=' + fmtIso(now), 'tz=' + tz, 'pay=' + paymentId, 'player=' + playerId,
    'method=' + methodName, 'ref=' + reference, 'amt=' + amountPaid,
    'base=' + base, 'penalty=' + pen.amount, 'total=' + total, 'due=' + fmtIso(dueAt),
    'clientTs=' + metaClean_(body.clientTs).slice(0, 30), 'rid=' + metaClean_(body.requestId).slice(0, 40),
    'ua=' + metaClean_(body.ua).slice(0, 80), 'proof=' + proofUrl, 'imgHash=' + imgHash, 'flags=' + (flags.join(',') || 'OK')
  ].join('|');
  const sig = metaSig_(metaCore);
  const meta = metaCore + '|sig=' + sig;

  // Proof columns muna, status ang HULI (commit point) — kapag pumalya sa gitna, puwedeng ulitin nang walang sira.
  sheet.getRange(idx + 1, 10).setNumberFormat('@');
  sheet.getRange(idx + 1, 10, 1, 4).setValues([[reference, amountPaid, now, meta]]);
  if (proofUrl) sheet.getRange(idx + 1, 14).setValue(proofUrl);
  if (methodName) sheet.getRange(idx + 1, 5).setValue(methodName);
  sheet.getRange(idx + 1, 7).setValue('Submitted');

  logAudit_('PAYMENT_PROOF_SUBMITTED', meta, null);
  const bal_ = Math.max(0, total - (Number(row[15]) || 0));
  ledgerAdd_({ type: 'SUBMITTED', paymentId: paymentId, playerId: playerId, amount: amountPaid, before: bal_, after: bal_, reason: 'Proof submitted (' + (flags.join(',') || 'OK') + ')', by: 'guardian:' + playerId, ref: reference });

  try {
    const playerRow = findRowById_(SHEETS.PLAYERS.name, playerId);
    const guardianEmail = playerRow ? playerRow[6] : '';
    const guardianName = playerRow ? playerRow[4] : '';
    const playerName = playerRow ? playerRow[1] : playerId;

    sendNotification_('PAY_SUBMITTED', { id: playerId, email: guardianEmail }, { amount: amountPaid, playerName: playerName });
    sendNotification_('ADMIN_PAYMENT_VERIFY', { email: getConfigValue_('AdminEmail') }, { amount: amountPaid, guardianName: guardianName });

    if (flags.indexOf('UNDERPAID') > -1 || flags.indexOf('MISSING_PENALTY') > -1) {
      sendNotification_('PAY_PARTIAL_SUBMITTED', { id: playerId, email: guardianEmail }, { playerName: playerName, amount: amountPaid, total: total });
      sendNotification_('ADMIN_PARTIAL_PAYMENT', { email: getConfigValue_('AdminEmail') }, { guardianName: guardianName, amount: amountPaid, total: total, playerName: playerName });
    }

    if (dupOf) {
      sendNotification_('ADMIN_DUP_REFERENCE', { email: getConfigValue_('AdminEmail') }, { reference: reference, dupOf: dupOf });
    }
  } catch (e) { logAudit_('PAYMENT_NOTIFY_FAILED', paymentId + ' — ' + e, null); } // hindi dapat masira ang proof dahil sa email

  return {
    success: true, paymentId: paymentId, reference: reference, submittedAtLabel: fmtLabel(now),
    receiptCode: sig.slice(0, 8).toUpperCase(), penalty: pen.amount, total: total, owed: owed_, flags: flags
  };
}

// ---------- FOLLOW-UP NOTIFICATIONS — laging live ang amount + penalty ----------

function notifyPaymentOverdue_(row, total, penalty) {
  const playerRow = findRowById_(SHEETS.PLAYERS.name, row[1]);
  const playerName = playerRow ? playerRow[1] : row[1];
  sendNotification_('PAY_OVERDUE', { id: row[1], email: playerRow ? playerRow[6] : '' },
    { playerName: playerName, amount: total, penalty: penalty, asOf: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'MMM d, h:mm a') });
  sendNotification_('ADMIN_PAYMENT_OVERDUE', { email: getConfigValue_('AdminEmail') },
    { playerName: playerName, amount: total, guardianName: playerRow ? playerRow[4] : '' });
}

/** Pending na lampas na sa DueAt → 'Overdue' + isang notif. Hindi na ginagalaw ang Amount. */
function flagNewlyOverdue_() {
  const sheet = sheet_(SHEETS.PAYMENTS.name);
  const data = sheet.getDataRange().getValues();
  const rule = getPenaltyRule_();
  const now = new Date();
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    if (row[6] !== 'Pending') continue;
    const dueAt = paymentDueAt_(row, rule);
    if (now < dueAt) continue;
    sheet.getRange(i + 1, 7).setValue('Overdue');
    const pen = penaltyFor_(dueAt, now, rule).amount;
    notifyPaymentOverdue_(row, Number(row[3]) + pen, pen);
    logAudit_('PAYMENT_OVERDUE_FLAGGED', row[0] + ' — base ₱' + row[3] + ' + live penalty ₱' + pen, null);
    if (pen > 0) ledgerAdd_({ type: 'PENALTY', paymentId: row[0], playerId: row[1], amount: pen, before: Number(row[3]), after: Number(row[3]) + pen, reason: 'Late penalty started (live-computed from DueAt)', by: 'system' });

    if (pen > 0) {
      try {
        const playerRow = findRowById_(SHEETS.PLAYERS.name, row[1]);
        sendNotification_('PAY_PENALTY_STARTED', { id: row[1], email: playerRow ? playerRow[6] : '' }, { playerName: playerRow ? playerRow[1] : row[1], amount: row[3], penalty: pen });
      } catch (e) { logAudit_('PAYMENT_NOTIFY_FAILED', row[0] + ' — penalty started — ' + e, null); }
    }
  }
}

/** 9PM / 8AM — lahat ng unpaid (Pending + Overdue). Overdue = tuloy-tuloy na follow-up na may kasalukuyang penalty. */
function sendPaymentDueReminders_() {
  const sheet = sheet_(SHEETS.PAYMENTS.name);
  const data = sheet.getDataRange().getValues();
  const rule = getPenaltyRule_();
  const now = new Date();
  const tz = Session.getScriptTimeZone();
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    if (['Pending', 'Overdue', 'Partial', 'Rejected'].indexOf(row[6]) < 0) continue;
    const dueAt = paymentDueAt_(row, rule);
    const pen = penaltyFor_(dueAt, now, rule).amount;
    const total = payBalance_(row, now);
    if (now >= dueAt) {
      if (row[6] === 'Pending') sheet.getRange(i + 1, 7).setValue('Overdue');
      notifyPaymentOverdue_(row, total, pen);
    } else {
      const playerRow = findRowById_(SHEETS.PLAYERS.name, row[1]);
      sendNotification_('PAY_DUE_SOON', { id: row[1], email: playerRow ? playerRow[6] : '' },
        { playerName: playerRow ? playerRow[1] : row[1], amount: total, dueDate: Utilities.formatDate(dueAt, tz, 'MMM d, h:mm a') });
    }
  }
}

/** 5PM — babala sa mga malapit nang mag-due (FinalWarningHours). */
function sendPaymentWarning5PM_() {
  const data = sheet_(SHEETS.PAYMENTS.name).getDataRange().getValues();
  const rule = getPenaltyRule_();
  const now = new Date();
  const tz = Session.getScriptTimeZone();
  const warnMs = (Number(getConfigValue_('FinalWarningHours')) || 3) * 3600000;
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    if (row[6] !== 'Pending') continue;
    const dueAt = paymentDueAt_(row, rule);
    const left = dueAt.getTime() - now.getTime();
    if (left <= 0 || left > warnMs) continue;
    const playerRow = findRowById_(SHEETS.PLAYERS.name, row[1]);
    sendNotification_('PAY_FINAL_WARNING', { id: row[1], email: playerRow ? playerRow[6] : '' }, {
      guardianName: playerRow ? playerRow[4] : '', playerName: playerRow ? playerRow[1] : row[1],
      amount: Number(row[3]), penalty: rule.flat, dueDate: Utilities.formatDate(dueAt, tz, 'MMM d, h:mm a')
    });
    logAudit_('PAYMENT_5PM_WARNING', row[0] + ' — due ' + Utilities.formatDate(dueAt, tz, 'MMM d h:mm a'), null);
  }
}

/** 8PM trigger — safety net na lang: nag-fa-flag ng Overdue. WALA nang pag-mutate ng Amount. */
function applyOverduePenalty8PM_() { flagNewlyOverdue_(); }

/** Hourly clock — para ma-flag agad pag lumampas sa DueAt (hindi na naghihintay ng 8PM). */
function runPaymentClockHourly_() {
  try { flagNewlyOverdue_(); }
  catch (err) { logAudit_('SYS_GAS_ERROR', 'Hourly payment clock failed: ' + err, null); notifySystem_('SYS_GAS_ERROR', 'Hourly payment clock failed: ' + err); }
