/** Next occurrences (as Date objects) of a weekly recurring day+time within the next N days, including today if not yet passed. */
function scheduleOccurrencesWithin_(dayName, timeStr, daysAhead) {
  const tz = Session.getScriptTimeZone();
  const now = new Date();
  const results = [];
  for (let d = 0; d <= daysAhead; d++) {
    const cand = new Date(now.getTime() + d * 86400000);
    if (Utilities.formatDate(cand, tz, 'EEEE') !== dayName) continue;
    const dateStr = Utilities.formatDate(cand, tz, 'yyyy-MM-dd');
    results.push(Utilities.parseDate(dateStr + ' ' + timeStr, tz, 'yyyy-MM-dd HH:mm'));
  }
  return results;
}

const REMINDER_LADDER_RUNGS = [
  { key: 'SCHED_REMIND_7D', hours: 168 },
  { key: 'SCHED_REMIND_24H', hours: 24 },
