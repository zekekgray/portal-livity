/** Enabled methods lang, sorted. */
function getPaymentMethods_() {
  const sh = sheet_(SHEETS.PAYMENT_METHODS.name);
  if (!sh) return [];
  const data = sh.getDataRange().getValues();
  const out = [];
  for (let i = 1; i < data.length; i++) {
    const r = data[i];
    const enabled = r[5] === true || String(r[5]).toLowerCase() === 'true';
    let acct = r[3];
    if (typeof acct === 'number') { acct = String(acct); if (acct.length === 10 && acct.charAt(0) === '9') acct = '0' + acct; }
    acct = String(acct == null ? '' : acct).trim();
    if (!enabled || !r[2] || !acct) continue;
    out.push({ methodId: r[0], type: r[1] || 'Bank', name: String(r[2]), accountNumber: acct, accountName: String(r[4] || ''), notes: String(r[7] || ''), _o: Number(r[6]) || 999, _i: i });
  }
  out.sort(function (a, b) { return a._o - b._o || a._i - b._i; });
  return out.map(function (m) { delete m._o; delete m._i; return m; });
}

/** Bagong getPaymentInfo_ — methods galing sa sheet. May legacy gcash/bank keys para hindi mag-crash ang lumang cached na frontend. */
function getPaymentInfo_() {
  const methods = getPaymentMethods_();
