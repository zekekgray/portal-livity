/** Nagbabawas ng 1 session SA TAMANG PROGRAM LANG. Walang programId = walang bawas (hindi hahanap ng ibang balance).
 *  Pinipili: started na package na pinakamaagang mag-expire muna, saka pinakamatandang hindi pa started. */
function deductPackageSession_(playerId, programId, when) {
  if (!programId) { logAudit_('DEDUCT_SKIPPED', playerId + ' — walang programId, walang ibinawas', null); return false; }
  when = (when instanceof Date && !isNaN(when.getTime())) ? when : new Date();
  const sheet = sheet_(SHEETS.PACKAGES.name), data = sheet.getDataRange().getValues();
  const cands = [];
  for (let i = 1; i < data.length; i++) {
    const r = data[i];
    if (r[1] !== playerId || r[7] !== 'Active') continue;
    if (!(Number(r[4]) > 0) || Number(r[5]) >= Number(r[4])) continue;       // walang sessions / ubos na (kasama ang Membership)
    if (r[6] && when > new Date(r[6])) continue;                               // expired sa oras ng scan
    const pr = findRowById_(SHEETS.PRICING.name, r[2]);
    if (!pr || pr[1] !== programId) continue;                                  // iba ang program
    const isAs_ = (pr[3] === 'Assessment'); // assessment package: pwedeng bawasan, inuuna                                      // assessment ay hindi para sa ordinaryong training
    cands.push({ as: isAs_, i: i, exp: r[6] ? new Date(r[6]).getTime() : null, buy: new Date(r[3]).getTime() || 0, pr: pr });
  }
  if (!cands.length) return false;
  cands.sort(function (a, b) {
    if (a.as !== b.as) return a.as ? -1 : 1; // assessment muna
    if ((a.exp !== null) !== (b.exp !== null)) return a.exp !== null ? -1 : 1;
    if (a.exp !== null && a.exp !== b.exp) return a.exp - b.exp;
    return a.buy - b.buy || a.i - b.i;
  });
  const c = cands[0], row = data[c.i], newUsed = Number(row[5]) + 1;
  sheet.getRange(c.i + 1, 6).setValue(newUsed);
  if (!row[6]) {
    const days = Number(c.pr[6]) || 0;
    if (days > 0) sheet.getRange(c.i + 1, 7).setValue(new Date(when.getTime() + days * 86400000));
  }
  if (newUsed >= Number(row[4])) sheet.getRange(c.i + 1, 8).setValue('Completed');
  logAudit_('SESSION_DEDUCTED', row[0] + ' — ' + playerId + ' ' + programId + ': ' + (Number(row[4]) - Number(row[5])) + ' → ' + (Number(row[4]) - newUsed) + ' left', null);
  return row[0];
}
