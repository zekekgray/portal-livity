      flags: fm ? fm[1] : '', stamp: payStamp_(r)
    });
  }
  out.sort(function (a, b) { return a._t - b._t; }); // pinakamatagal na naghihintay muna
  out.forEach(function (x) { delete x._t; });
  return { success: true, items: out.slice(0, 100), counts: counts };
}

function apiAdminPayAction_(p) {
  if (!adminOk_(p.key)) throw new Error('Admin key required.');
  if (!staffOk_(p.key)) throw new Error('Wrong or missing staff key.');
  const op = String(p.op || ''), id = String(p.paymentId || '').trim();
  const rid = String(p.requestId || '').replace(/[^\w-]/g, '').slice(0, 40);
  if (['verify', 'reject', 'reverse'].indexOf(op) < 0) throw new Error('Unknown operation.');
  if (rid && hasAuditAction_('PAYACT_' + rid)) return { success: true, duplicate: true, summary: payLedgerSummary_(id) }; // retry = hindi uulitin
  const f = payFindRow_(id);
  if (!f) throw new Error('PaymentID not found: ' + id);
  if (String(p.stamp || '') !== payStamp_(f.row)) throw new Error('CHANGED: This payment was updated since you opened it. Refresh and review again.');
  const force = String(p.force) === '1', reason = String(p.reason || '').trim();
  PAY_ACTOR_ = rvBy_(p); // doPost na ang may hawak ng script lock, kaya walang withScriptLock_ dito
  try {
    let r;
    if (op === 'verify') {
      const amt = Number(p.amount);
      if (!(amt > 0)) throw new Error('Enter the amount received.');
      const dup = /DUP_REF:([A-Z0-9-]+)/.exec(String(f.row[12] || ''));
      if (dup && !force) throw new Error('DUPLICATE: Same reference or photo as ' + dup[1] + '.');
      const remaining = payBalance_(f.row, new Date());
      if (amt > remaining && !force) throw new Error('OVERPAID: ₱' + amt + ' is more than the ₱' + remaining + ' still owed. No credit is recorded for the extra.');
      r = verifyPayment_(id, amt);
    } else if (op === 'reject') r = rejectPayment_(id, reason);
    else r = reversePayment_(id, reason);
    if (!r.ok) throw new Error(r.error);
    if (rid) logAudit_('PAYACT_' + rid, id + ' ' + op + ' → ' + (r.state || ''), PAY_ACTOR_);
    return Object.assign({ success: true, summary: payLedgerSummary_(id) }, r);
  } finally { PAY_ACTOR_ = ''; }
}

