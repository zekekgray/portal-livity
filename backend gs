/** Run sa editor. Sinusubok: partial → duplicate → resubmit → full verify → double-verify → reverse → resubmit-after-reverse. */
function testPaymentLifecycle_() {
  const R = [], PID = 'LVTFA-ZTEST01', PH = '09170000001';
  const ok = function (c, m) { R.push((c ? 'PASS  ' : 'FAIL  ') + m); };
  const pay = function (id) { return payFindRow_(id).row; };
  const pkgSt = function (id) { const d = sheet_(SHEETS.PACKAGES.name).getDataRange().getValues(); for (let i = 1; i < d.length; i++) if (d[i][0] === id) return d[i][7]; return '?'; };
  const cnt = function (k) { return NOTIF_LOG_.filter(function (x) { return x === k; }).length; };
  NOTIF_SUPPRESS_ = true; NOTIF_LOG_ = [];
  try {
    sheet_(SHEETS.PLAYERS.name).appendRow([PID, 'ZZ Test Player', '2015', 'U9-U13', 'Test Guardian', PH, '', 'PRG-ACAD', new Date(), 'Active', '', '']);
    const pkg = purchasePackage(PID, 'PRC-ACADR'), mem = purchasePackage(PID, 'PRC-MEMB'); // Academy = Pending
    const total = 7500 + membershipFee_();
    const p1 = recordPayment(PID, pkg, total, 'GCash', 'Pending');
    ok(pay(p1)[6] === 'Pending' && !!pay(p1)[8], 'Pending payment created with DueAt');

    // 1. underpaid submit
    let r = handleSubmitPayment_({ paymentId: p1, playerId: PID, contact: PH, reference: 'ZTESTREF0001', amount: 5000, method: 'GCash' });
    ok(r.success && pay(p1)[6] === 'Submitted', 'Underpaid submit → Submitted');
    ok((r.flags || []).indexOf('UNDERPAID') > -1, 'UNDERPAID flag set');

    // 2. partial verify
    let v = verifyPayment_(p1, 5000);
    ok(v.ok && v.state === 'Partial' && v.remaining === total - 5000, 'Partial verify → state Partial, remaining ₱' + (total - 5000));
    ok(pay(p1)[6] === 'Partial' && Number(pay(p1)[15]) === 5000, 'Status Partial, VerifiedAmount 5000 saved');
    ok(pkgSt(pkg) === 'Pending' && pkgSt(mem) === 'Pending', 'Packages still Pending after partial');
    ok(computeProgramState_(PID, 'PRG-ACAD').state === 'pending_payment', 'Program state = pending_payment');

    // 3. duplicate reference on another payment
    const p2 = recordPayment(PID, 'PENDING', 100, 'GCash', 'Pending');
    r = handleSubmitPayment_({ paymentId: p2, playerId: PID, contact: PH, reference: 'ZTESTREF0001', amount: 100, method: 'GCash' });
    ok(r.success && (r.flags || []).indexOf('DUP_REF:' + p1) > -1, 'Duplicate reference flagged against ' + p1);
    ok(cnt('ADMIN_DUP_REFERENCE') === 1, 'Admin duplicate-reference notification fired once');
    const sh = sheet_(SHEETS.PAYMENTS.name); sh.getRange(payFindRow_(p2).rowIndex, 7).setValue('Cancelled');
    r = handleSubmitPayment_({ paymentId: p2, playerId: PID, contact: PH, reference: 'ZTESTREF0009', amount: 100, method: 'GCash' });
    ok(!r.success, 'Cancelled payment cannot be submitted');

    // 4. follow-up payment for the remainder (from Partial)
    r = handleSubmitPayment_({ paymentId: p1, playerId: PID, contact: PH, reference: 'ZTESTREF0002', amount: total - 5000, method: 'GCash' });
    ok(r.success && pay(p1)[6] === 'Submitted', 'Partial → resubmit allowed');
    ok((r.flags || []).indexOf('UNDERPAID') < 0 && r.flags.indexOf('MISSING_PENALTY') < 0 && r.flags.indexOf('OVERPAID') < 0, 'No underpaid/overpaid flag when amount = remaining');

    // 5. full verify
    v = verifyPayment_(p1, '');
    ok(v.ok && v.state === 'Paid' && Number(pay(p1)[15]) === total, 'Final verify → Paid, cumulative VerifiedAmount = ₱' + total);
    ok(pkgSt(pkg) === 'Active' && pkgSt(mem) === 'Active', 'Package + membership activated');

    // 6. idempotency
    v = verifyPayment_(p1, '');
    ok(!v.ok, 'Second verify of a Paid payment is refused');
    r = handleSubmitPayment_({ paymentId: p1, playerId: PID, contact: PH, reference: 'ZTESTREF0003', amount: 100, method: 'GCash' });
    ok(!r.success, 'Paid payment cannot be resubmitted');

    // 7. reverse
    const rv = reversePayment_(p1, 'test reversal');
    ok(rv.ok && pay(p1)[6] === 'Reversed', 'Paid → Reversed');
    ok(pkgSt(pkg) === 'Reversed' && pkgSt(mem) === 'Reversed' && rv.membershipReversed, 'Package + membership reversed');
    ok(!playerHasMembership_(PID), 'Reversed membership no longer counts (will be charged again)');
    ok(computeProgramState_(PID, 'PRG-ACAD').state === 'reversed', 'Program state = reversed');
    ok(!reversePayment_(p1, 'again').ok, 'Second reversal refused');

    // 8. after reverse
    r = handleSubmitPayment_({ paymentId: p1, playerId: PID, contact: PH, reference: 'ZTESTREF0004', amount: total, method: 'GCash' });
    ok(!r.success, 'Reversed payment cannot be resubmitted');
    ok(!verifyPayment_(p1, '').ok, 'Reversed payment cannot be verified');

    // 9. reject path
    const p3 = recordPayment(PID, 'PENDING', 500, 'GCash', 'Pending');
    handleSubmitPayment_({ paymentId: p3, playerId: PID, contact: PH, reference: 'ZTESTREF0005', amount: 500, method: 'GCash' });
    ok(rejectPayment_(p3, 'Amount mismatch').ok && pay(p3)[6] === 'Rejected' && pay(p3)[14] === 'Amount mismatch', 'Submitted → Rejected with reason');
    ok(handleSubmitPayment_({ paymentId: p3, playerId: PID, contact: PH, reference: 'ZTESTREF0006', amount: 500, method: 'GCash' }).success, 'Rejected → resubmit allowed');

    // 10. notifications: tama ang uri at tamang bilang
    ['PAY_SUBMITTED', 'PAY_PARTIAL_SUBMITTED', 'ADMIN_PARTIAL_PAYMENT', 'PAY_PARTIAL_VERIFIED', 'PAY_VERIFIED', 'PAY_REVERSED', 'PAY_REJECTED'].forEach(function (k) { ok(cnt(k) >= 1, 'Notification fired: ' + k); });
    ok(cnt('PAY_VERIFIED') === 1, 'PAY_VERIFIED fired exactly once (no duplicate on re-verify)');
    ok(cnt('PAY_REVERSED') === 1, 'PAY_REVERSED fired exactly once');
  } catch (e) {
    R.push('ERROR  ' + e + (e && e.stack ? ' @ ' + String(e.stack).split('\n')[0] : ''));
  } finally {
    NOTIF_SUPPRESS_ = false;
    const purge = function (name, col) { const s = sheet_(name), d = s.getDataRange().getValues(); for (let i = d.length - 1; i >= 1; i--) if (d[i][col] === PID) s.deleteRow(i + 1); };
    ledgerSheet_(); purge(SHEETS.LEDGER.name, 3); purge(SHEETS.PACKAGES.name, 1); purge(SHEETS.PAYMENTS.name, 1); purge(SHEETS.PLAYERS.name, 0);
  }
  Logger.log(R.join('\n'));
  Logger.log(R.some(function (x) { return /^(FAIL|ERROR)/.test(x); }) ? '>>> MAY FAIL. Ayusin bago mag-live.' : '>>> LAHAT PASS (' + R.length + ' checks).');
}
/* === START: PAYMENT LEDGER — CORE + ADJUST / WAIVE / REFUND === */
const LEDGER_COL_ = { id: 0, ts: 1, pay: 2, player: 3, type: 4, amount: 5, before: 6, after: 7, reason: 8, by: 9, appr: 10, ref: 11 };

function ledgerSheet_() { return rsvpSheet_(SHEETS.LEDGER.name, SHEETS.LEDGER.headers); }
function ledgerRows_() { return ledgerSheet_().getDataRange().getValues().slice(1).filter(function (r) { return r[0]; }); }
function ledgerHas_(paymentId, type) { return ledgerRows_().some(function (r) { return r[2] === paymentId && r[4] === type; }); }
function ledgerHasRef_(ref, type) { return !!ref && ledgerRows_().some(function (r) { return String(r[11]) === ref && (!type || r[4] === type); }); }
function ledgerSum_(paymentId, type) { return ledgerRows_().reduce(function (n, r) { return (r[2] === paymentId && r[4] === type) ? n + (Number(r[5]) || 0) : n; }, 0); }

/** Self-declared lang ang override (web path). Sa menu, ang Google email ng admin ang ginagamit. */
var PAY_ACTOR_ = '';
function payActor_(override) {
  if (!override && PAY_ACTOR_) override = PAY_ACTOR_;
  const o = String(override || '').replace(/[^\w@ .:-]/g, '').slice(0, 60);
  if (o) return o;
  let e = ''; try { e = Session.getActiveUser().getEmail(); } catch (x) {}
  return e || 'unknown';
}
function payBalance_(row, now) { return Math.max(0, payTotalDue_(row, now || new Date()).total - (Number(row[15]) || 0)); }

/** Append-only. Hindi kailanman nag-e-edit o nagbubura ng lumang entry. Bumabalik ng EntryID, o '' kapag pumalya (naka-log sa AuditLog). */
function ledgerAdd_(e) {
  try {
    if (e.type === 'PENALTY' && ledgerHas_(e.paymentId, 'PENALTY')) return '';
    const sh = ledgerSheet_();
    const id = 'LED-' + Utilities.formatString('%06d', sh.getLastRow());
    sh.appendRow([id, e.ts || new Date(), e.paymentId, e.playerId, e.type, Number(e.amount) || 0, Number(e.before) || 0, Number(e.after) || 0,
      String(e.reason || '').slice(0, 300), e.by || payActor_(), e.approvedBy || '', e.ref ? String(e.ref) : '']);
    return id;
  } catch (err) {
    logAudit_('LEDGER_WRITE_FAILED', (e && e.type) + ' ' + (e && e.paymentId) + ' — ' + err, null);
    return '';
  }
}

function setupLedger_() {
  const sh = ledgerSheet_(), n = Math.max(1, sh.getMaxRows() - 1);
  sh.setFrozenRows(1);
  sh.getRange(2, 2, n, 1).setNumberFormat('yyyy-mm-dd hh:mm:ss');
  sh.getRange(2, 6, n, 3).setNumberFormat('#,##0.00');
  sh.getRange(2, 12, n, 1).setNumberFormat('@');
  sh.getProtections(SpreadsheetApp.ProtectionType.SHEET).forEach(function (p) { p.remove(); });
  sh.protect().setDescription('Append-only ledger. Do not edit rows.').setWarningOnly(true);
  ensureConfigKey_('AdjustApprovalOver', 1000);   // adjustment na lampas dito = kailangan ng ibang approver (0 = patay)
  ensureConfigKey_('AllowSelfApproval', 'false'); // true = puwedeng i-approve ng nag-request ang sarili niyang refund
  SpreadsheetApp.getUi().alert('Ledger ready.\n\nAppend-only (warning protection). Config: AdjustApprovalOver = ₱1,000, AllowSelfApproval = false.\n\nSusunod: run ledgerBackfill_ sa editor para sa mga lumang payment.');
}

/** Run isang beses sa editor: opening entries para sa mga payment na wala pang ledger. Idempotent. */
function ledgerBackfill_() {
  const have = {}; ledgerRows_().forEach(function (r) { have[r[2]] = 1; });
  const d = sheet_(SHEETS.PAYMENTS.name).getDataRange().getValues();
  let n = 0;
  for (let i = 1; i < d.length; i++) {
    const r = d[i]; if (!r[0] || have[r[0]]) continue;
    const base = Number(r[3]) || 0, ver = Number(r[15]) || (r[6] === 'Paid' ? base : 0), ts = r[5] ? new Date(r[5]) : new Date();
    ledgerAdd_({ type: 'CHARGE', paymentId: r[0], playerId: r[1], amount: base, before: 0, after: base, reason: 'Opening entry (backfill)', by: 'backfill', ts: ts });
    if (ver > 0) ledgerAdd_({ type: 'PAYMENT_VERIFIED', paymentId: r[0], playerId: r[1], amount: ver, before: base, after: Math.max(0, base - ver), reason: 'Opening entry (backfill, status ' + r[6] + ')', by: 'backfill', ts: ts });
    n++;
  }
  Logger.log('Backfilled ' + n + ' payment(s).');
}

/** Waiver (penalty lang, hindi hihigit sa penalty) o signed correction. Laging may reason; lampas sa limit = ibang approver. */
function adjustPaymentTotal_(paymentId, op, amount, reason, actor, approver, ref) {
  reason = String(reason || '').trim();
  if (reason.length < 5) return { ok: false, error: 'A reason (at least 5 characters) is required.' };
  if (ref && ledgerHasRef_(ref)) return { ok: true, duplicate: true };
  const f = payFindRow_(paymentId);
  if (!f) return { ok: false, error: 'PaymentID not found: ' + paymentId };
  const st = String(f.row[6]);
  if (['Pending', 'Overdue', 'Submitted', 'Partial', 'Rejected'].indexOf(st) < 0) return { ok: false, error: 'Payment is ' + st + '. Only unpaid payments can be adjusted. Use Reverse/Refund for paid ones.' };
  let delta = Number(amount);
  if (!isFinite(delta) || delta === 0) return { ok: false, error: 'Enter a non-zero amount.' };
  const now = new Date(), before = payTotalDue_(f.row, now), verified = Number(f.row[15]) || 0;
  if (op === 'waive') {
    delta = -Math.abs(delta);
    const cap = Math.max(0, before.penalty + ledgerSum_(paymentId, 'WAIVER')); // WAIVER entries ay negative
    if (Math.abs(delta) > cap) return { ok: false, error: 'Waiver cannot exceed the current unwaived penalty (₱' + cap + ').' };
  }
  const newTotal = before.total + delta;
  if (newTotal <= 0) return { ok: false, error: 'This would bring the total to ₱0 or below. Cancel or reverse the payment instead.' };
  if (newTotal < verified) return { ok: false, error: 'New total (₱' + newTotal + ') is below the ₱' + verified + ' already verified. Use a refund for the difference.' };
  const cfg = getConfigValue_('AdjustApprovalOver'), limit = (cfg === null || cfg === '' || isNaN(Number(cfg))) ? 1000 : Number(cfg);
  approver = String(approver || '').replace(/[^\w@ .:-]/g, '').trim().slice(0, 60);
  if (limit > 0 && Math.abs(delta) > limit) {
    if (!approver) return { ok: false, error: 'Adjustments over ₱' + limit + ' need an approver.' };
    if (approver.toLowerCase().replace(/^staff:/, '') === String(actor).toLowerCase().replace(/^staff:/, '')) return { ok: false, error: 'The approver must be a different person from the requester.' };
  }
  const balBefore = Math.max(0, before.total - verified), balAfter = Math.max(0, newTotal - verified);
  f.sheet.getRange(f.rowIndex, 17).setValue((Number(f.row[16]) || 0) + delta);
  const led = ledgerAdd_({ type: op === 'waive' ? 'WAIVER' : 'ADJUSTMENT', paymentId: paymentId, playerId: f.row[1], amount: delta, before: balBefore, after: balAfter, reason: reason, by: actor, approvedBy: approver, ref: ref });
  logAudit_('PAYMENT_' + (op === 'waive' ? 'WAIVER' : 'ADJUSTED'), paymentId + ' ' + delta + ' · bal ₱' + balBefore + ' → ₱' + balAfter + ' · ' + reason + ' · by ' + actor + (approver ? ' · approved ' + approver : ''), actor);
  let state = st;
  if (st === 'Partial' && balAfter === 0 && verified > 0) { // ang waiver/correction ang nagkumpleto ng bayad
    f.sheet.getRange(f.rowIndex, 7).setValue('Paid'); state = 'Paid';
    activatePackagesForPayment_(f.row[1], f.row[2]);
  }
  try {
    const pr = findRowById_(SHEETS.PLAYERS.name, f.row[1]);
    sendNotification_('BALANCE_UPDATED', { id: f.row[1], email: pr ? pr[6] : '' }, { playerName: pr ? pr[1] : f.row[1], amount: balAfter });
  } catch (e) {}
  return { ok: true, state: state, delta: delta, balanceBefore: balBefore, balanceAfter: balAfter, ledgerId: led || 'FAILED' };
}

function refundRequest_(paymentId, amount, reason, actor, ref) {
  reason = String(reason || '').trim();
  if (reason.length < 5) return { ok: false, error: 'A reason (at least 5 characters) is required.' };
  if (ref && ledgerHasRef_(ref)) return { ok: true, duplicate: true };
  const f = payFindRow_(paymentId);
  if (!f) return { ok: false, error: 'PaymentID not found: ' + paymentId };
  if (['Paid', 'Partial', 'Reversed'].indexOf(String(f.row[6])) < 0) return { ok: false, error: 'Nothing was collected on this payment (status ' + f.row[6] + ').' };
  const amt = Number(amount);
  if (!(amt > 0)) return { ok: false, error: 'Enter the refund amount.' };
  const collected = Number(f.row[15]) || 0, done = ledgerSum_(paymentId, 'REFUND_COMPLETED'), open = ledgerSum_(paymentId, 'REFUND_REQUESTED') - done;
  const room = collected - done - Math.max(0, open);
  if (amt > room) return { ok: false, error: 'Refund exceeds what is refundable (₱' + Math.max(0, room) + ' = collected ₱' + collected + ' − refunded ₱' + done + ' − pending ₱' + Math.max(0, open) + ').' };
  const bal = payBalance_(f.row);
  const led = ledgerAdd_({ type: 'REFUND_REQUESTED', paymentId: paymentId, playerId: f.row[1], amount: amt, before: bal, after: bal, reason: reason, by: actor, ref: ref });
  const pr = findRowById_(SHEETS.PLAYERS.name, f.row[1]);
  sendNotification_('ADMIN_REFUND_REQUESTED', { email: getConfigValue_('AdminEmail') }, { playerName: pr ? pr[1] : f.row[1], amount: amt, reason: reason });
  logAudit_('REFUND_REQUESTED', paymentId + ' ₱' + amt + ' — ' + reason, actor);
  return { ok: true, requested: amt, ledgerId: led || 'FAILED' };
}

function refundComplete_(paymentId, amount, reason, actor, ref) {
  reason = String(reason || '').trim();
  if (reason.length < 5) return { ok: false, error: 'A reason / transfer reference (at least 5 characters) is required.' };
  if (ref && ledgerHasRef_(ref)) return { ok: true, duplicate: true };
  const f = payFindRow_(paymentId);
  if (!f) return { ok: false, error: 'PaymentID not found: ' + paymentId };
  const reqs = ledgerRows_().filter(function (r) { return r[2] === paymentId && r[4] === 'REFUND_REQUESTED'; });
  const pending = ledgerSum_(paymentId, 'REFUND_REQUESTED') - ledgerSum_(paymentId, 'REFUND_COMPLETED');
  if (!reqs.length || pending <= 0) return { ok: false, error: 'No pending refund request for this payment.' };
  const amt = (amount === undefined || amount === null || amount === '' || Number(amount) === 0) ? pending : Number(amount);
  if (!(amt > 0) || amt > pending) return { ok: false, error: 'Amount must be between ₱1 and the pending ₱' + pending + '.' };
  const requester = String(reqs[reqs.length - 1][9]);
  if (String(actor).toLowerCase() === requester.toLowerCase() && String(getConfigValue_('AllowSelfApproval')).toLowerCase() !== 'true')
    return { ok: false, error: 'A different person must complete this refund (requested by ' + requester + ').' };
  const bal = payBalance_(f.row);
  const led = ledgerAdd_({ type: 'REFUND_COMPLETED', paymentId: paymentId, playerId: f.row[1], amount: amt, before: bal, after: bal, reason: reason, by: requester, approvedBy: actor, ref: ref });
  const pr = findRowById_(SHEETS.PLAYERS.name, f.row[1]);
  sendNotification_('ADMIN_REFUND_COMPLETED', { email: getConfigValue_('AdminEmail') }, { playerName: pr ? pr[1] : f.row[1], amount: amt });
  logAudit_('REFUND_COMPLETED', paymentId + ' ₱' + amt + ' — ' + reason + ' · requested by ' + requester, actor);
  return { ok: true, refunded: amt, stillPending: pending - amt, netCollected: (Number(f.row[15]) || 0) - ledgerSum_(paymentId, 'REFUND_COMPLETED'), ledgerId: led || 'FAILED' };
}

/** Per-payment na buod: base, penalty, adjustments, verified, refunded, balance. */
function payLedgerSummary_(paymentId) {
  const f = payFindRow_(paymentId);
  if (!f) return null;
  const d = payTotalDue_(f.row, new Date()), ver = Number(f.row[15]) || 0;
  const done = ledgerSum_(paymentId, 'REFUND_COMPLETED'), req = ledgerSum_(paymentId, 'REFUND_REQUESTED');
  const pr = findRowById_(SHEETS.PLAYERS.name, f.row[1]);
  return { paymentId: paymentId, playerId: f.row[1], player: pr ? pr[1] : '', status: String(f.row[6]), base: d.base, penalty: d.penalty, adjustments: Number(f.row[16]) || 0,
    total: d.total, verified: ver, refunded: done, refundPending: Math.max(0, req - done), netCollected: ver - done, balance: Math.max(0, d.total - ver) };
}

