  const out = [], counts = {};
  for (let i = 1; i < data.length; i++) {
    const r = data[i]; if (!r[0]) continue;
    let st = String(r[6]);
    if (st === 'Pending' && now >= paymentDueAt_(r, rule)) st = 'Overdue';
    counts[st] = (counts[st] || 0) + 1;
    if (want !== 'All' && st !== want) continue;
    const d = payTotalDue_(r, now), ver = Number(r[15]) || 0, pr = pl[r[1]] || [];
    const fm = /flags=([^|]*)/.exec(String(r[12] || ''));
