/** Run sa editor. Per payment: tuloy-tuloy ba ang before/after, at tugma ba ang huling balance sa kasalukuyang computed. */
function ledgerChainIssues_(rows, row) {
  const bad = [];
  for (let i = 1; i < rows.length; i++) {
    const gap = Number(rows[i][6]) - Number(rows[i - 1][7]);
    if (gap !== 0) bad.push('GAP ₱' + gap + ' between ' + rows[i - 1][0] + ' and ' + rows[i][0] + ' (unrecorded change, e.g. live penalty)');
  }
  if (row && rows.length) {
    const st = String(row[6]), unpaid = ['Pending', 'Overdue', 'Submitted', 'Partial', 'Rejected'].indexOf(st) > -1;
    if (st === 'Paid' && Number(rows[rows.length - 1][7]) !== 0) bad.push('Paid but last ledger balance is ₱' + rows[rows.length - 1][7]);
    if (unpaid && st !== 'Overdue' && Number(rows[rows.length - 1][7]) !== payBalance_(row)) bad.push('Last ledger balance ₱' + rows[rows.length - 1][7] + ' ≠ current ₱' + payBalance_(row));
  }
  return bad;
}
function ledgerVerify_() {
  const by = {}, bad = [], pay = {};
  ledgerRows_().forEach(function (r) { (by[r[2]] = by[r[2]] || []).push(r); });
  sheet_(SHEETS.PAYMENTS.name).getDataRange().getValues().slice(1).forEach(function (r) { if (r[0]) pay[r[0]] = r; });
  Object.keys(pay).forEach(function (id) { if (!by[id]) bad.push(id + ': NO LEDGER ENTRIES (run ledgerBackfill_)'); });
  Object.keys(by).forEach(function (id) {
    if (!pay[id]) { bad.push(id + ': ORPHAN ledger entries'); return; }
    ledgerChainIssues_(by[id], pay[id]).forEach(function (m) { bad.push(id + ': ' + m); });
  });
  Logger.log(bad.length ? 'ISSUES (' + bad.length + '):\n' + bad.join('\n') : 'LEDGER OK · ' + Object.keys(by).length + ' payments');
  try { SpreadsheetApp.getUi().alert(bad.length ? bad.length + ' issue(s). See Execution log.\n\n' + bad.slice(0, 8).join('\n') : 'Ledger OK.'); } catch (e) {}
}
