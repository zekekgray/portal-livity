function deductPackageSessionOld_(playerId, programId) {
  const sheet = sheet_(SHEETS.PACKAGES.name);
  const data = sheet.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (data[i][1] !== playerId || data[i][7] !== 'Active' || Number(data[i][5]) >= Number(data[i][4])) continue;
    if (data[i][6] && new Date() > new Date(data[i][6])) continue;
    const pr = findRowById_(SHEETS.PRICING.name, data[i][2]);
    if (programId && (!pr || pr[1] !== programId)) continue; // Academy scan never eats Private sessions

    const newUsed = Number(data[i][5]) + 1;
    sheet.getRange(i + 1, 6).setValue(newUsed);
    if (!data[i][6]) {
      const days = pr ? Number(pr[6]) : 0;
      if (days > 0) sheet.getRange(i + 1, 7).setValue(new Date(Date.now() + days * 86400000));
    }
    if (newUsed >= Number(data[i][4])) sheet.getRange(i + 1, 8).setValue('Completed');
    logAudit_('SESSION_DEDUCTED', data[i][0] + ' — ' + playerId + ' ' + (programId || '') + ': ' + (Number(data[i][4]) - Number(data[i][5])) + ' → ' + (Number(data[i][4]) - newUsed) + ' left', null);
    return data[i][0];
  }
  return false;
}
