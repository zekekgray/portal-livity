  const items = CFG_DEFS_.map(function (c) {
    known[c.k] = 1;
    const raw = has[c.k] ? cur[c.k] : null, s = (raw == null || raw === '') ? '' : String(raw), sec = c.t === 'secret';
    return { k: c.k, g: c.g, l: c.l, h: c.h || '', t: c.t, def: c.d || '', secret: sec, set: s !== '',
      value: sec ? '' : s, weak: c.k === 'StaffKey' && (s === '' || /^0*$/.test(s)), stamp: consoleCfgStamp_(raw) };
  });
  const other = Object.keys(cur).filter(function (k) { return !known[k]; }).map(function (k) {
    return { k: k, value: /KEY|PASS|SECRET|TOKEN/i.test(k) ? '(hidden)' : String(cur[k]).slice(0, 80) };
  });
