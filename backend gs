function renderSection_(title, rows) {
  if (!rows || rows.length === 0) {
    return `<div class="section"><h3>${title}</h3><div class="empty">No data yet.</div></div>`;
  }
  const headers = Object.keys(rows[0]);
  const thead = headers.map(h => `<th>${h}</th>`).join('');
  const tbody = rows.map(r =>
    '<tr>' + headers.map(h => `<td>${escapeHtml_(r[h])}</td>`).join('') + '</tr>'
  ).join('');
  return `
    <div class="section">
      <h3>${title} <span class="count">(${rows.length})</span></h3>
      <table><thead><tr>${thead}</tr></thead><tbody>${tbody}</tbody></table>
    </div>
  `;
}

function sheetToObjects_(sheetName, forceHeaders) {
  const sheet = sheet_(sheetName);
  if (!sheet) return [];
  const data = sheet.getDataRange().getValues();
  if (data.length < 2) return [];
  const headers = forceHeaders || data[0];
  return data.slice(1).map(row => {
    const obj = {};
    headers.forEach((h, i) => { obj[h] = row[i]; });
    return obj;
  });
}

function escapeHtml_(val) {
  if (val === null || val === undefined) return '';
  return String(val)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}
