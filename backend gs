/** Pinakabagong N rows lang ng isang sheet (hindi binabasa ang buong history). */
function consoleTail_(name, cols, n) {
  const sh = sheet_(name);
  if (!sh) return [];
  const last = sh.getLastRow();
  if (last < 2) return [];
  const start = Math.max(2, last - n + 1);
