function consoleRefAction_(p, who) {
  const op = String(p.op || ''), reason = String(p.reason || '').trim(), force = String(p.force) === '1';
  if (['approve', 'reject', 'apply'].indexOf(op) < 0) throw new Error('Unknown operation.');
  const sh = consoleRefCols_(), d = sh.getDataRange().getValues();
  let i = -1;
  for (let k = 1; k < d.length; k++) if (d[k][0] === String(p.referralId || '')) { i = k; break; }
  if (i < 0) throw new Error('Referral not found.');
  const r = d[i], id = r[0], cur = String(r[5] || 'Pending');
  if (String(p.stamp || '') !== cur) throw new Error('CHANGED: This referral was updated since you opened it. Refresh and review again.');
