  return String(v == null ? '' : v);
}
/** Active players enrolled in programId: Players.ProgramID match OR Active, unexpired package na may natitirang sessions sa program na yon. */
function getProgramRosterRows_(programId) {
  const now = new Date();
  const pricing = sheet_(SHEETS.PRICING.name).getDataRange().getValues();
  const programOfPrice = {};
  for (let i = 1; i < pricing.length; i++) programOfPrice[pricing[i][0]] = pricing[i][1];

  const players = sheet_(SHEETS.PLAYERS.name).getDataRange().getValues();
  const byId = {}, out = [], seen = {};
  for (let i = 1; i < players.length; i++) {
    const r = players[i];
    if (String(r[9] || 'Active').trim().toLowerCase() !== 'active') continue;
    byId[r[0]] = r;
    if (r[7] === programId) { seen[r[0]] = true; out.push(r); }
  }

  const pkgs = sheet_(SHEETS.PACKAGES.name).getDataRange().getValues();
  for (let i = 1; i < pkgs.length; i++) {
    const r = pkgs[i];
    if (r[7] !== 'Active' || r[2] === 'PRC-MEMB') continue;
    if (programOfPrice[r[2]] !== programId) continue;
    if (r[6] && now > new Date(r[6])) continue;
    if (Number(r[5]) >= Number(r[4])) continue;
    const p = byId[r[1]];
    if (!p || seen[p[0]]) continue;
    seen[p[0]] = true;
    out.push(p);
  }
  return out;
}

/** Sino ang inaasahan sa isang session. Private = booked lang (Registered rows sa Attendance); ibang program = package-based roster. */
function getSessionRecipients_(scheduleId, programId, date) {
  if (programId !== 'PRG-PRIV') return getProgramRosterRows_(programId);

  const tz = Session.getScriptTimeZone();
  const dateKey = Utilities.formatDate(date, tz, 'yyyy-MM-dd');
  const players = sheet_(SHEETS.PLAYERS.name).getDataRange().getValues();
  const byId = {};
  for (let i = 1; i < players.length; i++) {
    if (String(players[i][9] || 'Active').trim().toLowerCase() === 'active') byId[players[i][0]] = players[i];
  }
  const att = sheet_(SHEETS.ATTENDANCE.name).getDataRange().getValues();
  const out = [], seen = {};
  for (let i = 1; i < att.length; i++) {
    const r = att[i];
    if (r[2] !== scheduleId || !r[3] || r[4] !== 'Registered') continue;
    if (Utilities.formatDate(new Date(r[3]), tz, 'yyyy-MM-dd') !== dateKey) continue;
    const p = byId[r[1]];
    if (p && !seen[p[0]]) { seen[p[0]] = true; out.push(p); }
  }
  return out;
}

