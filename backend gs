function consoleCfgSet_(p, who) {
  const k = String(p.key || ''), reason = String(p.reason || '').trim();
  const def = CFG_DEFS_.filter(function (c) { return c.k === k; })[0];
  if (!def) throw new Error("This key can't be edited here.");
  if (reason.length < 5) throw new Error('A reason (at least 5 characters) is required.');
  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  let v = String(p.value == null ? '' : p.value).trim(), store = v;

  if (def.t === 'int' || def.t === 'num') {
    const n = Number(v);
    if (v === '' || !isFinite(n)) throw new Error(def.l + ' must be a number.');
    if (def.t === 'int' && Math.floor(n) !== n) throw new Error(def.l + ' must be a whole number.');
    if (def.min != null && n < def.min) throw new Error(def.l + ' must be at least ' + def.min + '.');
    if (def.max != null && n > def.max) throw new Error(def.l + ' must be at most ' + def.max + '.');
    store = n;
  } else if (def.t === 'bool') {
    v = v.toLowerCase();
    if (v !== 'true' && v !== 'false') throw new Error('Choose true or false.');
    store = v;
  } else if (def.t === 'email') {
    if (!emailRe.test(v)) throw new Error('Enter a valid email address.');
  } else if (def.t === 'emails') {
    const list = v.split(',').map(function (x) { return x.trim(); }).filter(String);
    if (list.some(function (x) { return !emailRe.test(x); })) throw new Error('One of the emails is invalid.');
    if (list.length) {
      if (who.indexOf('@') < 0) throw new Error('Your Google email is not visible to the script, so this would lock everyone out of the console.');
      if (list.map(function (x) { return x.toLowerCase(); }).indexOf(who.toLowerCase()) < 0) throw new Error('Include your own email (' + who + '), or you will lock yourself out of the console.');
    }
    store = list.join(',');
  } else if (def.t === 'progs') {
    const list = v.split(',').map(function (x) { return x.trim(); }).filter(String);
    const valid = consoleRows_(SHEETS.PROGRAMS.name).map(function (r) { return r[0]; });
    if (!list.length) throw new Error('Enter at least one program code.');
    const bad = list.filter(function (x) { return valid.indexOf(x) < 0; });
    if (bad.length) throw new Error('Unknown program code: ' + bad.join(', '));
    if (list.indexOf('PRG-PRIV') > -1) throw new Error('Private is booked per session. It cannot be auto-registered.');
    store = list.join(',');
  } else if (def.t === 'secret') {
    if (v === '' && def.blank) store = '';
    else if (v.length < 6) throw new Error('Use at least 6 characters.');
    else if (k === 'StaffKey' && /^0*$/.test(v)) throw new Error('Choose something other than the default.');
  } else if (v.length > 120) throw new Error('Too long (max 120 characters).');

  const sh = sheet_(SHEETS.CONFIG.name), d = sh.getDataRange().getValues();
  let row = 0, oldRaw = '';
  for (let i = 1; i < d.length; i++) if (d[i][0] === k) { row = i + 1; oldRaw = d[i][1]; break; }
  if (String(p.stamp || '') !== consoleCfgStamp_(row ? oldRaw : null)) throw new Error('CHANGED: This setting was updated since you opened it. Refresh and try again.');
  if (!row) { sh.appendRow([k, '']); row = sh.getLastRow(); }
  const cell = sh.getRange(row, 2);
  if (typeof store === 'number') cell.setValue(store); else cell.setNumberFormat('@').setValue(store);

  const sec = def.t === 'secret';
  logAudit_('CONFIG_CHANGED', k + ' · ' + (sec ? '(secret changed)' : String(oldRaw == null ? '' : oldRaw) + ' → ' + String(store)) + ' · ' + reason, who);
  rvFlush_();
  if (k === 'StaffKey') { try { CacheService.getScriptCache().remove('sk_fail'); } catch (e) {} }
  return { msg: def.l + ' updated' + (k === 'StaffKey' ? '. Staff must sign in again.' : '') };
}
