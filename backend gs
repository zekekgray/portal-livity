/* ---------- EXPIRY / FOLLOW-UP ALERTS ---------- */
/** dry=true: ililista lang kung ano ang ipapadala (walang send, walang marker). Isang beses lang kada key. */
function runExpiryAlerts_(dry) {
  const tz = Session.getScriptTimeZone(), now = new Date(), seen = alertLoad_();
  const warnDays = cfgNum_('ExpiryWarnDays', 5), lookback = cfgNum_('ExpiredLookbackDays', 14);
  const memMonths = cfgNum_('MembershipRenewalMonths', 12), cap = cfgNum_('AlertMaxPerRun', 60);
  const pm = consolePlayerMap_(), price = {}, prog = {}, sch = {};
  consoleRows_(SHEETS.PRICING.name).forEach(function (r) { price[r[0]] = r; });
  consoleRows_(SHEETS.PROGRAMS.name).forEach(function (r) { prog[r[0]] = r[1]; });
  consoleRows_(SHEETS.SCHEDULE.name).forEach(function (r) { sch[r[0]] = r; });
  const adminMail = String(getConfigValue_('AdminEmail') || '').trim();
  const active = function (pl) { return !!pl && String(pl[9] || 'Active').trim().toLowerCase() === 'active'; };
  const counts = { soon: 0, admin: 0, expired: 0, member: 0, noshow: 0 }, list = [];
  let sent = 0;

  const fire = function (type, key, label, fn) {
    if (seen[key]) return;
    if (dry) { list.push({ type: type, label: label }); counts[type]++; return; }
    if (sent >= cap) return; // proteksyon sa email quota; ang matitira ay mapapadala bukas
    try { fn(); } catch (e) { logAudit_('SYS_GAS_ERROR', 'Alert ' + key + ' failed: ' + e, null); return; }
    alertMark_(key); seen[key] = 1; sent++; counts[type]++;
  };

  /* 1) Packages: expiring soon / expired (may natitirang sessions lang) */
  consoleRows_(SHEETS.PACKAGES.name).forEach(function (r) {
    if (String(r[7]) !== 'Active' || r[2] === 'PRC-MEMB' || !r[6]) return;
    const total = Number(r[4]) || 0, left = total - (Number(r[5]) || 0);
    if (total <= 0 || left <= 0) return;
    const exp = new Date(r[6]); if (isNaN(exp.getTime())) return;
    const pl = pm[r[1]]; if (!active(pl)) return;
    const days = (exp.getTime() - now.getTime()) / 86400000;
    const expLabel = Utilities.formatDate(exp, tz, 'MMM d, yyyy'), expKey = Utilities.formatDate(exp, tz, 'yyyy-MM-dd');
    const pn = prog[(price[r[2]] || [])[1]] || '', rcpt = { id: r[1], email: String(pl[6] || '') };
    const data = { playerName: pl[1], expiryDate: expLabel, programName: pn, remaining: left };
    const lab = pl[1] + ' · ' + pn + ' · ' + r[0] + ' · ' + left + ' left · exp ' + expLabel;
    if (days >= 0 && days <= warnDays) {
      fire('soon', 'EXP|' + r[0] + '|' + expKey, lab, function () { sendNotification_('PACKAGE_EXPIRING_SOON', rcpt, data); });
      fire('admin', 'ADMEXP|' + r[0] + '|' + expKey, lab, function () { sendNotification_('ADMIN_PACKAGE_NEAR_EXPIRY', { email: adminMail }, data); });
    } else if (days < 0 && days >= -lookback) {
      fire('expired', 'EXPD|' + r[0] + '|' + expKey, lab, function () { sendNotification_('PACKAGE_EXPIRED', rcpt, data); });
    }
  });

  /* 2) Membership renewal (MembershipRenewalMonths; 0 = off) */
  if (memMonths > 0) consoleRows_(SHEETS.PACKAGES.name).forEach(function (r) {
    if (r[2] !== 'PRC-MEMB' || String(r[7]) !== 'Active' || !r[3]) return;
    const pl = pm[r[1]]; if (!active(pl)) return;
    const due = new Date(r[3]); if (isNaN(due.getTime())) return;
    due.setMonth(due.getMonth() + memMonths);
    const days = (due.getTime() - now.getTime()) / 86400000;
    if (days > 14 || days < -60) return;
    fire('member', 'MEMB|' + r[0] + '|' + Utilities.formatDate(due, tz, 'yyyy-MM'), pl[1] + ' · membership renewal due ' + Utilities.formatDate(due, tz, 'MMM d, yyyy'),
      function () { sendNotification_('MEMBERSHIP_RENEWAL_REMINDER', { id: r[1], email: String(pl[6] || '') }, { playerName: pl[1] }); });
  });

  /* 3) No-show follow-up: Registered → Absent, kahapon hanggang 3 araw na nakaraan */
  const today = Utilities.formatDate(now, tz, 'yyyy-MM-dd'), from = Utilities.formatDate(new Date(now.getTime() - 3 * 86400000), tz, 'yyyy-MM-dd');
  consoleRows_(SHEETS.ATTENDANCE.name).forEach(function (r) {
    if (!r[3] || String(r[4]) !== 'Registered' || String(r[5]) !== 'Absent') return;
    const d = consoleD_(r[3]); if (d >= today || d < from) return;
    const pl = pm[r[1]]; if (!active(pl)) return;
    const s = sch[r[2]] || [], pn = prog[s[1]] || s[1] || '';
    const when = Utilities.formatDate(new Date(r[3]), tz, 'EEE, MMM d');
    fire('noshow', 'NOSHOW|' + r[0], pl[1] + ' · ' + pn + ' · ' + when,
      function () { sendNotification_('ATT_NOSHOW_FOLLOWUP', { id: r[1], email: String(pl[6] || '') }, { playerName: pl[1], programName: pn, sessionDate: when }); });
  });

  if (!dry) logAudit_('EXPIRY_ALERTS_RUN', JSON.stringify(counts) + ' · sent ' + sent + (sent >= cap ? ' (cap reached)' : ''), null);
  return { counts: counts, items: list.slice(0, 60), more: Math.max(0, list.length - 60), sent: sent, dry: !!dry, capped: !dry && sent >= cap };
}

