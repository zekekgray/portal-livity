/** Record a payment against a package. method e.g. 'Cash','GCash','Bank Transfer'. */
function recordPayment(playerId, packageId, amount, method, status) {
  const id = nextId_('PAY', SHEETS.PAYMENTS.name);
  sheet_(SHEETS.PAYMENTS.name).appendRow([
    id, playerId, packageId, amount, method, new Date(), status || 'Paid', Session.getActiveUser().getEmail(),
    /* === START: PAYMENT SYSTEM EDIT — DUEAT === */
    (status === 'Pending' ? new Date(Date.now() + (Number(getConfigValue_('PaymentDeadlineHours')) || 12) * 3600000) : ''), '', '', '', '', '', '', ((status || 'Paid') === 'Paid' ? amount : '')
    /* === END: PAYMENT SYSTEM EDIT — DUEAT === */
  ]);
  logAudit_('RECORD_PAYMENT', id + ' — ' + amount + ' via ' + method, null);
  ledgerAdd_({ type: 'CHARGE', paymentId: id, playerId: playerId, amount: Number(amount), before: 0, after: Number(amount), reason: 'Payment record created (' + (status || 'Paid') + ')', by: 'system' });
  if ((status || 'Paid') === 'Paid') ledgerAdd_({ type: 'PAYMENT_VERIFIED', paymentId: id, playerId: playerId, amount: Number(amount), before: Number(amount), after: 0, reason: 'Recorded as paid directly (' + method + ')' });
  if ((status || 'Paid') === 'Paid') activatePackagesForPayment_(playerId, packageId);

  if (status === 'Pending') {
    try {
      const playerRow = findRowById_(SHEETS.PLAYERS.name, playerId);
      sendNotification_('PAY_INSTRUCTIONS', { id: playerId, email: playerRow ? playerRow[6] : '' }, { playerName: playerRow ? playerRow[1] : playerId, instructions: 'Open My Player → Payments to see how to pay.' });
    } catch (e) { logAudit_('PAYMENT_NOTIFY_FAILED', id + ' — instructions — ' + e, null); }
  }

  return id;
}
