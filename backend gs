function consoleExcAction_(p, who) {
  const op = String(p.op || ''), reason = String(p.reason || '').trim();
  const sh = sheet_(SHEETS.ATTENDANCE.name), d = sh.getDataRange().getValues();

  if (op === 'excuseSession') {
    if (reason.length < 5) throw new Error('A reason (at least 5 characters) is required.');
    const sid = String(p.scheduleId || ''), dt = String(p.date || ''); let n = 0;
    for (let k = 1; k < d.length; k++) {
      if (d[k][2] === sid && d[k][3] && consoleD_(d[k][3]) === dt && d[k][5] === 'Unmarked') { sh.getRange(k + 1, 6).setValue('Excused'); n++; }
    }
    if (!n) throw new Error('No Unmarked players found for that session.');
    logAudit_('ATT_EXCUSED_SESSION', sid + ' ' + dt + ' — ' + n + ' excused · ' + reason, who);
    return { msg: n + ' player(s) excused' };
  }
  if (['deduct', 'waive', 'present', 'late', 'absent', 'excuse'].indexOf(op) < 0) throw new Error('Unknown operation.');

  let i = -1;
  for (let k = 1; k < d.length; k++) if (d[k][0] === String(p.attendanceId || '')) { i = k; break; }
  if (i < 0) throw new Error('Attendance record not found.');
  const r = d[i], pid = r[1], sid = r[2], st = String(r[5]), when = r[3] ? new Date(r[3]) : new Date();
  if (String(p.stamp || '') !== st + '|' + String(r[7])) throw new Error('CHANGED: This record was updated since you opened it. Refresh and review again.');
  const sched = findRowById_(SHEETS.SCHEDULE.name, sid), programId = sched ? sched[1] : '';

  if (op === 'deduct') {
    if ((st !== 'Present' && st !== 'Late') || consoleTrue_(r[8])) throw new Error('Only a non-walk-in Present/Late check-in can be deducted.');
    const got = deductPackageSession_(pid, programId, r[6] ? new Date(r[6]) : when);
    if (!got) throw new Error('No active package with sessions left for this program. Check the payment status first, then try again.');
    sh.getRange(i + 1, 8).setValue(true);
    logAudit_('ATT_DEDUCT_MANUAL', r[0] + ' — ' + pid + ' deducted from ' + got + (reason ? ' · ' + reason : ''), who);
    return { msg: 'session deducted from ' + got };
  }
  if (op === 'waive') {
    if (reason.length < 5) throw new Error('A reason (at least 5 characters) is required.');
    if ((st !== 'Present' && st !== 'Late') || consoleTrue_(r[8])) throw new Error('Only a non-walk-in Present/Late check-in can be waived.');
    sh.getRange(i + 1, 8).setValue('Waived');
    logAudit_('ATT_DEDUCT_WAIVED', r[0] + ' — ' + pid + ' · ' + reason, who);
    return { msg: 'deduction waived' };
  }
  if (op === 'present' || op === 'late') {
    if (st === 'Present' || st === 'Late') throw new Error('Already checked in.');
    if (st === 'Absent' && reason.length < 5) throw new Error('A reason (at least 5 characters) is required to correct an Absent record.');
    const status = op === 'present' ? 'Present' : 'Late';
    NOTIF_SUPPRESS_ = true; // manual correction: no guardian notifications
    try { checkIn(pid, sid, when, status, when); } finally { NOTIF_SUPPRESS_ = false; }
    const e = findAttendanceRow_(pid, sid, when), deducted = !!(e && e.sessionDeducted);
    logAudit_('ATT_MANUAL_' + status.toUpperCase(), r[0] + ' — ' + pid + ' ' + st + ' → ' + status + (deducted ? ' (deducted)' : ' (NOT deducted)') + (reason ? ' · ' + reason : ''), who);
    return { msg: status + (deducted ? ' · session deducted' : ' · no package to deduct (now in No deduction)') };
  }
  if (op === 'absent') {
    if (st !== 'Unmarked') throw new Error('Only Unmarked records can be marked Absent.');
    markAbsent_(pid, sid, when);
    return { msg: 'Absent · guardian notified' };
  }
  if (op === 'excuse') {
    if (reason.length < 5) throw new Error('A reason (at least 5 characters) is required.');
    if (st !== 'Unmarked' && st !== 'Absent') throw new Error('Only Unmarked or Absent records can be excused.');
    sh.getRange(i + 1, 6).setValue('Excused');
    logAudit_('ATT_EXCUSED', r[0] + ' — ' + pid + ' ' + st + ' → Excused · ' + reason, who);
    return { msg: 'Excused' };
  }
}

