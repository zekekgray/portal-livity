/* === START: PACKAGE STATE — EXHAUSTED VS EXPIRED VS PENDING PAYMENT === */
function getPackageLatestPaymentStatus_(packageId) {
  const payData = sheet_(SHEETS.PAYMENTS.name).getDataRange().getValues();
  let latestStatus = null, latestDate = null;
  for (let i = 1; i < payData.length; i++) {
    const row = payData[i];
    if (row[2] !== String(packageId).replace(/P$/, '')) continue;
    const d = new Date(row[5]);
    if (!latestDate || d > latestDate) { latestDate = d; latestStatus = row[6]; }
  }
  return latestStatus;
}

/** Looks at the player's most recent package for a program and returns the real reason
 *  behind their session count: 'active' | 'exhausted' | 'expired' | 'pending_payment' | 'none'. */
function computeProgramState_(playerId, programId) {
  const pkgData = sheet_(SHEETS.PACKAGES.name).getDataRange().getValues();
  const candidates = [];
  for (let i = 1; i < pkgData.length; i++) {
    const row = pkgData[i];
    if (row[1] !== playerId || row[2] === 'PRC-MEMB') continue;
    const priceRow = findRowById_(SHEETS.PRICING.name, row[2]);
    if (!priceRow || priceRow[1] !== programId) continue;
    candidates.push({
      status: row[7],
      packageId: row[0], purchaseDate: new Date(row[3]),
      sessionsTotal: Number(row[4]), sessionsUsed: Number(row[5]),
      expiryDate: row[6] ? new Date(row[6]) : null
    });
  }
  if (candidates.length === 0) return { state:'none', remaining:0, total:0, expiryDate:null };

  candidates.sort(function (a, b) { return b.purchaseDate - a.purchaseDate; });
  const latest = candidates[0];
  const nowD_ = new Date();
  const usable = candidates.filter(function (c) {
    return c.status === 'Active' && !(c.expiryDate && nowD_ > c.expiryDate) && c.sessionsTotal > c.sessionsUsed;
  });
  const remaining = usable.reduce(function (n, c) { return n + (c.sessionsTotal - c.sessionsUsed); }, 0);
  const totalSum = usable.length ? usable.reduce(function (n, c) { return n + c.sessionsTotal; }, 0) : latest.sessionsTotal;
  const expiries = usable.filter(function (c) { return c.expiryDate; }).map(function (c) { return c.expiryDate; }).sort(function (a, b) { return a - b; });
  const shownExpiry = usable.length ? (expiries[0] || null) : latest.expiryDate;
  const paymentStatus = getPackageLatestPaymentStatus_(latest.packageId);
  const isExpired = !usable.length && latest.expiryDate && nowD_ > latest.expiryDate;

  let state;
  if (paymentStatus === 'Pending' || paymentStatus === 'Overdue' || paymentStatus === 'Submitted' || paymentStatus === 'Partial') state = 'pending_payment';
  else if (paymentStatus === 'Reversed' && !usable.length) state = 'reversed';
  else if (isExpired) state = 'expired';
  else if (remaining <= 0) state = 'exhausted';
  else state = 'active';

  return { state: state, remaining: remaining, total: totalSum, expiryDate: shownExpiry ? shownExpiry.toISOString() : null };
}
