function consoleEnrAction_(p, who) {
  const op = String(p.op || ''), reason = String(p.reason || '').trim();
  if (['approve', 'correct', 'decline', 'reopen'].indexOf(op) < 0) throw new Error('Unknown operation.');
  const sh = consolePlayerReviewCols_(), d = sh.getDataRange().getValues();
  let i = -1;
  for (let k = 1; k < d.length; k++) if (d[k][0] === String(p.playerId || '')) { i = k; break; }
  if (i < 0) throw new Error('Player not found.');
  const r = d[i], cur = String(r[12] || ''), status = String(r[9] || 'Active');
  if (String(p.stamp || '') !== cur + '|' + status) throw new Error('CHANGED: This record was updated since you opened it. Refresh and review again.');
  if (!cur) throw new Error('This is a legacy record with no review. Manage it in Players.');

  let next = '', newStatus = status, evt = '', data = {};
  if (op === 'approve') {
    if (!consoleReviewOpen_(cur)) throw new Error('Only New or Needs-correction enrollments can be approved.');
    next = 'Approved'; evt = 'ENROLL_APPROVED';
  } else if (op === 'correct') {
    if (!consoleReviewOpen_(cur)) throw new Error('Only open enrollments can be sent back for correction.');
    if (reason.length < 5) throw new Error('Describe what needs correcting (at least 5 characters).');
    next = 'NeedsCorrection'; evt = 'ENROLL_NEEDS_CORRECTION'; data.details = reason;
  } else if (op === 'decline') {
    if (!consoleReviewOpen_(cur)) throw new Error('Approved players are managed in Players (Set Inactive).');
    if (reason.length < 5) throw new Error('A reason (at least 5 characters) is required.');
    next = 'Declined'; newStatus = 'Inactive'; evt = 'ENROLL_DECLINED'; data.reason = reason;
  } else {
    if (cur !== 'Declined') throw new Error('Only declined enrollments can be reopened.');
    if (reason.length < 5) throw new Error('A reason (at least 5 characters) is required.');
    next = 'New'; newStatus = 'Active';
  }

  sh.getRange(i + 1, 13, 1, 4).setValues([[next, op === 'approve' ? '' : reason, who, new Date()]]);
  if (newStatus !== status) sh.getRange(i + 1, 10).setValue(newStatus);
  logAudit_('ENROLL_' + op.toUpperCase(), r[0] + ' · ' + (cur || '—') + ' → ' + next + (reason ? ' · ' + reason : ''), who);
  rvFlush_();

  let notified = false;
  if (evt) {
    try {
      data.playerName = r[1]; data.programName = lbProgramLabelServer_(r[7]);
      sendNotification_(evt, { id: r[0], email: String(r[6] || '') }, data);
      notified = true;
    } catch (e) { logAudit_('NOTIF_UNKNOWN_TYPE', 'Enrollment notice failed for ' + r[0] + ': ' + e, who); }
  }
  return { msg: r[1] + ' → ' + next + (notified ? ' · guardian notified' : '') };
}

