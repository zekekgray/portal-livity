/** Escalates payments stuck in 'Submitted' (proof sent, not yet verified) — fires once per threshold, not every hour. */
function checkSubmittedPaymentSla_() {
  const data = sheet_(SHEETS.PAYMENTS.name).getDataRange().getValues();
  const now = new Date();
  const waitHours = Number(getConfigValue_('PaymentWaitingHours')) || 6;
  const slaHours = Number(getConfigValue_('PaymentSlaHours')) || 24;

  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    if (row[6] !== 'Submitted' || !row[11]) continue; // needs SubmittedAt
    const hoursWaiting = (now - new Date(row[11])) / 3600000;
    const paymentId = row[0];

    if (hoursWaiting >= slaHours && !hasAuditMarker_('PAYMENT_SLA_NOTIFIED', paymentId)) {
      sendNotification_('ADMIN_PAY_SLA_BREACH', { email: getConfigValue_('AdminEmail') }, { paymentId: paymentId, hours: slaHours });
      logAudit_('PAYMENT_SLA_NOTIFIED', paymentId + ' — breached ' + slaHours + 'h SLA', null);
    } else if (hoursWaiting >= waitHours && !hasAuditMarker_('PAYMENT_WAITING_NOTIFIED', paymentId)) {
      sendNotification_('ADMIN_PAY_WAITING', { email: getConfigValue_('AdminEmail') }, { paymentId: paymentId, hours: waitHours });
      logAudit_('PAYMENT_WAITING_NOTIFIED', paymentId + ' — waiting ' + waitHours + 'h', null);
    }
  }
}

