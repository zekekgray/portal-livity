const AUDIT_NOISE_RE_ = /^(LADDER_|SCANRID_|PAYACT_)/;

function consoleAuditSev_(a) {
  if (/FAILED|ERROR|CONFLICT|SKIPPED/.test(a)) return 'bad';
  if (/OVERRIDE|WAIVE|REVERSED|REJECTED|DEDUCT_MANUAL|ADJUSTED|REFUND|CONFIG_CHANGED|STAFF_KEY|DATA_RESET|ATT_EXCUSED|MARKED_ABSENT/.test(a)) return 'warn';
  return '';
}

function consoleAudit_(p) {
  const rows = consoleTail_(SHEETS.AUDITLOG.name, 4, 3000);
  const q = String(p.q || '').trim().toUpperCase(), act = String(p.action || ''), hide = String(p.hide) === '1';
  const seen = {}, items = [];
  let matched = 0;
  for (let i = rows.length - 1; i >= 0; i--) {
    const r = rows[i], a = String(r[1] || '');
    if (!a || (hide && AUDIT_NOISE_RE_.test(a))) continue;
    seen[a] = 1;
    if (act && a !== act) continue;
    if (q && [a, r[2], r[3]].join(' ').toUpperCase().indexOf(q) < 0) continue;
    matched++;
    if (items.length < 150) items.push({ ts: consoleTsOf_(r[0]), action: a, details: String(r[2] || '').slice(0, 400), user: String(r[3] || ''), sev: consoleAuditSev_(a) });
  }
  return { items: items, matched: matched, scanned: rows.length, actions: Object.keys(seen).sort() };
}

