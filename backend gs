function handleTgLinkCode_(body) {
  const pid = String(body.playerId || '').trim();
  const a = authPlayerRow_(pid, body.contact);
  if (a.error) return { success: false, error: a.error };
  const code = String(Math.floor(100000 + Math.random() * 900000));
