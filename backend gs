/** Global na data: lahat ng RSVP, bilang, eligible, coaches. Naka-cache ng 20s. */
function rvGlobal_() {
  const cache = CacheService.getScriptCache();
  const hit = cache.get('rv_global');
  if (hit) { try { return JSON.parse(hit); } catch (e) {} }
  const today = Utilities.formatDate(new Date(), 'Asia/Manila', 'yyyy-MM-dd');
  const names = playerNameMap_();
  const rsvps = [], counts = {}, rosterSet = {};
  RSVP_PROGRAMS_.forEach(function (pid) { rosterSet[pid] = {}; getAutoRegisterRosterIds_(pid).forEach(function (id) { rosterSet[pid][id] = 1; }); });
  rvSheet_().getDataRange().getValues().slice(1).forEach(function (r) {
    if (!r[0]) return;
    const d = rvD_(r[2]);
    if (d < today) return;
    const st = rvT_(r[3]);
    rsvps.push({ playerId: r[0], programId: r[1], sessionDate: d, startTime: st, status: r[4] });
    const k = r[1] + '|' + d + '|' + st; // tugma sa rsvpKey_ ng client
    const c = counts[k] || (counts[k] = { yes: 0, no: 0, ry: 0, rn: 0, names: [] });
    if (r[4] === 'yes') { c.yes++; if (RSVP_NAMES_PUBLIC_) c.names.push(rvShortName_(names[r[0]])); }
    else if (r[4] === 'no') c.no++;
    if ((rosterSet[r[1]] || {})[r[0]]) { if (r[4] === 'yes') c.ry++; else if (r[4] === 'no') c.rn++; }
  });
  const eligible = {};
  RSVP_PROGRAMS_.forEach(function (pid) { eligible[pid] = Object.keys(rosterSet[pid]).length; });
  const coaches = {};
  scSheet_().getDataRange().getValues().slice(1).forEach(function (r) { if (r[2]) coaches[r[0]] = r[2]; });
  const ab = availByKey_(), avail = {};
  Object.keys(ab).forEach(function (k) { avail[k] = ab[k].map(function (c) { return c.name; }); });
  const out = { rsvps: rsvps, counts: counts, eligible: eligible, coaches: coaches, avail: avail, defaults: getAutoRegisterPrograms_() };
  try { cache.put('rv_global', JSON.stringify(out), 20); } catch (e) {}
  return out;
}

/** GET ?action=weekRsvp[&playerIds=A,B] — walang playerIds = poll lang (counts), global */
function apiWeekRsvp_(q) {
  const ids = String(q.playerIds || q.playerId || '').split(',').map(function (s) { return s.trim(); }).filter(String).slice(0, 10)
    .filter(function (id) { return !authPlayerRow_(id, q.contact).error; }); // walang tamang contact = walang ibabalik na personal RSVP
  const g = rvGlobal_();
  const counts = {};
  Object.keys(g.counts).forEach(function (k) {
    const c = g.counts[k];
    counts[k] = { yes: c.yes, no: c.no, ry: c.ry, rn: c.rn, names: ids.length ? c.names : [] }; // walang valid na contact = walang pangalan
  });
  return {
    success: true,
    rsvps: ids.length ? g.rsvps.filter(function (x) { return ids.indexOf(x.playerId) > -1; }) : [],
    counts: counts, eligible: g.eligible, coaches: g.coaches, avail: g.avail, defaults: g.defaults
  };
}

/** POST adminRoster {key, sessions:[{key,programId,sessionDate,startTime}]} */
function apiAdminRoster_(p) {
  if (!adminOk_(p.key)) throw new Error('Admin key required.');
  if (!staffOk_(p.key)) throw new Error('Wrong or missing staff key.');
  const rows = rvSheet_().getDataRange().getValues().slice(1);
  const names = playerNameMap_();
  const coachBy = {};
  scSheet_().getDataRange().getValues().slice(1).forEach(function (r) { coachBy[r[0]] = r[1]; });
  const coaches = coachesList_();
  const avail_ = availByKey_(); // minsan lang, hindi kada session
  const sessions = (p.sessions || []).slice(0, 40).map(function (s) {
    const going = [], notGoing = [], seen = {};
    rows.forEach(function (r) {
      if (r[1] !== s.programId || rvD_(r[2]) !== s.sessionDate || rvT_(r[3]) !== s.startTime) return;
      seen[r[0]] = 1;
      (r[4] === 'yes' ? going : notGoing).push({ playerId: r[0], name: names[r[0]] || r[0], source: r[6] });
    });
    const noReply = eligiblePlayers_(s.programId).filter(function (x) { return !seen[x.playerId]; });
    return { key: s.key, going: going, notGoing: notGoing, noReply: noReply, coachId: coachBy[s.key] || '', available: (availByKey_()[s.key] || []) };
  });
  return { success: true, sessions: sessions, coaches: coaches };
}

