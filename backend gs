  });
}

/** Poll window = today → +6 araw (Manila). Labas dito = reject. */
function rvWindowCheck_(date) {
  const today = Utilities.formatDate(new Date(), 'Asia/Manila', 'yyyy-MM-dd');
  const last = Utilities.formatDate(new Date(Date.now() + 6 * 86400000), 'Asia/Manila', 'yyyy-MM-dd');
  if (date < today || date > last) throw new Error('This session is outside the current poll window.');
}

/** sessionKey = PRG-xxx|yyyy-MM-dd|HH:mm. Dapat totoong session sa loob ng window. */
function rvKeyCheck_(key) {
  const m = /^(PRG-[A-Z]+)\|(\d{4}-\d{2}-\d{2})\|(\d{2}:\d{2})$/.exec(String(key || ''));
  if (!m || RSVP_PROGRAMS_.indexOf(m[1]) < 0) throw new Error('Invalid session.');
  rvWindowCheck_(m[2]);
  if (!rvSessionExists_(m[1], m[2], m[3])) throw new Error('No such session.');
}

/** Upsert: parehong player+session = isang row lang, kaya safe ang retry. status '' = burahin. */
function apiSetRsvp_(p, isAdmin) {
  if (isAdmin && !adminOk_(p.key)) throw new Error('Admin key required.');
  const status = String(p.status || '');
  if (['yes', 'no', ''].indexOf(status) < 0) throw new Error('Invalid status.');
  if (!p.playerId || !p.programId || !p.sessionDate || !p.startTime) throw new Error('Missing fields.');
  if (!/^\d{4}-\d{2}-\d{2}$/.test(p.sessionDate) || !/^\d{2}:\d{2}$/.test(p.startTime)) throw new Error('Invalid date or time.');
  if (RSVP_PROGRAMS_.indexOf(p.programId) < 0) throw new Error('This program does not use RSVP.');
  rvWindowCheck_(p.sessionDate);
  if (!isAdmin && Date.now() > rvStartMs_(p.sessionDate, p.startTime) - RSVP_CUTOFF_MS)
    throw new Error('Reservations are closed for this session.');
  if (!isAdmin && String(getConfigValue_('RsvpEnabled')) === 'false') throw new Error('Reservations are closed right now. Please message Admin JA.');
  const prow_ = findRowById_(SHEETS.PLAYERS.name, p.playerId);
  if (!prow_) throw new Error('Player not found.');
  if (status && String(prow_[9] || 'Active').trim().toLowerCase() !== 'active') throw new Error('Player is not active.');
  if (!rvSessionExists_(p.programId, p.sessionDate, p.startTime)) throw new Error('No such session.');
  if (status && rvSessionCancelled_(p.programId, p.sessionDate, p.startTime)) throw new Error('This session is cancelled.');
  if (status && !isAdmin && !eligiblePlayers_(p.programId).some(function (x) { return x.playerId === p.playerId; }))
    throw new Error('No active package for this program.');

  const lock = { releaseLock: function () {} }; // doPost na ang may hawak ng script lock
  try {
    const sh = rvSheet_(), v = sh.getDataRange().getValues();
    let row = -1;
    for (let i = 1; i < v.length; i++) {
      if (v[i][0] === p.playerId && v[i][1] === p.programId && rvD_(v[i][2]) === p.sessionDate && rvT_(v[i][3]) === p.startTime) { row = i + 1; break; }
    }
    if (row > 0 && p.requestId && /^RV/.test(String(p.requestId)) && /^RV/.test(String(v[row - 1][7] || ''))) {
      const prevId = String(v[row - 1][7]), newId = String(p.requestId);
      if (prevId === newId) return { success: true, duplicate: true }; // parehong request, hindi na uulitin
      // mas lumang request na nahuli lang sa daan (loob ng 30s). Mas mahaba ang window = panganib sa clock skew ng ibang device.
      const age = Date.now() - new Date(v[row - 1][5]).getTime();
      // removed: ang script lock na ang nag-o-order (arrival order wins). Ang clock ng client ay hindi dapat magpasya.
    }
    const prevSt_ = row > 0 ? String(v[row - 1][4] || '') : '';
    const sessKey_ = [p.programId, p.sessionDate, p.startTime].join('|');
    const who_ = isAdmin ? rvBy_(p) : 'guardian:' + p.playerId;
    if (!status) {
      if (row > 0) sh.deleteRow(row);
      rvFlush_();
      if (prevSt_) logAudit_('RSVP_CLEARED', p.playerId + ' ' + sessKey_ + ' — ' + prevSt_ + ' → none', who_);
      return { success: true, previous: prevSt_ };
    }
    const rid_ = String(p.requestId || '').replace(/[^\w-]/g, '').slice(0, 40); // iwas formula injection (=IMPORTXML…)
    const src_ = isAdmin ? (String(p.source || 'admin').replace(/[^\w-]/g, '').slice(0, 20) || 'admin') : 'app';
    const rec = [p.playerId, p.programId, p.sessionDate, p.startTime, status, new Date(), src_, rid_];
    if (row > 0) sh.getRange(row, 1, 1, rec.length).setValues([rec]); else sh.appendRow(rec);
    rvFlush_();
    logAudit_('RSVP_SET', p.playerId + ' ' + sessKey_ + ' — ' + (prevSt_ || 'none') + ' → ' + status + ' (' + src_ + ')', who_);
    return { success: true, previous: prevSt_ };
    if (row > 0) sh.getRange(row, 1, 1, rec.length).setValues([rec]); else sh.appendRow(rec);
    rvFlush_();
    return { success: true };
  } finally { lock.releaseLock(); }
}

/** Public poll: "Miguel S." lang, hindi buong pangalan, at hindi kailanman Player ID. */
function rvShortName_(full) {
  const p = String(full || '').trim().split(/\s+/).filter(String);
  if (!p.length) return 'Player';
  return p.length > 1 ? p[0] + ' ' + p[p.length - 1].charAt(0) + '.' : p[0];
