/** Returns full conversation history for a given contactKey (WhatsApp number), oldest first. */
function getMessages_(contactKey) {
  if (!contactKey) return { success: false, error: 'Missing contact.' };

  const data = sheet_(SHEETS.MESSAGES.name).getDataRange().getValues();
  const messages = [];
  for (let i = 1; i < data.length; i++) {
    const row = data[i];
