/**
 * Register a player for a session BEFORE it happens — this is the "Registered" state,
 * created by your enrollment/registration flow. Creates the Attendance row with
 * AttendanceStatus='Unmarked' so QR scan-time only ever UPDATES a row, never guesses
 * whether someone was registered after the fact.
 */
function registerForSession(playerId, scheduleId, dateStr) {
  const date = dateStr ? new Date(dateStr) : new Date();
  const existing = findAttendanceRow_(playerId, scheduleId, date);
  if (existing) return existing.attendanceId; // idempotent — don't double-register

  const id = nextId_('ATT', SHEETS.ATTENDANCE.name);
  sheet_(SHEETS.ATTENDANCE.name).appendRow([
    id, playerId, scheduleId, date, 'Registered', 'Unmarked', '', false, false
  ]);
  logAudit_('SESSION_REGISTERED', id + ' — ' + playerId, null);
  return id;
}

/**
 * Called at scan/check-in time (QR or manual). Looks up whether a Registered row already
 * exists for this player+session+date — if not, this is a genuine walk-in and a new row
 * is created with RegistrationStatus='Walkin'. attendanceStatus: 'Present' | 'Late'.
 * Absences are marked separately by markAbsent_ (below), since absence has no scan event.
 */
function checkIn(playerId, scheduleId, dateStr, attendanceStatus, checkInTime) {
  const date = dateStr ? new Date(dateStr) : new Date();
  const time = checkInTime || new Date();
  let surcharge = false;

  const existing = findAttendanceRow_(playerId, scheduleId, date);
  const sheet = sheet_(SHEETS.ATTENDANCE.name);

  let attendanceId, registrationStatus, isWalkIn;

  if (existing) {
    // Pre-registered player is now scanning in — flip AttendanceStatus only, keep Registered.
    attendanceId = existing.attendanceId;
    registrationStatus = existing.registrationStatus;
    isWalkIn = existing.isWalkIn;
    sheet.getRange(existing.rowIndex, 6).setValue(attendanceStatus); // AttendanceStatus
    sheet.getRange(existing.rowIndex, 7).setValue(time);             // CheckInTime
  } else {
    // No registration on file — genuine walk-in.
    registrationStatus = 'Walkin';
    isWalkIn = true;
    const monthCount = countWalkInsThisMonth_(playerId, date) + 1;
    surcharge = monthCount > getConfigValue_('WalkInFreePerMonth');
    const wId = nextId_('WI', SHEETS.WALKINS.name);
    sheet_(SHEETS.WALKINS.name).appendRow([wId, playerId, date, monthCount, surcharge]);

    attendanceId = nextId_('ATT', SHEETS.ATTENDANCE.name);
    sheet.appendRow([attendanceId, playerId, scheduleId, date, 'Walkin', attendanceStatus, time, false, true]);
  }

  let sessionDeducted = false;
  if (attendanceStatus === 'Present' || attendanceStatus === 'Late') {
    const schedForDeduct_ = findRowById_(SHEETS.SCHEDULE.name, scheduleId);
sessionDeducted = isWalkIn ? false : ((existing && existing.sessionDeducted) ? existing.deductedRaw : deductPackageSession_(playerId, schedForDeduct_ ? schedForDeduct_[1] : '', time));
    // walk-in deduction already handled via the WalkIns surcharge row above, not a package session
    setAttendanceDeducted_(attendanceId, isWalkIn ? false : sessionDeducted);
  }

  logAudit_('CHECK_IN', attendanceId + ' — ' + playerId + ' (' + registrationStatus + ' / ' + attendanceStatus + ')', null);

  /* === START: ATTENDANCE NOTIFICATIONS — CHECK-IN STATE TRANSITIONS === */
  try {
    const playerRow = findRowById_(SHEETS.PLAYERS.name, playerId);
    const schedRow = findRowById_(SHEETS.SCHEDULE.name, scheduleId);
    const progRow = schedRow ? findRowById_(SHEETS.PROGRAMS.name, schedRow[1]) : null;
    const programName = progRow ? progRow[1] : (schedRow ? schedRow[1] : '');
    const playerName = playerRow ? playerRow[1] : playerId;
    const guardianEmail = playerRow ? playerRow[6] : '';
    const tz = Session.getScriptTimeZone();
    const timeLabel = Utilities.formatDate(time, tz, 'h:mm a');

    if (attendanceStatus === 'Late') {
      sendNotification_('ATT_LATE', { id: playerId, email: guardianEmail }, { playerName: playerName, programName: programName, minutesLate: '' });
    } else if (attendanceStatus === 'Present') {
      sendNotification_('ATT_CHECKED_IN', { id: playerId, email: guardianEmail }, { playerName: playerName, programName: programName, time: timeLabel });
    }

    if (!isWalkIn && sessionDeducted) {
      const remaining = playerHasRemainingSessions_(playerId, schedRow ? schedRow[1] : '') ? getPlayerActivePackages_(playerId)
        .filter(function (p) { return p.programId === (schedRow ? schedRow[1] : ''); })
        .reduce(function (sum, p) { return sum + Math.max(0, p.remaining); }, 0) : 0;
      sendNotification_('ATT_SESSION_DEDUCTED', { id: playerId, email: guardianEmail }, { playerName: playerName, programName: programName, remaining: remaining });
      if (remaining > 0 && remaining <= 2) {
        sendNotification_('ATT_LOW_SESSIONS', { id: playerId, email: guardianEmail }, { playerName: playerName, programName: programName, remaining: remaining });
      }
    }

    if ((attendanceStatus === 'Present' || attendanceStatus === 'Late') && !isWalkIn && !sessionDeducted) {
      sendNotification_('ADMIN_DEDUCTION_CONFLICT', { email: getConfigValue_('AdminEmail') }, { playerName: playerName, programName: programName });
      logAudit_('ADMIN_DEDUCTION_CONFLICT', attendanceId + ' — ' + playerId + ' had no active package to deduct', null);
    }

    if (isWalkIn) {
      const surchargeNote = surcharge ? ' (1.5× surcharge applied)' : '';
      sendNotification_('ADMIN_WALKIN', { email: getConfigValue_('AdminEmail') }, { playerName: playerName, programName: programName, surchargeNote: surchargeNote });
    }
  } catch (notifyErr) {
    logAudit_('SYS_GAS_ERROR', 'Attendance notification failed for ' + attendanceId + ': ' + notifyErr, null);
  }
  /* === END: ATTENDANCE NOTIFICATIONS === */

  return { attendanceId: attendanceId, registrationStatus: registrationStatus, attendanceStatus: attendanceStatus, walkInSurcharge: surcharge };
}

/** Marks a REGISTERED player as Absent — used by end-of-session sweep, not scan-time. */
function markAbsent_(playerId, scheduleId, dateStr) {
  const date = dateStr ? new Date(dateStr) : new Date();
  const existing = findAttendanceRow_(playerId, scheduleId, date);
  if (!existing) return null; // can't be absent from something you weren't registered for
  sheet_(SHEETS.ATTENDANCE.name).getRange(existing.rowIndex, 6).setValue('Absent');
  logAudit_('MARKED_ABSENT', existing.attendanceId + ' — ' + playerId, null);

  try {
    const playerRow = findRowById_(SHEETS.PLAYERS.name, playerId);
    const schedRow = findRowById_(SHEETS.SCHEDULE.name, scheduleId);
    const progRow = schedRow ? findRowById_(SHEETS.PROGRAMS.name, schedRow[1]) : null;
    const programName = progRow ? progRow[1] : (schedRow ? schedRow[1] : '');
    const playerName = playerRow ? playerRow[1] : playerId;
