    methods: methods,
    penaltyRule: getPenaltyRule_(),
    gcash: g ? { number: g.accountNumber, accountName: g.accountName } : { number: '', accountName: '' },
    bank: b ? { name: b.name, accountNumber: b.accountNumber, accountName: b.accountName } : { name: '', accountNumber: '', accountName: '' }
  };
}

