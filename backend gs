function payStamp_(r) { return String(r[6]) + '|' + (r[11] ? new Date(r[11]).getTime() : '') + '|' + (Number(r[15]) || 0); }

function apiAdminPayQueue_(p) {
  if (!adminOk_(p.key)) throw new Error('Admin key required.');
