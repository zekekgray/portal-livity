/** receivedAmount = perang natanggap NGAYON (blank = buong natitira). Cumulative ang VerifiedAmount. */
function verifyPayment_(paymentId, receivedAmount) {
  const f = payFindRow_(paymentId);
  if (!f) return { ok: false, error: 'PaymentID not found: ' + paymentId };
  const row = f.row, st = String(row[6]);
  if (['Pending', 'Overdue', 'Submitted', 'Partial', 'Rejected'].indexOf(st) < 0) return { ok: false, error: 'Payment is ' + st + '. It cannot be verified.' };
  const playerId = row[1], due = payTotalDue_(row, new Date());
  const already = Number(row[PAY_COL_VERIFIED_ - 1]) || 0;
  const remainingBefore = Math.max(0, due.total - already);
  const blank = receivedAmount === undefined || receivedAmount === null || String(receivedAmount).trim() === '';
  const recv = blank ? remainingBefore : Number(receivedAmount);
  if (!(recv > 0)) return { ok: false, error: 'Invalid amount.' };
  const verified = already + recv;
  const playerRow = findRowById_(SHEETS.PLAYERS.name, playerId);
  const rcpt = { id: playerId, email: playerRow ? playerRow[6] : '' };
  const playerName = playerRow ? playerRow[1] : playerId;

  f.sheet.getRange(f.rowIndex, PAY_COL_VERIFIED_).setValue(verified);
  ledgerAdd_({ type: 'PAYMENT_VERIFIED', paymentId: paymentId, playerId: playerId, amount: recv, before: remainingBefore, after: Math.max(0, due.total - verified), reason: (blank ? 'Full remaining received' : 'Amount received') + (verified < due.total ? ' (partial)' : ''), ref: String(row[9] || '') });
  if (verified < due.total) {
    const remaining = due.total - verified;
    f.sheet.getRange(f.rowIndex, 7).setValue('Partial');
    sendNotification_('PAY_PARTIAL_VERIFIED', rcpt, { amount: recv, playerName: playerName, remaining: remaining });
    logAudit_('PAYMENT_PARTIAL_VERIFIED', paymentId + ' — ' + playerName + ' +₱' + recv + ' → ₱' + verified + ' of ₱' + due.total + ' (remaining ₱' + remaining + ')', null);
    return { ok: true, state: 'Partial', verified: verified, remaining: remaining, total: due.total };
  }
  f.sheet.getRange(f.rowIndex, 7).setValue('Paid');
  activatePackagesForPayment_(playerId, row[2]);
  sendNotification_('PAY_VERIFIED', rcpt, { amount: verified, playerName: playerName });
  const over = verified - due.total;
  logAudit_('PAYMENT_VERIFIED', paymentId + ' — ' + playerName + ' ₱' + verified + ' of ₱' + due.total + (over > 0 ? ' OVERPAID by ₱' + over + ' (no credit recorded)' : ''), null);
  return { ok: true, state: 'Paid', verified: verified, remaining: 0, total: due.total, overpaid: Math.max(0, over) };
}

function rejectPayment_(paymentId, reason) {
  const f = payFindRow_(paymentId);
  if (!f) return { ok: false, error: 'PaymentID not found: ' + paymentId };
  const st = String(f.row[6]);
  if (['Submitted', 'Partial'].indexOf(st) < 0) return { ok: false, error: 'Only Submitted or Partial payments can be rejected (status: ' + st + ').' };
  if (!String(reason || '').trim()) return { ok: false, error: 'A reason is required.' };
  f.sheet.getRange(f.rowIndex, 7).setValue('Rejected');
  f.sheet.getRange(f.rowIndex, PAY_COL_NOTE_).setValue(String(reason).slice(0, 200));
  ledgerAdd_({ type: 'REJECTED', paymentId: paymentId, playerId: f.row[1], amount: Number(f.row[10]) || 0, before: payBalance_(f.row, new Date()), after: payBalance_(f.row, new Date()), reason: reason, ref: String(f.row[9] || '') });
  const playerRow = findRowById_(SHEETS.PLAYERS.name, f.row[1]);
  sendNotification_('PAY_REJECTED', { id: f.row[1], email: playerRow ? playerRow[6] : '' }, { amount: Number(f.row[10]) || Number(f.row[3]), reason: reason });
  logAudit_('PAYMENT_REJECTED', paymentId + ' — ' + reason, null);
  return { ok: true, state: 'Rejected' };
}

function reversePayment_(paymentId, reason) {
  const f = payFindRow_(paymentId);
  if (!f) return { ok: false, error: 'PaymentID not found: ' + paymentId };
  const row = f.row, st = String(row[6]);
  if (['Paid', 'Partial'].indexOf(st) < 0) return { ok: false, error: 'Only Paid or Partial payments can be reversed (status: ' + st + ').' };
  f.sheet.getRange(f.rowIndex, 7).setValue('Reversed');
  f.sheet.getRange(f.rowIndex, PAY_COL_NOTE_).setValue(String(reason || '').slice(0, 200));
  ledgerAdd_({ type: 'REVERSAL', paymentId: paymentId, playerId: row[1], amount: -(Number(row[PAY_COL_VERIFIED_ - 1]) || Number(row[3])), before: payBalance_(row, new Date()), after: payTotalDue_(row, new Date()).total, reason: reason });

  let pkgs = 0, used = 0, membership = false;
  if (st === 'Paid' && row[2] && row[2] !== 'PENDING') {
    const pk = sheet_(SHEETS.PACKAGES.name), d = pk.getDataRange().getValues();
    const baseId = String(row[2]).replace(/P$/, '');
    let academy = false, mainPrice = 0;
    for (let i = 1; i < d.length; i++) {
      if (d[i][0] !== baseId && d[i][0] !== baseId + 'P') continue;
      if (d[i][7] !== 'Active' && d[i][7] !== 'Completed') continue;
      used += Number(d[i][5]) || 0;
      pk.getRange(i + 1, 8).setValue('Reversed'); pkgs++;
      const pr = findRowById_(SHEETS.PRICING.name, d[i][2]);
      if (pr && pr[1] === 'PRG-ACAD') academy = true;
      if (d[i][0] === baseId && pr) mainPrice = Number(pr[5]);
    }
    // membership binabawi lang kung kasama sa bayad na ito (amount >= presyo ng package + membership fee)
    if (academy && Number(row[3]) >= mainPrice + membershipFee_()) {
      for (let i = 1; i < d.length; i++) {
        if (d[i][1] === row[1] && d[i][2] === 'PRC-MEMB' && d[i][7] === 'Active') { pk.getRange(i + 1, 8).setValue('Reversed'); membership = true; break; }
      }
    }
  }
  const playerRow = findRowById_(SHEETS.PLAYERS.name, row[1]);
  sendNotification_('PAY_REVERSED', { id: row[1], email: playerRow ? playerRow[6] : '' }, { amount: Number(row[PAY_COL_VERIFIED_ - 1]) || Number(row[3]), playerName: playerRow ? playerRow[1] : row[1], reason: reason });
  logAudit_('PAYMENT_REVERSED', paymentId + ' — ' + reason + ' · packages reversed ' + pkgs + ' · sessions already used ' + used + ' (NOT restored) · membership reversed ' + membership, null);
  return { ok: true, state: 'Reversed', packagesReversed: pkgs, usedSessions: used, membershipReversed: membership };
}

function verifyPaymentPrompt_() {
  const ui = SpreadsheetApp.getUi();
