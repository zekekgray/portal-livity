function scSheet_() { return rsvpSheet_('SessionCoach', ['sessionKey','coachId','coachName']); }
function rvStartMs_(date, start) { return new Date(date + 'T' + start + ':00+08:00').getTime(); } // Manila
function rvD_(v) { return v instanceof Date ? Utilities.formatDate(v, getTargetSs_().getSpreadsheetTimeZone(), 'yyyy-MM-dd') : String(v).slice(0, 10); }
function rvT_(v) { return fmtTime_(v); }
function rvFlush_() { try { CacheService.getScriptCache().remove('rv_global'); } catch (e) {} }

function playerNameMap_() {
