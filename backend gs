/** Config → AdminKey. Kung blangko pa, babalik sa StaffKey (backward compatible). */
function adminOk_(key) {
  if (CONSOLE_TRUST_) return true; // Admin Console only (set server-side in consoleTrust_)
  const ak = String(getConfigValue_('AdminKey') || '').trim();
  return ak ? String(key == null ? '' : key).trim() === ak : staffOk_(key);
}

/** Cancelled ba ang weekly slot na ito? (Schedule column H = Status) */
function rvSessionCancelled_(programId, date, start) {
  const day = Utilities.formatDate(new Date(date + 'T12:00:00+08:00'), 'Asia/Manila', 'EEEE');
  return sheet_(SHEETS.SCHEDULE.name).getDataRange().getValues().slice(1).some(function (r) {
