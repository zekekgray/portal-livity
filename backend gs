function qrSecret_() {
  const props = PropertiesService.getScriptProperties();
  let s = props.getProperty('QR_SECRET');
  if (!s) { s = Utilities.getUuid() + Utilities.getUuid(); props.setProperty('QR_SECRET', s); }
  return s;
}

/** Permanent per-player token. Para i-invalidate lahat ng QR: burahin ang QR_SECRET sa Script Properties. */
function qrToken_(playerId) {
  const sig = Utilities.computeHmacSha256Signature(String(playerId), qrSecret_());
  return sig.slice(0, 6).map(function (b) { return ('0' + (b & 0xff).toString(16)).slice(-2); }).join('').slice(0, 10);
}

