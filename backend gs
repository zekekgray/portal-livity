  // salin ng lbPayTick_ sa client (diff = due - now)
  const clientPen = function (diff) {
    const over = diff <= 0, overMs = -diff;
    return (over && overMs - g > 0) ? rule.flat + (rule.perDay > 0 ? rule.perDay * Math.floor(overMs / D) : 0) : 0;
  };
  const due = new Date('2026-10-17T09:00:00+08:00');
  const offs = [-3600000, -1, 0, 1, g, g + 1, D - 1, D, D + 1, 2 * D, 3 * D + 5];
  let bad = 0;
  offs.forEach(function (off) {
    const now = new Date(due.getTime() + off);
    const s = penaltyFor_(due, now, rule).amount, c = clientPen(-off);
    if (s !== c) { bad++; Logger.log('MISMATCH off=' + off + 'ms server=' + s + ' client=' + c); }
    else Logger.log('ok off=' + off + 'ms → ₱' + s);
