function getPenaltyRule_() {
  return {
    flat: Number(getConfigValue_('OverduePenaltyAmount')) || 0,
    perDay: Number(getConfigValue_('OverduePenaltyPerDay')) || 0,
    graceMinutes: Number(getConfigValue_('PenaltyGraceMinutes')) || 0,
