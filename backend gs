/* ---------- REPORTS ---------- */
function reportRange_(period) {
  const tz = Session.getScriptTimeZone(), now = new Date(), D = 86400000;
  const day = function (d) { return Utilities.parseDate(Utilities.formatDate(d, tz, 'yyyy-MM-dd'), tz, 'yyyy-MM-dd'); };
  const mon = function (d) { return Utilities.parseDate(Utilities.formatDate(d, tz, 'yyyy-MM') + '-01', tz, 'yyyy-MM-dd'); };
  const t0 = day(now);
  let from, to;
  if (period === 'yesterday') { from = new Date(t0.getTime() - D); to = t0; }
  else if (period === 'week') { from = new Date(t0.getTime() - 6 * D); to = new Date(t0.getTime() + D); }
  else if (period === 'prevweek') { from = new Date(t0.getTime() - 7 * D); to = t0; }
  else if (period === 'month') { from = mon(now); to = new Date(t0.getTime() + D); }
  else if (period === 'lastmonth') { const m0 = mon(now); from = mon(new Date(m0.getTime() - D)); to = m0; }
  else { period = 'today'; from = t0; to = new Date(t0.getTime() + D); }
  const last = new Date(to.getTime() - D), f = function (d) { return Utilities.formatDate(d, tz, 'MMM d, yyyy'); };
  return { period: period, from: from, to: to, label: f(from) + (f(from) === f(last) ? '' : ' – ' + f(last)) };
}

function reportData_(rg) {
  const f = rg.from.getTime(), t = rg.to.getTime(), now = new Date(), rule = getPenaltyRule_();
  const inR = function (v) { const x = v ? new Date(v).getTime() : 0; return x >= f && x < t; };
  const prog = {}; consoleRows_(SHEETS.PROGRAMS.name).forEach(function (r) { prog[r[0]] = r[1]; });
  const d = { enrollments: 0, byProgram: {}, newPayments: 0, newPaymentsAmt: 0, collected: 0, verifiedN: 0, refunded: 0, waived: 0, adjusted: 0, penalties: 0, reversed: 0, net: 0,
    present: 0, late: 0, absent: 0, walkins: 0, outstanding: 0, outstandingN: 0, overdueN: 0, overdueAmt: 0 };
  consoleRows_(SHEETS.PLAYERS.name).forEach(function (r) {
    if (!inR(r[8])) return;
    d.enrollments++; const k = prog[r[7]] || r[7] || '—'; d.byProgram[k] = (d.byProgram[k] || 0) + 1;
  });
  consoleRows_(SHEETS.PAYMENTS.name).forEach(function (r) {
    if (inR(r[5])) { d.newPayments++; d.newPaymentsAmt += Number(r[3]) || 0; }
    const st = consoleStatus_(r, now, rule);
    if (['Pending', 'Overdue', 'Partial', 'Rejected', 'Submitted'].indexOf(st) < 0) return;
    const c = consolePayCalc_(r, now, rule), owed = Math.max(0, c.total - c.verified);
    d.outstanding += owed; d.outstandingN++;
    if (st === 'Overdue') { d.overdueN++; d.overdueAmt += owed; }
  });
  ledgerRows_().forEach(function (r) {
    if (!inR(r[1])) return;
    const a = Number(r[5]) || 0, ty = r[4];
    if (ty === 'PAYMENT_VERIFIED') { d.collected += a; d.verifiedN++; }
    else if (ty === 'REFUND_COMPLETED') d.refunded += a;
    else if (ty === 'WAIVER') d.waived += Math.abs(a);
    else if (ty === 'ADJUSTMENT') d.adjusted += a;
    else if (ty === 'PENALTY') d.penalties += a;
    else if (ty === 'REVERSAL') d.reversed += Math.abs(a);
  });
  d.net = d.collected - d.refunded;
  consoleRows_(SHEETS.ATTENDANCE.name).forEach(function (r) {
    if (!inR(r[3])) return;
    if (r[5] === 'Present') d.present++; else if (r[5] === 'Late') d.late++; else if (r[5] === 'Absent') d.absent++;
    if (consoleTrue_(r[8])) d.walkins++;
  });
  return d;
}

function reportText_(d, rg, part) {
  const P = function (n) { return '₱' + String(Math.round(Number(n) || 0)).replace(/\B(?=(\d{3})+(?!\d))/g, ','); };
  const all = part === 'full', L = ['Livity report · ' + rg.label];
  if (all || part === 'enr') {
    L.push('', 'ENROLLMENTS', 'New players: ' + d.enrollments);
    Object.keys(d.byProgram).forEach(function (k) { L.push('  • ' + k + ': ' + d.byProgram[k]); });
  }
  if (all || part === 'pay') {
    L.push('', 'PAYMENTS', 'New payment requests: ' + d.newPayments + ' (' + P(d.newPaymentsAmt) + ')',
      'Collected (verified): ' + P(d.collected) + ' in ' + d.verifiedN + ' verification(s)', 'Refunded: ' + P(d.refunded), 'Net collected: ' + P(d.net),
      'Late penalties charged: ' + P(d.penalties), 'Waived: ' + P(d.waived), 'Adjustments: ' + P(d.adjusted), 'Reversed: ' + P(d.reversed));
  }
  if (all) L.push('', 'ATTENDANCE', 'Present: ' + d.present + ' · Late: ' + d.late + ' · Absent: ' + d.absent + ' · Walk-ins: ' + d.walkins);
  if (all || part === 'out') L.push('', 'OUTSTANDING (as of now)', 'Unpaid payments: ' + d.outstandingN + ' · balance owed ' + P(d.outstanding), 'Overdue: ' + d.overdueN + ' · ' + P(d.overdueAmt));
  return L.join('\n');
}

