function consolePkgAdjust_(p, who) {
  const id = String(p.packageId || ''), reason = String(p.reason || '').trim(), tz = Session.getScriptTimeZone();
  if (reason.length < 5) throw new Error('A reason (at least 5 characters) is required.');
  const sh = sheet_(SHEETS.PACKAGES.name), d = sh.getDataRange().getValues();
  let i = -1;
  for (let k = 1; k < d.length; k++) if (d[k][0] === id) { i = k; break; }
  if (i < 0) throw new Error('Package not found.');
  const r = d[i], st = String(r[7]), total = Number(r[4]) || 0, used = Number(r[5]) || 0, expOld = consoleD_(r[6]);
  if (st === 'Reversed') throw new Error('Reversed packages cannot be adjusted.');
  if (String(p.stamp || '') !== [st, total, used, expOld].join('|')) throw new Error('CHANGED: This package was updated since you opened it. Reopen the player.');

  const grant = String(p.grant == null ? '' : p.grant).trim() === '' ? 0 : Math.floor(Number(p.grant));
  if (!isFinite(grant) || grant < 0 || grant > 50) throw new Error('Grant must be between 0 and 50 sessions.');
  const newTotal = total + grant;
  const newUsed = String(p.used == null ? '' : p.used).trim() === '' ? used : Math.floor(Number(p.used));
  if (!isFinite(newUsed) || newUsed < 0 || newUsed > newTotal) throw new Error('Sessions used must be between 0 and ' + newTotal + '.');

  const expIn = String(p.expiry || '').trim();
  let newExp = r[6];
  if (expIn !== expOld) {
    if (!expIn) newExp = '';
    else { try { newExp = Utilities.parseDate(expIn + ' 23:59', tz, 'yyyy-MM-dd HH:mm'); } catch (e) { throw new Error('Invalid expiry date.'); } }
  }
  const stIn = String(p.status || st);
  let newSt = st;
  if (stIn !== st) {
    if (['Active', 'Completed'].indexOf(stIn) < 0) throw new Error('Status can only be set to Active or Completed.');
    newSt = stIn;
  } else if ((st === 'Active' || st === 'Completed') && newTotal > 0 && (newUsed !== used || grant > 0)) {
    newSt = newUsed >= newTotal ? 'Completed' : 'Active';
  }
  if (newTotal === total && newUsed === used && expIn === expOld && newSt === st) throw new Error('Nothing to change.');

  sh.getRange(i + 1, 5, 1, 4).setValues([[newTotal, newUsed, newExp, newSt]]);
  const ch = [];
  if (newTotal !== total) ch.push('total ' + total + '→' + newTotal);
  if (newUsed !== used) ch.push('used ' + used + '→' + newUsed);
  if (expIn !== expOld) ch.push('expiry ' + (expOld || 'none') + '→' + (expIn || 'none'));
  if (newSt !== st) ch.push('status ' + st + '→' + newSt);
  logAudit_('PACKAGE_ADJUSTED', id + ' ' + r[1] + ' — ' + ch.join(', ') + ' · ' + reason, who);
  rvFlush_();
  return { state: newSt, used: newUsed, total: newTotal };
}
