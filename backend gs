/** True kapag may membership record na ang player (kahit Pending pa ang bayad — bayad na yon sa unang order). */
function playerHasMembership_(playerId) {
  const d = sheet_(SHEETS.PACKAGES.name).getDataRange().getValues();
  for (let i = 1; i < d.length; i++) {
    if (d[i][1] === playerId && d[i][2] === 'PRC-MEMB' && d[i][7] !== 'Reversed') return true;
  }
  return false;
}

/** Kapag Paid na ang payment: Pending packages → Active (main + 'P' companion). Academy = pati Pending membership. */
function activatePackagesForPayment_(playerId, packageId) {
  if (!packageId || packageId === 'PENDING') return;
  const sh = sheet_(SHEETS.PACKAGES.name);
  const data = sh.getDataRange().getValues();
  const baseId = String(packageId).replace(/P$/, '');
  let isAcademy = false, n = 0;
  for (let i = 1; i < data.length; i++) {
    if ((data[i][0] !== baseId && data[i][0] !== baseId + 'P') || data[i][7] !== 'Pending') continue;
    const pr = findRowById_(SHEETS.PRICING.name, data[i][2]);
    if (pr && pr[1] === 'PRG-ACAD') isAcademy = true;
    sh.getRange(i + 1, 8).setValue('Active'); n++;
  }
  if (isAcademy) {
    for (let i = 1; i < data.length; i++) {
      if (data[i][1] === playerId && data[i][2] === 'PRC-MEMB' && data[i][7] === 'Pending') { sh.getRange(i + 1, 8).setValue('Active'); n++; }
    }
  }
  if (n) logAudit_('PACKAGES_ACTIVATED', playerId + ' — ' + n + ' package row(s) after payment of ' + packageId, null);
}
