  };

  if (op === 'approve') {
    if (cur !== 'Pending') throw new Error('Only Pending referrals can be approved.');
    const maps = consoleRefMaps_();
    const ok = consoleRows_(SHEETS.PAYMENTS.name).some(function (pr) { return pr[1] === r[2] && pr[6] === 'Paid' && consolePayIsPackage_(pr, maps); });
    if (!ok && !force) throw new Error('NOT_QUALIFIED: The referred player has no Paid package yet (single sessions, assessments and Private rates do not count).');
    save('Approved', '', ok ? '' : 'Approved without a paid package (override)');
    logAudit_('REFERRAL_APPROVED', id + ' · ' + r[1] + ' referred ' + r[2] + (ok ? '' : ' · OVERRIDE, no paid package'), who);
    return { state: 'Approved' };
  }

  if (op === 'reject') {
    if (cur !== 'Pending' && cur !== 'Approved') throw new Error('Applied referrals cannot be rejected. Adjust the payment instead.');
    if (reason.length < 5) throw new Error('A reason (at least 5 characters) is required.');
    save('Rejected', '', reason);
    logAudit_('REFERRAL_REJECTED', id + ' · ' + reason, who);
    return { state: 'Rejected' };
  }

  if (cur !== 'Approved') throw new Error('Approve the referral first.');
  const amt = Number(p.amount), pid = String(p.paymentId || '').trim();
  if (!(amt > 0) || amt > 100000) throw new Error('Enter a valid discount amount.');
  const f = payFindRow_(pid);
