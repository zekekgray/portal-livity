  consoleRows_(SHEETS.PAYMENTS.name).forEach(function (r) { if (['Pending', 'Overdue', 'Submitted', 'Partial'].indexOf(String(r[6])) > -1) pend[r[1]] = true; });
  const out = [];
  consoleRows_(SHEETS.ATTENDANCE.name).forEach(function (r) {
    if (!r[3]) return;
    const d = consoleD_(r[3]), st = String(r[5]), ded = String(r[7]).toLowerCase();
