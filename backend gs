function getOrCreateSheet_(ss, name, headers) {
  let sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
  }
  if (sheet.getLastRow() === 0) {
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
  }
  sheet.setFrozenRows(1);
  sheet.setRowHeight(1, 34);
  sheet.autoResizeColumns(1, headers.length);
  applyZebraStyle_(sheet, headers.length);
  return sheet;
}

// Applies the Livity table theme: dark/gold header + cream zebra striping.
// Safe to re-run — clears any existing banding on the sheet first.
function applyZebraStyle_(sheet, numCols) {
  sheet.getBandings().forEach(function (b) { b.remove(); });

  const maxRows = Math.max(sheet.getMaxRows(), 300);
  const range = sheet.getRange(1, 1, maxRows, numCols);
  const banding = range.applyRowBanding(SpreadsheetApp.BandingTheme.LIGHT_GREY, true, false);

  banding.setHeaderRowColor('#171714');
  banding.setFirstRowColor('#FFFFFF');
  banding.setSecondRowColor('#F5EEE0');

  sheet.getRange(1, 1, 1, numCols)
    .setFontWeight('bold')
    .setFontColor('#FFDE00')
    .setHorizontalAlignment('center')
    .setVerticalAlignment('middle');

  range.setBorder(true, true, true, true, true, true, '#e2e2e2', SpreadsheetApp.BorderStyle.SOLID);
  sheet.setColumnWidths(1, numCols, 140);
}

// Writes seed rows only if sheet has no data rows yet (idempotent — safe to re-run)
function writeSeed_(sheetName, rows, keyedById) {
  const sheet = getTargetSs_().getSheetByName(sheetName);
  if (!sheet || rows.length === 0) return;

  const existingIds = keyedById ? getColumnValues_(sheet, 1) : [];
  const toWrite = keyedById
    ? rows.filter(function (r) { return existingIds.indexOf(r[0]) === -1; })
    : (sheet.getLastRow() <= 1 ? rows : []);

  if (toWrite.length > 0) {
    sheet.getRange(sheet.getLastRow() + 1, 1, toWrite.length, toWrite[0].length).setValues(toWrite);
  }
}

function getColumnValues_(sheet, col) {
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return [];
  return sheet.getRange(2, col, lastRow - 1, 1).getValues().map(function (r) { return r[0]; });
}

function sheet_(name) {
  return getTargetSs_().getSheetByName(name);
}

function nextId_(prefix, sheetName) {
  const sheet = sheet_(sheetName);
  const count = Math.max(0, sheet.getLastRow() - 1);
  return prefix + '-' + Utilities.formatString('%04d', count + 1);
}

/** Player-facing permanent ID: random LVTFA-XXXXXXX (letters+numbers) — checked against existing Players column A to avoid duplicates. */
function nextPlayerId_() {
  const sheet = sheet_(SHEETS.PLAYERS.name);
  const existing = getColumnValues_(sheet, 1).map(String);
  const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
  let id;
  do {
    let suffix = '';
    for (let i = 0; i < 7; i++) suffix += chars.charAt(Math.floor(Math.random() * chars.length));
    id = 'LVTFA-' + suffix;
  } while (existing.indexOf(id) !== -1);
  return id;
}

