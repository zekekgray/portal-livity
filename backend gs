}

function tgLink_(chatId, code) {
  const c = CacheService.getScriptCache(), fk = 'tgfail_' + chatId, fails = Number(c.get(fk) || 0);
  if (fails >= 5) return 'Too many wrong codes. Please wait 10 minutes and try again.';
  const pid = c.get('tglink_' + code);
  if (!pid) { try { c.put(fk, String(fails + 1), 600); } catch (e) {} return 'That code is invalid or expired. In the app, open My Livity → Connect Telegram for a new one.'; }
  const pr = findRowById_(SHEETS.PLAYERS.name, pid);
  if (!pr) return 'Player not found.';
  const sh = tgLinksSheet_(), d = sh.getDataRange().getValues();
  let found = false;
  for (let i = 1; i < d.length; i++) {
    if (String(d[i][0]) === String(chatId) && d[i][1] === pid) { sh.getRange(i + 1, 3, 1, 2).setValues([[new Date(), 'Active']]); found = true; break; }
  }
  if (!found) sh.appendRow([chatId, pid, new Date(), 'Active']);
  c.remove('tglink_' + code);
  logAudit_('TG_LINKED', pid + ' ← chat ' + chatId, null);
  return '✅ Connected: ' + pr[1] + '\n\nYou will now get Livity reminders and the weekly poll here.\nCommands: /balance  /pay  /poll  /unlink\n\nTo add another child, generate a new code in the app for that child.';
}

/* ---------- commands ---------- */
function tgOnMessage_(m) {
  if (!m.chat || m.chat.type !== 'private') return; // Phase 1: DM lang. Walang personal na info sa group.
  const chatId = m.chat.id, text = String(m.text || '').trim(), parts = text.split(/\s+/);
  const cmd = parts[0].split('@')[0].toLowerCase(), arg = String(parts[1] || '').replace(/\D/g, '');

  if ((cmd === '/start' || cmd === '/link') && arg) { tgSend_(chatId, tgLink_(chatId, arg)); return; }
  if (cmd === '/start' || cmd === '/help') {
    tgSend_(chatId, 'Welcome to Livity 👋\n\nTo connect your child: open the Livity app → My Livity → Connect Telegram, then tap Start here.\nOr send: /link 123456\n\nCommands: /balance  /pay  /poll  /unlink');
    return;
  }
  const pids = tgMyPlayers_(chatId);
  if (!pids.length) { tgSend_(chatId, 'No player connected yet. Open the Livity app → My Livity → Connect Telegram.'); return; }

  if (cmd === '/balance') {
    const tz = Session.getScriptTimeZone();
    tgSend_(chatId, pids.map(function (pid) {
      const pr = findRowById_(SHEETS.PLAYERS.name, pid);
      const lines = getPlayerRelationships_(pid).filter(function (r) { return r.programId !== 'PRG-PRIV' || r.total > 0; }).map(function (r) {
        const base = '• ' + lbProgramLabelServer_(r.programId) + ': ';
        if (r.state === 'active') return base + r.remaining + ' of ' + r.total + ' sessions left' + (r.expiryDate ? ' (expires ' + Utilities.formatDate(new Date(r.expiryDate), tz, 'MMM d') + ')' : '');
        return base + ({ exhausted: 'package ended', expired: 'package expired', pending_payment: 'payment pending', reversed: 'payment reversed', none: 'no package' }[r.state] || r.state);
      });
      return (pr ? pr[1] : pid) + '\n' + (lines.join('\n') || '• No packages yet');
    }).join('\n\n'));
    return;
  }
  if (cmd === '/pay') {
    tgSend_(chatId, pids.map(function (pid) {
      const pay = getPlayerPaymentsData_(pid);
      const open = (pay.payments || []).filter(function (x) { return ['Pending', 'Overdue', 'Partial', 'Rejected', 'Submitted'].indexOf(x.status) > -1; });
      return pay.playerName + '\n' + (open.length
        ? open.map(function (x) { return '• ' + x.label + ': ₱' + x.remaining + ' · ' + x.status; }).join('\n') + '\nBalance due: ₱' + pay.balanceDue
        : '• No balance due ✅');
    }).join('\n\n') + '\n\nTo send proof of payment: app → My Livity → Payments.');
    return;
  }
  if (cmd === '/poll') { tgPollForChat_(chatId, true); return; }
  if (cmd === '/unlink') {
    const sh = tgLinksSheet_(), d = sh.getDataRange().getValues();
    for (let i = 1; i < d.length; i++) if (String(d[i][0]) === String(chatId)) sh.getRange(i + 1, 4).setValue('Unlinked');
    logAudit_('TG_UNLINKED', 'chat ' + chatId, null);
    tgSend_(chatId, 'Disconnected. You will no longer get Livity messages here.');
    return;
  }
  tgSend_(chatId, 'Commands: /balance  /pay  /poll  /unlink');
}

/* ---------- weekly poll (DM, per child, per session) ---------- */
function tgPollForChat_(chatId, force) {
  const sessions = consoleRsvpSessions_().filter(function (s) { return !s.cancelled && !s.closed; });
  const pids = tgMyPlayers_(chatId), seen = force ? {} : alertLoad_(), roster = {};
  let n = 0;
  pids.forEach(function (pid) {
    const pr = findRowById_(SHEETS.PLAYERS.name, pid), first = pr ? String(pr[1]).split(/\s+/)[0] : 'your child';
    sessions.forEach(function (s) {
      if (!roster[s.programId]) roster[s.programId] = getAutoRegisterRosterIds_(s.programId);
      if (roster[s.programId].indexOf(pid) < 0) return;
      const key = 'POLL|' + chatId + '|' + pid + '|' + s.key;
      if (seen[key]) return;
      const base = 'rv|' + s.programId + '|' + s.date + '|' + s.start + '|' + pid + '|';
      tgSend_(chatId, '📅 ' + s.day.slice(0, 3) + ' ' + s.date + ' · ' + s.start + '–' + s.end + '\n' + s.program + ' · ' + s.venue + '\nWill ' + first + ' attend?', {
        inline_keyboard: [[{ text: '✅ Going', callback_data: base + 'y' }, { text: '❌ Not going', callback_data: base + 'n' }]]
      });
      if (!force) alertMark_(key);
      n++;
      Utilities.sleep(60);
    });
  });
  if (force && !n) tgSend_(chatId, 'No open sessions to answer right now.');
  return n;
}

