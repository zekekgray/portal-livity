const RSVP_CUTOFF_MS = 2 * 3600000;
const RSVP_PROGRAMS_ = ['PRG-REG', 'PRG-ADV', 'PRG-ACAD'];
const RSVP_NAMES_PUBLIC_ = true; // false = bilang lang, walang pangalan sa poll
const RV_HEAD = ['playerId','programId','sessionDate','startTime','status','respondedAt','source','requestId'];

function rsvpSheet_(name, headers) {
