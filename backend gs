    if (!type) return;
    const s = sch[r[2]] || [];
    out.push({
      attendanceId: r[0], playerId: r[1], player: names[r[1]] || r[1], scheduleId: r[2], programId: s[1] || '', program: prog[s[1]] || s[1] || '', date: d,
